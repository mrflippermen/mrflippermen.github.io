---
import CommandHeader from '../components/CommandHeader.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.scss';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { 
  title = "Flippermen | CyberSec",
  description = "Red Team Operator | HTB Top 1 Ecuador | Senior Cybersecurity Researcher especializado en Active Directory, EDR Evasion y Exploit Development",
  image,
  type
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap">
    
    <title>{title}</title>
    
    <SEOHead 
      title={title} 
      description={description}
      image={image}
      type={type}
    />
    
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          return 'light';
        }
        return 'dark';
      })();
    
      if (theme === 'light') {
        document.body.classList.add('light-mode');
      } else {
        document.body.classList.remove('light-mode');
      }

      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body>
    <CommandHeader />
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Flippermen. Built with Astro.</p>
      </div>
    </footer>
    
    <script is:inline>
        const handleToggleClick = () => {
          const element = document.body;
          element.classList.toggle("light-mode");
      
          const isLight = element.classList.contains("light-mode");
          localStorage.setItem("theme", isLight ? "light" : "dark");
          
          document.getElementById("themeIcon").innerText = isLight ? "🌙" : "☀️";
        }
      
        document.getElementById("themeToggle").addEventListener("click", handleToggleClick);
        
        // Initial icon state
        if (localStorage.getItem('theme') === 'light') {
             document.getElementById("themeIcon").innerText = "🌙";
        }
    </script>
  </body>
</html>
