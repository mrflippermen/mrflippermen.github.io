---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string;
}

const {
  title,
  description,
  image = '/images/cyberflipper_hero.png',
  type = 'website',
  keywords = 'Red Team, Pentesting, HTB, Hack The Box, Ecuador, OSCP, Cybersecurity, Active Directory'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// i18n alternates: prefixDefaultLocale is on, so every path starts with /es or /en.
const langNames = { es: 'Spanish', en: 'English' } as const;
const segments = Astro.url.pathname.split('/');
const currentLang = (segments[1] === 'en' ? 'en' : 'es') as keyof typeof langNames;
const pathForLang = (l: 'es' | 'en') => {
  const s = [...segments];
  if (s[1] === 'es' || s[1] === 'en') s[1] = l; else s.splice(1, 0, l);
  return s.join('/') || '/';
};
const alternates = [
  { hreflang: 'es', href: new URL(pathForLang('es'), Astro.site) },
  { hreflang: 'en', href: new URL(pathForLang('en'), Astro.site) },
  { hreflang: 'x-default', href: new URL(pathForLang('es'), Astro.site) },
];
---

<!-- Primary Meta Tags -->
<meta name="description" content={description} />
<meta name="author" content="Esteban Jimenez - mrflippermen" />
<meta name="keywords" content={keywords} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content="Flippermen | Red Team Operator" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
<meta property="twitter:creator" content="@mrflippermen" />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- i18n alternates (hreflang) -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="language" content={langNames[currentLang]} />
<meta name="revisit-after" content="7 days" />
