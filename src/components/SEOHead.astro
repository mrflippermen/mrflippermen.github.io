---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string;
}

const { 
  title, 
  description, 
  image = '/images/og-default.png',
  type = 'website',
  keywords = 'Red Team, Pentesting, HTB, Hack The Box, Ecuador, OSCP, Cybersecurity, Active Directory'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!-- Primary Meta Tags -->
<meta name="description" content={description} />
<meta name="author" content="Esteban Jimenez - mrflippermen" />
<meta name="keywords" content={keywords} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content="Flippermen | Red Team Operator" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
<meta property="twitter:creator" content="@mrflippermen" />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="language" content="Spanish" />
<meta name="revisit-after" content="7 days" />
