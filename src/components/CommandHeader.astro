---
const { currentPath } = Astro.url;
const currentTime = new Date().toISOString().split('T')[0];
---

<header class="command-header" role="banner">
  <div class="hud-top-bar">
    <div class="hud-item">
      <span class="hud-label">USER_AGENT:</span>
      <span class="hud-value" id="user-agent-info">ANONYMOUS</span>
    </div>
    <div class="hud-item only-desktop">
      <span class="hud-label">DATE:</span>
      <span class="hud-value">{currentTime}</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">ACCESS:</span>
      <span class="hud-value secure">GRANTED</span>
    </div>
    <div class="hud-item only-desktop">
      <span class="hud-label">DEFCON:</span>
      <span class="hud-value warning">3</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">SESS:</span>
      <span class="hud-value blink">0xFACEB00C</span>
    </div>
  </div>

  <nav class="tactical-nav" role="navigation" aria-label="Main navigation">
    <a href="/" class="brand-unit">
      <span class="bracket">[</span>
      <span class="brand-text">FLIPPERMEN</span>
      <span class="bracket">]</span>
    </a>

    <!-- Hamburger / Mobile Toggle -->
    <button id="mobile-menu-btn" class="mobile-toggle" aria-label="Toggle Navigation" aria-expanded="false">
      <div class="bar top"></div>
      <div class="bar mid"></div>
      <div class="bar bot"></div>
    </button>

    <div class="nav-links-container" id="nav-links">
      <a href="/about" class={currentPath === '/about' ? 'active' : ''}>
        <span class="nav-icon">👤</span> IDENTITY
      </a>
      <a href="/writeups" class={currentPath === '/writeups' ? 'active' : ''}>
        <span class="nav-icon">📝</span> OPS_LOG
      </a>
      <a href="/certs" class={currentPath === '/certs' ? 'active' : ''}>
        <span class="nav-icon">🏅</span> CREDENTIALS
      </a>
      <a href="/wiki" class={currentPath === '/wiki' ? 'active' : ''}>
        <span class="nav-icon">📚</span> WIKI
      </a>
      <a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>
        <span class="nav-icon">📡</span> COMMS
      </a>
      <a href="/cyberflipper" class={currentPath === '/cyberflipper' ? 'active' : ''}>
        <span class="nav-icon">🏴‍☠️</span> CYBERFLIPPER
      </a>
      
      <div class="separator"></div>

      <button id="themeToggle" class="theme-switch" aria-label="Toggle Night Vision">
        <span class="switch-icon">👁️</span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Ensure scripts only run once per page load
  document.addEventListener('DOMContentLoaded', function() {
    // Mobile Menu Logic
    const menuBtn = document.getElementById('mobile-menu-btn');
    const navLinks = document.getElementById('nav-links');

    if (menuBtn && navLinks) {
      // Remove any existing listeners before adding new ones
      const newMenuBtn = menuBtn.cloneNode(true);
      menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);
      
      newMenuBtn.addEventListener('click', () => {
        navLinks.classList.toggle('open');
        newMenuBtn.classList.toggle('active');
      });
    }

    // Dynamic User Agent Display
    const userAgentEl = document.getElementById('user-agent-info');
    if (userAgentEl && userAgentEl.textContent === 'ANONYMOUS') {
      const ua = navigator.userAgent;
      let displayUA = 'UNKNOWN';
      
      if (ua.includes('Windows')) displayUA = 'WIN';
      else if (ua.includes('Mac')) displayUA = 'OSX';
      else if (ua.includes('Linux')) displayUA = 'LINUX';
      else if (ua.includes('Android')) displayUA = 'ANDROID';
      else if (ua.includes('iPhone') || ua.includes('iPad')) displayUA = 'iOS';
      
      // Add browser
      if (ua.includes('Firefox')) displayUA += '/FF';
      else if (ua.includes('Chrome') && !ua.includes('Edg')) displayUA += '/CHROME';
      else if (ua.includes('Safari') && !ua.includes('Chrome')) displayUA += '/SAFARI';
      else if (ua.includes('Edg')) displayUA += '/EDGE';
      
      userAgentEl.textContent = displayUA;
    }
  });
</script>

<style>
  /* Command Header - usa variables globales de _tokens.scss */

  /* HEADER CONTAINER */
  .command-header {
    background: rgba(10, 10, 10, 0.95);
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, var(--neon-red), var(--neon-blue)) 1;
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: 'Courier New', monospace;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(255, 51, 51, 0.1);
  }

  /* TOP HUD BAR */
  .hud-top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    background: linear-gradient(180deg, #000 0%, #0a0a0a 100%);
    padding: 6px 2rem;
    font-size: 0.72rem;
    border-bottom: 1px solid #1a1a1a;
    gap: 2rem;
    letter-spacing: 0.5px;
    box-shadow: inset 0 -1px 0 rgba(255, 51, 51, 0.1);
  }

  .hud-item {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    position: relative;
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .hud-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .hud-label { 
    color: #666; 
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.68rem;
    letter-spacing: 0.8px;
  }
  
  .hud-value { 
    color: #bbb; 
    font-weight: bold; 
    font-family: 'Consolas', 'Monaco', monospace;
    text-shadow: 0 0 8px rgba(187, 187, 187, 0.3);
  }
  
  .hud-value.secure { 
    color: var(--neon-green); 
    text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
    font-weight: 800;
  }
  
  .hud-value.warning { 
    color: #ffbd2e; 
    text-shadow: 0 0 10px rgba(255, 189, 46, 0.5);
    font-weight: 800;
  }
  
  .hud-value.blink { 
    animation: blink 2s infinite; 
    color: var(--neon-red);
  }

  @keyframes blink { 
    0%, 100% { opacity: 1; text-shadow: 0 0 10px rgba(255, 51, 51, 0.8); }
    50% { opacity: 0.4; text-shadow: 0 0 5px rgba(255, 51, 51, 0.4); } 
  }

  /* MAIN NAV */
  .tactical-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* BRAND */
  .brand-unit {
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .bracket { color: var(--neon-blue); transition: all 0.3s; }
  .brand-unit:hover .bracket { text-shadow: 0 0 10px var(--neon-blue); }
  .brand-text { color: #fff; }

  /* NAV LINKS */
  .nav-links-container {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-links-container a {
    text-decoration: none;
    color: #888;
    font-size: 0.9rem;
    font-weight: 600;
    position: relative;
    padding: 0.5rem 0;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-icon { opacity: 0.5; transition: 0.3s; }
  .nav-links-container a:hover .nav-icon { opacity: 1; text-shadow: 0 0 10px white; }

  .nav-links-container a:hover,
  .nav-links-container a.active {
    color: #fff;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
  }

  .nav-links-container a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(90deg, var(--neon-red), var(--neon-blue));
    transition: width 0.3s;
  }

  .nav-links-container a:hover::after,
  .nav-links-container a.active::after {
    width: 100%;
  }

  .separator {
    width: 1px;
    height: 20px;
    background: #333;
  }

  /* THEME SWITCH */
  .theme-switch {
    background: none;
    border: 1px solid #333;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.3s;
  }

  .theme-switch:hover {
    border-color: var(--neon-red);
    box-shadow: 0 0 10px rgba(255, 51, 51, 0.2);
  }

  /* MOBILE TOGGLE */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
  }

  .bar {
    width: 25px;
    height: 2px;
    background: var(--neon-red);
    transition: 0.3s;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .only-desktop { display: none; }
    
    .mobile-toggle { display: flex; }
    
    .nav-links-container {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: rgba(10, 10, 10, 0.98);
      flex-direction: column;
      padding: 2rem;
      gap: 2rem;
      gap: 2rem;
      border-bottom: 2px solid var(--neon-red);
      transform: translateY(-150%); /* Hidden by default */
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 999;
    }

    .nav-links-container.open {
      transform: translateY(0);
    }
  }
</style>
