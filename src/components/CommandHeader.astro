---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang        = getLangFromUrl(Astro.url);
const t           = useTranslations(lang);
const currentPath = Astro.url.pathname;
const currentDate = new Date().toISOString().split('T')[0];
---

<header class="command-header" role="banner">

  <!-- ── TOP HUD BAR ── -->
  <div class="hud-bar">
    <div class="hud-left">
      <span class="hud-item">
        <span class="hud-key">SYS:</span>
        <span class="hud-val" id="ua-display">SCANNING...</span>
      </span>
    </div>

    <div class="hud-right">
      <span class="hud-item">
        <span class="hud-key">DATE:</span>
        <span class="hud-val">{currentDate}</span>
      </span>
      <span class="hud-item hud-desktop">
        <span class="hud-key">TIME:</span>
        <span class="hud-val" id="live-time">--:--:--</span>
      </span>
      <span class="hud-item">
        <span class="hud-key">ACCESS:</span>
        <span class="hud-val hud-green">GRANTED</span>
      </span>
      <span class="hud-item hud-desktop">
        <span class="hud-key">DEFCON:</span>
        <span class="hud-val hud-red hud-blink">3</span>
      </span>
      <span class="hud-item lang-switcher">
        <a href={`/es${currentPath.replace(/^\/(en|es)/, '')}`}
           class={lang === 'es' ? 'lang-btn active' : 'lang-btn'}>ES</a>
        <span class="lang-sep">|</span>
        <a href={`/en${currentPath.replace(/^\/(en|es)/, '')}`}
           class={lang === 'en' ? 'lang-btn active' : 'lang-btn'}>EN</a>
      </span>
    </div>
  </div>

  <!-- ── MAIN NAV ── -->
  <nav class="tactical-nav" role="navigation" aria-label="Main navigation">

    <a href={`/${lang}/`} class="brand-logo" aria-label="Flippermen Home">
      <span class="bracket">[</span>
      <span class="brand-name">FLIPPERMEN</span>
      <span class="bracket">]</span>
    </a>

    <button id="mob-btn" class="mob-toggle" aria-label="Toggle Navigation" aria-expanded="false">
      <span class="bar top"></span>
      <span class="bar mid"></span>
      <span class="bar bot"></span>
    </button>

    <div class="nav-links" id="nav-links">
      <a href={`/${lang}/about`}       class={currentPath.includes('/about')       ? 'nav-link active' : 'nav-link'}>
        <Icon name="user-secret" class="nav-ico" /> IDENTITY
      </a>
      <a href={`/${lang}/writeups`}    class={currentPath.includes('/writeups')    ? 'nav-link active' : 'nav-link'}>
        <Icon name="terminal" class="nav-ico" /> OPS_LOG
      </a>
      <a href={`/${lang}/certs`}       class={currentPath.includes('/certs')       ? 'nav-link active' : 'nav-link'}>
        <Icon name="medal" class="nav-ico" /> CREDENTIALS
      </a>
      <a href={`/${lang}/wiki`}        class={currentPath.includes('/wiki')        ? 'nav-link active' : 'nav-link'}>
        <Icon name="database" class="nav-ico" /> WIKI
      </a>
      <a href={`/${lang}/contact`}     class={currentPath.includes('/contact')     ? 'nav-link active' : 'nav-link'}>
        <Icon name="satellite-dish" class="nav-ico" /> COMMS
      </a>
      <a href={`/${lang}/osint`}       class={currentPath.includes('/osint')       ? 'nav-link active' : 'nav-link'}>
        <Icon name="location-dot" class="nav-ico" /> OSINT
      </a>
      <a href={`/${lang}/cyberflipper`}
         class={currentPath.includes('/cyberflipper') ? 'nav-link special active' : 'nav-link special'}>
        <Icon name="dragon" class="nav-ico" /> CYBERFLIPPER
      </a>
    </div>

  </nav>
</header>

<script>
  let clockInterval: ReturnType<typeof setInterval> | null = null;

  function initHeader() {
    // ── User Agent detection ──────────────────────
    const uaEl = document.getElementById('ua-display');
    if (uaEl) {
      uaEl.textContent = 'SCANNING...';
      uaEl.classList.remove('scanned');
      const ua = navigator.userAgent;
      let display = 'UNKNOWN_OS';
      if      (ua.includes('Windows')) display = 'WIN_NT_KERNEL';
      else if (ua.includes('Mac'))     display = 'DARWIN_OS';
      else if (ua.includes('Linux'))   display = 'ELF64_LINUX';
      else if (ua.includes('Android')) display = 'ANDROID_ARM';
      else if (ua.includes('iPhone') || ua.includes('iPad')) display = 'IOS_MOBI';
      setTimeout(() => {
        uaEl.textContent = display;
        uaEl.classList.add('scanned');
      }, 700);
    }

    // ── Live clock ────────────────────────────────
    if (clockInterval) clearInterval(clockInterval);
    const timeEl = document.getElementById('live-time');
    function updateClock() {
      if (!timeEl) return;
      timeEl.textContent = new Date().toTimeString().slice(0, 8);
    }
    updateClock();
    clockInterval = setInterval(updateClock, 1000);

    // ── Mobile menu ──────────────────────────────
    const btn      = document.getElementById('mob-btn');
    const navLinks = document.getElementById('nav-links');
    if (btn && navLinks) {
      // Clone to remove any stale listeners from prior navigations
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.replaceWith(newBtn);
      newBtn.addEventListener('click', () => {
        const open = navLinks.classList.toggle('open');
        newBtn.classList.toggle('active', open);
        newBtn.setAttribute('aria-expanded', String(open));
      });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
/* ═══════════════════════════════════════════════════════
   COMMAND HEADER
═══════════════════════════════════════════════════════ */
.command-header {
  font-family: var(--font-mono);
  position: sticky;
  top: 0;
  z-index: var(--z-header);
}

/* ── HUD bar ── */
.hud-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #000;
  padding: 0.25rem 2rem;
  font-size: 0.65rem;
  letter-spacing: 0.8px;
  border-bottom: 1px solid var(--border-color);
  gap: 1rem;
  overflow: hidden;
}

.hud-left,
.hud-right {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.hud-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.hud-key  { color: #8a8a8a; text-transform: uppercase; } /* was #555 (~2.7:1 on #000) */
.hud-val  { color: #ccc; font-weight: 700; }

.hud-green { color: var(--blue-team); text-shadow: 0 0 6px rgba(0,240,255,0.5); }
.hud-red   { color: var(--red-team); }

.hud-blink { animation: hud-blink 2s step-end infinite; }
@keyframes hud-blink {
  50% { opacity: 0.3; }
}

.hud-val.scanned {
  color: var(--blue-team);
  text-shadow: 0 0 6px rgba(0,240,255,0.4);
  transition: color 0.4s, text-shadow 0.4s;
}

/* lang switcher */
.lang-switcher { gap: 0.3rem; }
.lang-btn {
  color: #8a8a8a; /* was #444 (~2:1) — this is an interactive link, must be legible */
  text-decoration: none;
  font-weight: 700;
  transition: color 0.2s;
  font-size: 0.65rem;
}
.lang-btn.active { color: #fff; text-shadow: 0 0 4px rgba(255,255,255,0.3); }
.lang-btn:hover  { color: var(--blue-team); }
.lang-sep        { color: #2a2a2a; }

/* ── Main nav ── */
.tactical-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 2rem;
  background: rgba(10,10,10,0.95);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-color);
  max-width: 100%;
}

/* Brand */
.brand-logo {
  text-decoration: none;
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--text-primary);
  letter-spacing: 3px;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-display);
  transition: color 0.2s;
}

.bracket {
  color: var(--blue-team);
  text-shadow: 0 0 8px rgba(0,240,255,0.5);
  transition: color 0.3s, text-shadow 0.3s;
}

.brand-logo:hover .bracket {
  color: var(--red-team);
  text-shadow: 0 0 12px rgba(217,4,41,0.6);
}

/* Nav links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.nav-link {
  text-decoration: none;
  color: var(--text-muted);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 0.45rem 0.75rem;
  position: relative;
  transition: color 0.2s;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  white-space: nowrap;
}

.nav-ico {
  font-size: 0.8rem;
  opacity: 0.6;
  transition: opacity 0.2s;
}

.nav-link:hover { color: var(--text-primary); }
.nav-link:hover .nav-ico { opacity: 1; }

/* active underline */
.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0.75rem; right: 0.75rem;
  height: 1px;
  background: var(--blue-team);
  box-shadow: 0 0 6px var(--blue-team);
  transform: scaleX(0);
  transition: transform 0.25s;
}

.nav-link:hover::after,
.nav-link.active::after { transform: scaleX(1); }

.nav-link.active {
  color: var(--blue-team);
  text-shadow: 0 0 8px rgba(0,240,255,0.4);
}

/* Cyberflipper special */
.nav-link.special         { color: var(--red-team); }
.nav-link.special:hover   { color: #ff2244; }
.nav-link.special::after  { background: var(--red-team); box-shadow: 0 0 6px var(--red-team); }
.nav-link.special.active  {
  color: var(--red-team);
  text-shadow: 0 0 8px rgba(217,4,41,0.5);
}

/* ── Mobile toggle ── */
.mob-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}

.bar {
  display: block;
  width: 22px; height: 2px;
  background: var(--text-primary);
  transition: transform 0.3s, opacity 0.3s;
}

.mob-toggle.active .bar.top { transform: rotate(45deg) translate(5px, 5px); }
.mob-toggle.active .bar.mid { opacity: 0; }
.mob-toggle.active .bar.bot { transform: rotate(-45deg) translate(5px, -5px); }

/* ── Responsive ── */
@media (max-width: 900px) {
  .hud-desktop { display: none; }
  .mob-toggle  { display: flex; }
  .tactical-nav { padding: 0.75rem 1rem; }

  .nav-links {
    position: absolute;
    top: 100%;
    left: 0; right: 0;
    background: rgba(8,8,8,0.98);
    border-bottom: 2px solid var(--red-team);
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
    gap: 0.25rem;
    transform: translateY(-110%);
    transition: transform 0.3s ease;
    z-index: var(--z-nav-dropdown);
    backdrop-filter: blur(16px);
  }

  .nav-links.open { transform: translateY(0); }

  .nav-link {
    width: 100%;
    padding: 0.6rem 0.5rem;
    font-size: 0.8rem;
    border-bottom: 1px solid var(--border-color);
  }

  .nav-link:last-child { border-bottom: none; }
}
</style>
