---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const currentTime = new Date().toISOString().split('T')[0];
---

<header class="command-header" role="banner">
  <!-- TOP HUD BAR - SYSTEM STATUS -->
  <div class="hud-top-bar">
    <div class="hud-item">
      <span class="hud-label">USER_AGENT:</span>
      <span class="hud-value" id="user-agent-info">ANONYMOUS</span>
    </div>
    <div class="hud-item only-desktop">
      <span class="hud-label">DATE:</span>
      <span class="hud-value">{currentTime}</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">ACCESS:</span>
      <span class="hud-value secure">GRANTED</span>
    </div>
    <div class="hud-item only-desktop">
      <span class="hud-label">DEFCON:</span>
      <span class="hud-value warning">3</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">LANG:</span>
      <a href="/es" class={lang === 'es' ? 'lang-switch active' : 'lang-switch'}>ES</a>
      <span class="separator">|</span>
      <a href="/en" class={lang === 'en' ? 'lang-switch active' : 'lang-switch'}>EN</a>
    </div>
  </div>

  <!-- MAIN NAVIGATION -->
  <nav class="tactical-nav" role="navigation" aria-label="Main navigation">
    <a href={`/${lang}/`} class="brand-unit">
      <span class="bracket">[</span>
      <span class="brand-text">FLIPPERMEN</span>
      <span class="bracket">]</span>
    </a>

    <!-- Hamburger / Mobile Toggle -->
    <button id="mobile-menu-btn" class="mobile-toggle" aria-label="Toggle Navigation" aria-expanded="false">
      <div class="bar top"></div>
      <div class="bar mid"></div>
      <div class="bar bot"></div>
    </button>

    <div class="nav-links-container" id="nav-links">
      <a href={`/${lang}/about`} class={currentPath.includes('/about') ? 'active' : ''}>
        <span class="nav-icon">👤</span> IDENTITY
      </a>
      <a href={`/${lang}/writeups`} class={currentPath.includes('/writeups') ? 'active' : ''}>
        <span class="nav-icon">📝</span> OPS_LOG
      </a>
      <a href={`/${lang}/certs`} class={currentPath.includes('/certs') ? 'active' : ''}>
        <span class="nav-icon">🏅</span> CREDENTIALS
      </a>
      <a href={`/${lang}/wiki`} class={currentPath.includes('/wiki') ? 'active' : ''}>
        <span class="nav-icon">📚</span> WIKI
      </a>
      <a href={`/${lang}/contact`} class={currentPath.includes('/contact') ? 'active' : ''}>
        <span class="nav-icon">📡</span> COMMS
      </a>
      <a href={`/${lang}/cyberflipper`} class={currentPath.includes('/cyberflipper') ? 'active special-link' : 'special-link'}>
        <span class="nav-icon">🏴‍☠️</span> CYBERFLIPPER
      </a>
    </div>
  </nav>
</header>

<script>
  // Dynamic User Agent Display
  document.addEventListener('DOMContentLoaded', () => {
      const userAgentEl = document.getElementById('user-agent-info');
      // Only run if we haven't already populated it or if it's default
      if (userAgentEl && userAgentEl.textContent === 'ANONYMOUS') {
        const ua = navigator.userAgent;
        let displayUA = 'UNKNOWN';
        
        if (ua.includes('Windows')) displayUA = 'WIN_NT';
        else if (ua.includes('Mac')) displayUA = 'DARWIN';
        else if (ua.includes('Linux')) displayUA = 'ELF64';
        else if (ua.includes('Android')) displayUA = 'ANDROID';
        else if (ua.includes('iPhone') || ua.includes('iPad')) displayUA = 'IOS';
        
        userAgentEl.textContent = displayUA;
      }

      // Mobile Menu Logic
      const menuBtn = document.getElementById('mobile-menu-btn');
      const navLinks = document.getElementById('nav-links');

      if (menuBtn && navLinks) {
          // Clone to remove old listeners
          const newBtn = menuBtn.cloneNode(true);
          menuBtn.parentNode.replaceChild(newBtn, menuBtn);

          newBtn.addEventListener('click', () => {
              navLinks.classList.toggle('open');
              newBtn.classList.toggle('active');
          });
      }
  });
</script>

<style>
  /* Command Header - Bright Cyber-Ops Edition */
  .command-header {
    background: var(--bg-panel);
    border-bottom: 2px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: var(--font-mono);
    box-shadow: var(--shadow-sm);
  }

  /* TOP HUD BAR */
  .hud-top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    background: #111; /* Always dark for contrast */
    padding: 0.3rem 2rem;
    font-size: 0.7rem;
    border-bottom: 1px solid var(--border-color);
    gap: 1.5rem;
    letter-spacing: 0.5px;
    color: #eee;
  }

  .hud-item {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .hud-label { 
    color: #888; 
    font-weight: 600;
  }
  
  .hud-value { 
    color: #fff; 
    font-weight: bold; 
  }
  
  .hud-value.secure { color: #00F0FF; }
  .hud-value.warning { color: #D90429; }

  /* Language Switcher */
  .lang-switch {
      color: #666;
      text-decoration: none;
      font-weight: bold;
      transition: color 0.2s;
  }
  .lang-switch.active {
      color: #fff;
      text-shadow: 0 0 5px rgba(255,255,255,0.5);
  }
  .lang-switch:hover {
      color: #00F0FF;
  }
  .separator { color: #444; }

  /* MAIN NAV */
  .tactical-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    background: var(--bg-panel);
  }

  /* BRAND */
  .brand-unit {
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bracket { 
    color: var(--blue-team); 
    transition: all 0.3s; 
  }
  .brand-unit:hover .bracket { 
    color: var(--red-team);
  }

  /* NAV LINKS */
  .nav-links-container {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links-container a {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    position: relative;
    padding: 0.5rem 0;
    transition: all 0.2s;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-icon { opacity: 0.7; transition: 0.3s; font-size: 1rem; }
  .nav-links-container a:hover .nav-icon { opacity: 1; color: var(--blue-team); }

  .nav-links-container a:hover,
  .nav-links-container a.active {
    color: var(--text-primary);
  }

  .nav-links-container a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--blue-team);
    transition: width 0.3s;
  }

  .nav-links-container a:hover::after,
  .nav-links-container a.active::after {
    width: 100%;
  }

  .special-link {
    color: var(--red-team) !important;
  }
  
  .special-link .nav-icon {
      filter: drop-shadow(0 0 2px rgba(217, 4, 41, 0.5));
  }

  /* MOBILE TOGGLE */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
  }

  .bar {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: 0.3s;
  }
  
  .mobile-toggle.active .bar.top { transform: rotate(45deg) translate(5px, 5px); }
  .mobile-toggle.active .bar.mid { opacity: 0; }
  .mobile-toggle.active .bar.bot { transform: rotate(-45deg) translate(5px, -5px); }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .only-desktop { display: none; }
    
    .mobile-toggle { display: flex; }
    
    .nav-links-container {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: var(--bg-panel);
      border-bottom: 2px solid var(--blue-team);
      flex-direction: column;
      padding: 2rem;
      gap: 1.5rem;
      transform: translateY(-150%);
      transition: transform 0.3s ease-in-out;
      z-index: 999;
      box-shadow: var(--shadow-md);
    }

    .nav-links-container.open {
      transform: translateY(0);
    }
  }
</style>
