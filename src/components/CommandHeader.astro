---
const { currentPath } = Astro.url;
const currentTime = new Date().toISOString().split('T')[0];
---

<header class="command-header" role="banner">
  <div class="hud-top-bar">
    <div class="hud-item">
      <span class="hud-label">USER_AGENT:</span>
      <span class="hud-value" id="user-agent-info">ANONYMOUS</span>
    </div>
    <div class="hud-item only-desktop">
      <span class="hud-label">DATE:</span>
      <span class="hud-value">{currentTime}</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">ACCESS:</span>
      <span class="hud-value secure">GRANTED</span>
    </div>
    <div class="hud-item only-desktop">
      <span class="hud-label">DEFCON:</span>
      <span class="hud-value warning">3</span>
    </div>
    <div class="hud-item">
      <span class="hud-label">SESS:</span>
      <span class="hud-value blink">0xFACEB00C</span>
    </div>
  </div>

  <nav class="tactical-nav" role="navigation" aria-label="Main navigation">
    <a href="/" class="brand-unit">
      <span class="bracket">[</span>
      <span class="brand-text">FLIPPERMEN</span>
      <span class="bracket">]</span>
    </a>

    <!-- Hamburger / Mobile Toggle -->
    <button id="mobile-menu-btn" class="mobile-toggle" aria-label="Toggle Navigation" aria-expanded="false">
      <div class="bar top"></div>
      <div class="bar mid"></div>
      <div class="bar bot"></div>
    </button>

    <div class="nav-links-container" id="nav-links">
      <a href="/about" class={currentPath === '/about' ? 'active' : ''}>
        <span class="nav-icon">👤</span> IDENTITY
      </a>
      <a href="/writeups" class={currentPath === '/writeups' ? 'active' : ''}>
        <span class="nav-icon">📝</span> OPS_LOG
      </a>
      <a href="/certs" class={currentPath === '/certs' ? 'active' : ''}>
        <span class="nav-icon">🏅</span> CREDENTIALS
      </a>
      <a href="/wiki" class={currentPath === '/wiki' ? 'active' : ''}>
        <span class="nav-icon">📚</span> WIKI
      </a>
      <a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>
        <span class="nav-icon">📡</span> COMMS
      </a>
      <a href="/cyberflipper" class={currentPath === '/cyberflipper' ? 'active special-link' : 'special-link'}>
        <span class="nav-icon">🏴‍☠️</span> CYBERFLIPPER
      </a>
      
      <div class="separator"></div>

      <button id="themeToggle" class="theme-switch" aria-label="Toggle Night Vision">
        <span class="switch-icon">👁️</span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Ensure scripts only run once per page load
  document.addEventListener('DOMContentLoaded', function() {
    // Mobile Menu Logic
    const menuBtn = document.getElementById('mobile-menu-btn');
    const navLinks = document.getElementById('nav-links');

    if (menuBtn && navLinks) {
      // Remove any existing listeners before adding new ones
      const newMenuBtn = menuBtn.cloneNode(true);
      menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);
      
      newMenuBtn.addEventListener('click', () => {
        navLinks.classList.toggle('open');
        newMenuBtn.classList.toggle('active');
        const expanded = newMenuBtn.getAttribute('aria-expanded') === 'true' || false;
        newMenuBtn.setAttribute('aria-expanded', String(!expanded));
      });
    }

    // Dynamic User Agent Display
    const userAgentEl = document.getElementById('user-agent-info');
    if (userAgentEl && userAgentEl.textContent === 'ANONYMOUS') {
      const ua = navigator.userAgent;
      let displayUA = 'UNKNOWN';
      
      if (ua.includes('Windows')) displayUA = 'WIN_NT';
      else if (ua.includes('Mac')) displayUA = 'DARWIN';
      else if (ua.includes('Linux')) displayUA = 'ELF64';
      else if (ua.includes('Android')) displayUA = 'ANDROID';
      else if (ua.includes('iPhone') || ua.includes('iPad')) displayUA = 'IOS';
      
      userAgentEl.textContent = displayUA;
    }
  });
</script>

<style>
  /* Command Header - Verified Layout */

  /* HEADER CONTAINER */
  .command-header {
    background: var(--navy);
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, var(--crimson), var(--blue-steel)) 1;
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: var(--font-mono);
    box-shadow: 0 4px 20px rgba(220, 38, 38, 0.1);
  }

  /* TOP HUD BAR */
  .hud-top-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    background: #050a14;
    padding: 0.4rem 2rem;
    font-size: 0.7rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    gap: 1.5rem;
    letter-spacing: 0.5px;
  }

  .hud-item {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .hud-label { 
    color: var(--slate); 
    font-weight: 600;
    font-size: 0.65rem;
  }
  
  .hud-value { 
    color: #eee; 
    font-weight: bold; 
    font-family: var(--font-mono);
  }
  
  .hud-value.secure { 
    color: var(--gold); 
    text-shadow: 0 0 5px rgba(255, 215, 0, 0.3);
  }
  
  .hud-value.warning { 
    color: var(--crimson); 
  }
  
  .hud-value.blink { 
    animation: blink 2s infinite; 
    color: var(--crimson);
    font-weight: 800;
  }

  @keyframes blink { 
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; } 
  }

  /* MAIN NAV */
  .tactical-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* BRAND */
  .brand-unit {
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
  }

  .bracket { 
    color: var(--gold); 
    transition: all 0.3s; 
    font-weight: normal;
  }
  .brand-unit:hover .bracket { 
    text-shadow: 0 0 10px var(--gold); 
    color: #fff;
  }
  .brand-text { color: #fff; }

  /* NAV LINKS */
  .nav-links-container {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links-container a {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    position: relative;
    padding: 0.5rem 0;
    transition: all 0.2s;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-icon { opacity: 0.7; transition: 0.3s; font-size: 1rem; }
  .nav-links-container a:hover .nav-icon { opacity: 1; transform: scale(1.1); }

  .nav-links-container a:hover,
  .nav-links-container a.active {
    color: #fff;
    text-shadow: 0 0 10px rgba(255,255,255,0.2);
  }

  .nav-links-container a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), var(--crimson));
    transition: width 0.3s;
  }

  .nav-links-container a:hover::after,
  .nav-links-container a.active::after {
    width: 100%;
  }

  .special-link {
    color: var(--gold) !important;
  }

  .separator {
    width: 1px;
    height: 16px;
    background: var(--border-color);
  }

  /* THEME SWITCH */
  .theme-switch {
    background: none;
    border: 1px solid var(--border-color);
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s;
    opacity: 0.7;
    color: var(--gold);
  }

  .theme-switch:hover {
    border-color: var(--gold);
    opacity: 1;
    transform: rotate(15deg);
  }

  /* MOBILE TOGGLE */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
  }

  .bar {
    width: 24px;
    height: 2px;
    background: var(--gold);
    transition: 0.3s;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .only-desktop { display: none; }
    
    .mobile-toggle { display: flex; }
    
    .nav-links-container {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: rgba(11, 17, 32, 0.98);
      border-bottom: 2px solid var(--gold);
      flex-direction: column;
      padding: 2rem;
      gap: 1.5rem;
      transform: translateY(-150%);
      transition: transform 0.3s ease-in-out;
      z-index: 999;
      backdrop-filter: blur(10px);
    }

    .nav-links-container.open {
      transform: translateY(0);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
  }
</style>
