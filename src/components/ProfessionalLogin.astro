---
---
<div id="login-overlay" class="login-overlay">
  <div class="login-container">
    <div class="login-header">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" class="shield-icon">
          <path d="M12 2L3 7V12C3 17.52 7.5 22 12 22C16.5 22 21 17.52 21 12V7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 8V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 12H16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2>SECURE ACCESS TERMINAL</h2>
      <p>UNAUTHORIZED ACCESS IS PROHIBITED</p>
    </div>

    <div class="login-form">
      <div class="input-group">
        <label for="identity">IDENTITY</label>
        <div class="input-wrapper">
          <span class="prefix">USR_</span>
          <input type="text" id="identity" value="VISITOR_GUEST" readonly />
          <span class="status-icon success">✓</span>
        </div>
      </div>

      <div class="input-group">
        <label for="auth-token">MOLECULAR AUTH TOKEN</label>
        <div class="input-wrapper">
          <span class="prefix">KEY_</span>
          <input type="password" id="auth-token" value="••••••••••••" readonly />
          <span class="status-icon pending" id="token-status">⟳</span>
        </div>
      </div>

      <div class="biometric-scan">
        <div class="scan-line"></div>
        <p id="scan-text">INITIATING BIOMETRIC HANDSHAKE...</p>
      </div>

      <button id="access-btn" class="access-btn" disabled>
        <span class="btn-text">AUTHENTICATE</span>
        <span class="btn-glitch"></span>
      </button>
    </div>

    <div class="login-footer">
      <p>SYSTEM: <span class="sys-ok">OPERATIONAL</span></p>
      <p>ENCRYPTION: <span class="sys-ok">AES-256-GCM</span></p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Check if already logged in (session storage)
    if (sessionStorage.getItem('auth_session') === 'active') {
      document.getElementById('login-overlay').style.display = 'none';
      return;
    }

    const overlay = document.getElementById('login-overlay');
    const accessBtn = document.getElementById('access-btn');
    const scanText = document.getElementById('scan-text');
    const tokenStatus = document.getElementById('token-status');
    const tokenInput = document.getElementById('auth-token');

    // Simulation Sequence
    setTimeout(() => {
      scanText.textContent = "BIOMETRICS CONFIRMED";
      scanText.classList.add('success');
      tokenStatus.textContent = '✓';
      tokenStatus.classList.remove('pending');
      tokenStatus.classList.add('success');
      accessBtn.disabled = false;
      accessBtn.classList.add('ready');
      
      // Auto-click for smoother experience, or wait for user?
      // User asked for "Professional Login". Let's make them click to feel the interaction.
      scanText.textContent = "READY FOR AUTHENTICATION";
    }, 1500);

    accessBtn.addEventListener('click', () => {
      accessBtn.innerHTML = '<span class="btn-text">ACCESSING...</span>';
      accessBtn.classList.add('processing');
      
      setTimeout(() => {
        overlay.classList.add('fade-out');
        sessionStorage.setItem('auth_session', 'active');
        setTimeout(() => {
          overlay.style.display = 'none';
        }, 800);
      }, 800);
    });
  });
</script>

<style>
  .login-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #050505;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Inter', sans-serif;
  }

  .login-container {
    background: rgba(20, 20, 20, 0.9);
    border: 1px solid #333;
    padding: 3rem;
    width: 100%;
    max-width: 450px;
    border-radius: 4px;
    box-shadow: 0 0 50px rgba(0,0,0,0.8);
    position: relative;
    overflow: hidden;
  }

  .login-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--neon-blue), transparent);
    animation: scan-top 2s infinite;
  }

  .login-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .logo-icon {
    color: var(--neon-blue);
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 10px rgba(0, 112, 243, 0.5));
  }

  .login-header h2 {
    color: #fff;
    font-size: 1.2rem;
    letter-spacing: 2px;
    margin: 0;
    font-weight: 600;
  }

  .login-header p {
    color: #666;
    font-size: 0.7rem;
    letter-spacing: 1px;
    margin-top: 0.5rem;
  }

  .input-group {
    margin-bottom: 1.5rem;
  }

  .input-group label {
    display: block;
    color: #888;
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
    letter-spacing: 1px;
  }

  .input-wrapper {
    display: flex;
    align-items: center;
    background: #0a0a0a;
    border: 1px solid #333;
    padding: 0.8rem;
    border-radius: 2px;
    transition: all 0.3s;
  }

  .input-wrapper:focus-within {
    border-color: var(--neon-blue);
    box-shadow: 0 0 15px rgba(0, 112, 243, 0.1);
  }

  .prefix {
    color: #555;
    font-family: monospace;
    font-size: 0.9rem;
    margin-right: 0.5rem;
    user-select: none;
  }

  input {
    background: none;
    border: none;
    color: #fff;
    font-family: monospace;
    font-size: 1rem;
    width: 100%;
    outline: none;
    letter-spacing: 1px;
  }

  .status-icon {
    font-size: 1rem;
  }
  .status-icon.success { color: var(--neon-green); text-shadow: 0 0 8px var(--neon-green); }
  .status-icon.pending { color: #f5a623; animation: spin 1s linear infinite; }

  .biometric-scan {
    height: 2px;
    background: #111;
    margin: 2rem 0;
    position: relative;
    overflow: hidden;
  }

  .scan-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--neon-blue);
    transform: translateX(-100%);
    animation: scan 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  #scan-text {
    text-align: center;
    font-size: 0.7rem;
    color: #555;
    margin-top: 0.5rem;
    font-family: monospace;
    transition: color 0.3s;
  }
  #scan-text.success { color: var(--neon-blue); }

  .access-btn {
    width: 100%;
    padding: 1rem;
    background: #111;
    border: 1px solid #333;
    color: #555;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: 2px;
    cursor: not-allowed;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .access-btn.ready {
    background: var(--neon-blue);
    color: #000;
    border-color: var(--neon-blue);
    cursor: pointer;
    box-shadow: 0 0 20px rgba(0, 112, 243, 0.4);
  }

  .access-btn.ready:hover {
    background: #fff;
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.6);
  }

  .login-footer {
    border-top: 1px solid #222;
    margin-top: 2rem;
    padding-top: 1rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: #444;
    font-family: monospace;
  }

  .sys-ok { color: var(--neon-green); }

  .fade-out {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }

  @keyframes scan {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }

  @keyframes spin { 100% { transform: rotate(360deg); } }
</style>
