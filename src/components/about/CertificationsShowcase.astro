---
import AwardCard from '../AwardCard.astro';
import { getLangFromUrl } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const es   = lang === 'es';
---

<section class="cv-section">
  <h2 class="section-title">
    <i class="fas fa-graduation-cap"></i>
    {es ? 'Formación Elite' : 'Elite Training'}
  </h2>
  
  <!-- CBTeamer Showcase -->
  <div class="cert-showcase">
    <AwardCard
      title='Certified Blue Teamer (CBTeamer)'
      subtitle="ID: 10916716 | Ene 2026"
      image="/images/about/cbteamer.png"
      link="/certs/cbteamer"
    >
      <p>{es ? 'Dominio en DFIR, Threat Hunting y defensa en AD.' : 'Expertise in DFIR, Threat Hunting and AD defense.'}</p>
    </AwardCard>
  </div>

  <!-- Cyberwarfare Labs Section with Logo -->
  <div class="cwl-section">
    <div class="cwl-logo-container">
      <img 
        src="/images/about/cwl-logo.png" 
        alt="Cyberwarfare Labs Logo" 
        class="cwl-logo"
        loading="lazy"
        decoding="async"
      />
    </div>
    <h2 class="section-title"><i class="fas fa-biohazard"></i> Cyberwarfare Labs</h2>
  </div>
  
  <div class="feature-grid">
    <AwardCard
      title='Certified AD Red Team Specialist'
      subtitle="ID: 697ea4d4fbb... | Feb 2026"
      image="/images/about/cwl-ad-rts.png"
      link="/certs/ad-rts"
    />
    <AwardCard
      title='Certified Web Red Team Analyst'
      subtitle="ID: 6983d6b090d... | Feb 2026"
      image="/images/about/cwl-web-rta.png"
      link="/certs/web-rta"
    />
  </div>

  <!-- HTB Pro Labs Matrix -->
  <h3 class="subsection-title">Hack The Box Pro Labs (100% {es ? 'Completados' : 'Completed'})</h3>
  <div class="feature-grid">
    <AwardCard title='Cybernetics' subtitle="APT & Phishing" image="/images/about/Cybernetics.jpg" link="/certs/cybernetics" />
    <AwardCard title='APTLabs' subtitle="Lateral Movement" image="/images/about/aptlabs.jpg" link="/certs/aptlabs" />
    <AwardCard title='RastaLabs' subtitle="EDR Evasion" image="/images/about/rastalab.jpg" link="/certs/rastalabs" />
    <AwardCard title='Offshore' subtitle="AD Trusts" image="/images/about/Offshore.jpg" link="/certs/offshore" />
    <AwardCard title='Zephyr' subtitle="Pivoting" image="/images/about/Zephyr.jpg" link="/certs/zephyr" />
    <AwardCard title='Dante' subtitle="Exploit Dev" image="/images/about/dante.jpg" link="/certs/dante" />
  </div>
</section>

<style>
  .cv-section {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 1.8rem;
    color: var(--text-primary);
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.5rem;
    font-family: 'Share Tech Mono', monospace;
  }
  
  .section-title i { color: var(--blue-team); margin-right: 0.5rem; }

  .subsection-title {
    font-size: 1.4rem;
    color: var(--text-secondary);
    margin: 3rem 0 1.5rem;
    font-family: 'Share Tech Mono', monospace;
  }

  .cert-showcase {
    margin-bottom: 3rem;
  }

  .cwl-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    margin-top: 4rem;
  }
  
  .cwl-logo {
    height: 50px;
    width: auto;
    filter: drop-shadow(0 0 5px rgba(255, 0, 0, 0.3));
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .cwl-section {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
