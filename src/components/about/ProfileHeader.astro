---
// Profile Header Component for About Page
---

<header class="profile-header">
  <div class="profile-avatar">
    <img 
      src="/images/about/profile-photo.jpg" 
      alt="Esteban Jimenez - Red Team Operator" 
      loading="eager"
      decoding="async"
      width="160"
      height="160"
    />
  </div>
  
  <div class="profile-info">
    <h1 class="glitch-text" data-text="Esteban Jimenez">Esteban Jimenez</h1>
    <div class="profile-title">
      <span class="role red-role">Red Team Operator</span>
      <span class="separator">|</span>
      <span class="role purple-role">Purple Team Strategist</span>
      <span class="separator">|</span>
      <span class="role blue-role">Blue Team Lead</span>
    </div>
    
    <div class="profile-stats">
      <div class="stat-badge top-stat">
        <i class="fas fa-trophy"></i> Top 1 Ecuador & Global Top 50 (Hack The Box)
      </div>
      <div class="stat-badge">
        <i class="fas fa-flag"></i> Capitán Equipo Nacional LACC 2025
      </div>
    </div>

    <div class="profile-meta">
      <a href="mailto:jimenez.francisco16@yahoo.es" class="meta-link"><i class="fas fa-envelope"></i> Email</a>
      <a href="https://linkedin.com/in/esteban-jimenez-994868249/" target="_blank" rel="noopener noreferrer" class="meta-link"><i class="fab fa-linkedin"></i> LinkedIn</a>
      <a href="https://github.com/mrflippermen" target="_blank" rel="noopener noreferrer" class="meta-link"><i class="fab fa-github"></i> GitHub</a>
      <span class="location"><i class="fas fa-map-marker-alt"></i> Loja / Quito, Ecuador (Global)</span>
    </div>
  </div>
</header>
