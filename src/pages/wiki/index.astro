---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AwardCard from '../../components/AwardCard.astro';

const allWiki = await getCollection('wiki');
// Sort by title alphabetically
allWiki.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Knowledge Vault | Flippermen">
  <div class="vault-container">
    
    <div class="vault-header">
      <div class="classification-strip">
        // SECRET // NOFORN // ORCON
      </div>
      
      <h1 class="vault-title">INTELLIGENCE VAULT</h1>
      <p class="vault-subtitle">
        Central Repository for Field Tactics, Tradecraft & Exploitation.
      </p>
      
      <div class="vault-meta">
        <div class="meta-item">
            <span class="label">RECORDS:</span>
            <span class="value">{allWiki.length}</span>
        </div>
        <div class="meta-item">
            <span class="label">CLEARANCE:</span>
            <span class="value">LEVEL 5</span>
        </div>
        <div class="meta-item">
            <span class="label">STATUS:</span>
            <span class="value active">ONLINE</span>
        </div>
      </div>
    </div>
    
    <div class="vault-grid">
      {allWiki.map((entry) => (
        <a href={`/wiki/${entry.slug}`} class="vault-file">
            <div class="file-tab">
                <span class="file-type">DOC</span>
            </div>
            <div class="file-body">
                <h3 class="file-title">{entry.data.title}</h3>
                <p class="file-desc">{entry.data.description}</p>
                <div class="file-footer">
                    <span class="file-id">ID: {entry.slug.toUpperCase().substring(0, 6)}</span>
                    <span class="file-icon">📂</span>
                </div>
            </div>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .vault-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1rem;
    font-family: 'Inter', sans-serif;
  }

  /* HEADER */
  .vault-header {
    text-align: center;
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .classification-strip {
    background: var(--navy);
    color: var(--color-text-tertiary);
    display: inline-block;
    padding: 0.2rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 2px;
    border: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
  }

  .vault-title {
    font-size: 3rem;
    color: var(--color-text);
    margin: 0;
    font-weight: 900;
    letter-spacing: -1px;
  }
  
  .vault-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 2rem 0;
    font-family: var(--font-mono);
  }

  .vault-meta {
    display: flex;
    justify-content: center;
    gap: 3rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
    display: inline-flex;
  }

  .meta-item {
    display: flex;
    gap: 0.5rem;
  }

  .label { color: var(--color-text-tertiary); }
  .value { color: var(--gold); font-weight: bold; }
  .active { color: var(--color-badge-easy); }

  /* GRID */
  .vault-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* FILE FOLDER CARD */
  .vault-file {
    text-decoration: none;
    display: block;
    transition: transform 0.2s;
  }

  .vault-file:hover {
    transform: translateY(-4px);
  }

  .file-tab {
    background: var(--card-bg); /* darker tab */
    width: 40%;
    padding: 0.2rem 1rem;
    border: 1px solid var(--border-color);
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    font-size: 0.7rem;
    color: var(--slate);
    font-family: var(--font-mono);
  }

  .file-body {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-top: 2px solid var(--gold); /* Highlight bar */
    padding: 1.5rem;
    border-radius: 0 4px 4px 4px;
    min-height: 160px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
  }

  .vault-file:hover .file-body {
    border-color: var(--slate);
    background: rgba(30, 41, 59, 0.9);
  }

  .file-title {
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .file-desc {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    flex-grow: 1;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .file-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .file-id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  .file-icon {
    font-size: 1.2rem;
    opacity: 0.5;
  }
</style>
