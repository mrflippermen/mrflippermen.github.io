---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProfessionalLogin from '../components/ProfessionalLogin.astro';
---

<BaseLayout title="Flippermen | Strategic Command">
  
  <ProfessionalLogin />

  <div class="dashboard-container">
    
    <!-- EXECUTIVE PROFILE HEADER -->
    <header class="dashboard-header">
      <div class="header-content">
        <h1 class="executive-name">ESTEBAN JIMENEZ</h1>
        <div class="executive-role">
          <span class="role-badge red">RED TEAM OPERATOR</span>
          <span class="role-badge purple">PURPLE TEAM STRATEGIST</span>
        </div>
      </div>
      <div class="system-status">
        <div class="pulse-indicator"></div>
        <span class="status-text">SYSTEM OPERATIONAL</span>
      </div>
    </header>

    <!-- STRATEGIC GRID (5 Columns) -->
    <section class="strategic-grid">
      
      <!-- 1. IDENTITY -->
      <a href="/about" class="grid-card identity-card">
        <div class="card-icon"><Icon name="user-secret" /></div>
        <div class="card-body">
          <h3>IDENTITY</h3>
          <span class="card-desc">Executive Profile</span>
        </div>
        <div class="card-footer">
          <span class="access-level">LEVEL 5</span>
        </div>
      </a>

      <!-- 2. OPERATIONS -->
      <a href="/writeups" class="grid-card ops-card">
        <div class="card-icon"><Icon name="terminal" /></div>
        <div class="card-body">
          <h3>OPERATIONS</h3>
          <span class="card-desc">Mission Logs</span>
        </div>
        <div class="card-footer">
          <span class="access-level">ACTIVE</span>
        </div>
      </a>

      <!-- 3. ARSENAL -->
      <a href="/certs" class="grid-card arsenal-card">
        <div class="card-icon"><Icon name="certificate" /></div>
        <div class="card-body">
          <h3>ARSENAL</h3>
          <span class="card-desc">Credentials</span>
        </div>
        <div class="card-footer">
          <span class="access-level">VERIFIED</span>
        </div>
      </a>

      <!-- 4. INTELLIGENCE (WIKI) -->
      <a href="/wiki" class="grid-card intel-card">
        <div class="card-icon"><i class="fas fa-book-dead"></i></div> <!-- Fallback icon if Icon component misses it, assuming fontawesome present -->
        <div class="card-body">
          <h3>INTELLIGENCE</h3>
          <span class="card-desc">Knowledge Base</span>
        </div>
        <div class="card-footer">
          <span class="access-level">CLASSIFIED</span>
        </div>
      </a>

      <!-- 5. UNIT (CYBERFLIPPER) -->
      <a href="/cyberflipper" class="grid-card unit-card">
        <div class="card-icon"><i class="fas fa-biohazard"></i></div>
        <div class="card-body">
          <h3>CYBERFLIPPER</h3>
          <span class="card-desc">Special Unit</span>
        </div>
        <div class="card-footer">
          <span class="access-level">RESTRICTED</span>
        </div>
      </a>

    </section>

    <footer class="dashboard-footer">
      <div class="footer-ticker">
        <span>> ENCRYPTED CONNECTION ESTABLISHED</span>
        <span>> NODE: US-EAST-1</span>
        <span>> LATENCY: 2ms</span>
      </div>
    </footer>

  </div>
</BaseLayout>

<style>
  /* Dashboard Styling */
  .dashboard-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* HEADER */
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
    border-bottom: 1px solid #333;
    padding-bottom: 2rem;
  }

  .executive-name {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin: 0;
    color: #fff;
    background: linear-gradient(90deg, #fff, #888);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .executive-role {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .role-badge {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.8rem;
    border-radius: 2px;
    letter-spacing: 1px;
  }
  .role-badge.red { background: rgba(255, 51, 51, 0.1); color: var(--neon-red); border: 1px solid var(--neon-red); }
  .role-badge.purple { background: rgba(189, 147, 249, 0.1); color: #bd93f9; border: 1px solid #bd93f9; }

  .system-status {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: monospace;
    color: var(--neon-green);
    font-size: 0.9rem;
  }

  .pulse-indicator {
    width: 10px;
    height: 10px;
    background: var(--neon-green);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--neon-green);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.5; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* GRID SYSTEM */
  .strategic-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    perspective: 1000px;
  }

  .grid-card {
    background: rgba(20, 20, 20, 0.6);
    border: 1px solid #333;
    border-top: 2px solid #555;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 320px;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(5px);
  }

  .grid-card:hover {
    transform: translateY(-10px) scale(1.02);
    border-top-color: var(--neon-blue);
    background: rgba(30, 30, 30, 0.9);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    z-index: 10;
  }

  .card-icon {
    font-size: 2.5rem;
    color: #555;
    transition: 0.4s;
  }
  
  .grid-card:hover .card-icon {
    color: #fff;
    transform: scale(1.2);
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }

  .card-body h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: #ddd;
    letter-spacing: 1px;
  }

  .card-desc {
    font-size: 0.85rem;
    color: #777;
    margin-top: 0.5rem;
    display: block;
  }

  .card-footer {
    border-top: 1px solid #333;
    padding-top: 1rem;
    margin-top: auto;
  }

  .access-level {
    font-family: monospace;
    font-size: 0.7rem;
    color: #555;
    background: #111;
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
  }

  /* Specific Card Accents on Hover */
  .identity-card:hover { border-top-color: var(--neon-blue); }
  .ops-card:hover { border-top-color: var(--neon-green); }
  .arsenal-card:hover { border-top-color: var(--neon-red); }
  .intel-card:hover { border-top-color: #f1c40f; }
  .unit-card:hover { border-top-color: #9b59b6; }

  /* FOOTER */
  .dashboard-footer {
    margin-top: 4rem;
    border-top: 1px solid #222;
    padding-top: 1rem;
    font-family: monospace;
    color: #444;
    font-size: 0.8rem;
  }

  .footer-ticker {
    display: flex;
    gap: 2rem;
  }

  /* MEDIA QUERIES */
  @media (max-width: 1200px) {
    .strategic-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .dashboard-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .executive-name { font-size: 2.5rem; }
    .strategic-grid { grid-template-columns: 1fr; }
    .grid-card { height: 200px; flex-direction: row; align-items: center; padding: 1.5rem; }
    .card-footer { display: none; }
    .footer-ticker { flex-direction: column; gap: 0.5rem; }
  }
</style>
