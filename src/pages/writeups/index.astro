---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allWriteups = await getCollection('writeups');
// Sort by date desc if available, otherwise roughly keep order
allWriteups.sort((a, b) => {
  if (a.data.date && b.data.date) {
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  }
  return 0;
});
---

<BaseLayout title="Writeups | Flippermen">
  <div class="container">
    <h1>Writeups & CTFs</h1>
    <p>Collection of walkthroughs and security challenges.</p>
    
    <div class="feature-grid">
      {allWriteups.map((post) => (
        <div class="card">
           {post.data.header?.teaser ? (
             <img src={post.data.header.teaser.replace('/assets/', '/')} alt={post.data.title} style="height: 200px; object-fit: cover;" />
           ) : (
             <div style="height: 200px; background: #222; display: flex; align-items: center; justify-content: center; color: #555;">No Image</div>
           )}
           <div class="content">
            <h3><a href={`/writeups/${post.slug}`}>{post.data.title}</a></h3>
             <div style="margin-bottom: 1rem; color: #888; font-size: 0.9rem;">
               {post.data.date && new Date(post.data.date).toLocaleDateString()}
             </div>
             {post.data.excerpt && <p>{post.data.excerpt.substring(0, 150)}...</p>}
             <a href={`/writeups/${post.slug}`} class="btn" style="margin-top: 1rem;">Leer Writeup</a>
           </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
