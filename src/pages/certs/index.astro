---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AwardCard from '../../components/AwardCard.astro';

const allCerts = await getCollection('certs');
// Sort by date descending (newest first)
allCerts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout title="Credentials Vault | Flippermen">
  <div class="vault-container">
    
    <div class="vault-header">
      <h1 class="vault-title"><i class="fas fa-lock-open"></i> CREDENTIALS VAULT</h1>
      <p class="vault-subtitle">Official Certifications & Advanced Laboratories</p>
      <div class="vault-meta">
        <span>TOTAL_ASSETS: {allCerts.length}</span>
        <span>CLEARANCE: TOP_SECRET</span>
      </div>
    </div>
    
    <div class="vault-grid">
      {allCerts.map((cert) => (
        <AwardCard
          title={cert.data.title}
          subtitle={`${cert.data.platform} | ${cert.data.level}`}
          image={cert.data.image}
          link={`/certs/${cert.slug}`}
        >
          <div class="tags-container">
            {cert.data.tags && cert.data.tags.map(tag => (
              <span class="cert-tag">{tag}</span>
            ))}
          </div>
        </AwardCard>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  :root {
    --neon-green: #00ff41;
    --dark-bg: #050505;
    --glass-border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .vault-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1rem;
    font-family: 'Inter', sans-serif;
  }

  /* HEADER */
  .vault-header {
    text-align: center;
    margin-bottom: 4rem;
    border-bottom: 1px solid #333;
    padding-bottom: 2rem;
  }

  .vault-title {
    font-size: 2.5rem;
    color: #fff;
    margin: 0;
    font-weight: 800;
    letter-spacing: -1px;
  }
  
  .vault-title i { color: var(--neon-green); margin-right: 0.5rem; }

  .vault-subtitle {
    font-size: 1.1rem;
    color: #888;
    margin: 0.5rem 0 1.5rem 0;
  }

  .vault-meta {
    font-family: monospace;
    font-size: 0.9rem;
    color: var(--neon-green);
    display: flex;
    justify-content: center;
    gap: 2rem;
    background: rgba(0, 255, 65, 0.05);
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 255, 65, 0.2);
  }

  /* GRID */
  .vault-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  /* TAGS */
  .tags-container {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cert-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #aaa;
    border: 1px solid #333;
    transition: all 0.3s;
  }
  
  .cert-tag:hover {
    border-color: var(--neon-green);
    color: #fff;
  }
</style>
