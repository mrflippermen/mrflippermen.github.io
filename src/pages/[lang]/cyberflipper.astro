---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    {params: {lang: 'en'}},
    {params: {lang: 'es'}},
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Data could be moved to a JSON/TS file later
const stats = {
  operatives: 10,
  kills: 136,
  affiliation: { es: 'CELULA AUTONOMA', en: 'AUTONOMOUS CELL' }
};

---

<BaseLayout title={`CyberFlipper Initiative | ${t('nav.cyberflipper')}`}>
  <div class="fob-container">
    
    <!-- HEADER SECTION -->
    <section class="fob-header fade-in-up">
      <div class="header-content">
        <div class="hero-image-container">
            <img src="/images/cyberflipper_hero.png" alt="CyberFlipper Emblem" class="team-emblem" width="250" height="250" />
        </div>
        
        <div class="title-block">
          <h1 class="stamped-title">CYBERFLIPPERS</h1>
          <div class="unit-designation">SPECIAL OPERATIONS UNIT - ECUADOR</div>
        </div>

        <div class="origin-story">
            <h3>{lang === 'es' ? 'ORIGIN_STORY: THE "ZERO-BUDGET" CAMPAIGN' : 'ORIGIN_STORY: THE "ZERO-BUDGET" CAMPAIGN'}</h3>
            <p>
                {lang === 'es' 
                    ? 'En 2025, clasificamos al torno más importante de la región en Brasil. Solicitamos respaldo a nuestra institución. Su respuesta oficial fue: "Tomen una gorra y una camiseta. Suerte."'
                    : 'In 2025, we qualified for the most important tournament in the region in Brazil. We asked our institution for support. Their official response was: "Take a cap and a t-shirt. Good luck."'}
            </p>
            <p>
                {lang === 'es'
                    ? 'En ese momento entendimos que estábamos solos. Y nos encantó. Sin presupuesto, sin laboratorios patrocinados y sin mentores corporativos, CyberFlippers se convirtió en una célula autónoma. Convertimos la falta de recursos en nuestro mayor exploit. Mientras otros equipos viajaban con viáticos, nosotros estudiábamos kernels hasta las 4 AM.'
                    : 'At that moment we understood we were alone. And we loved it. With no budget, no sponsored labs, and no corporate mentors, CyberFlippers became an autonomous cell. We turned lack of resources into our greatest exploit. While other teams traveled with per diems, we studied kernels until 4 AM.'}
            </p>
            <blockquote class="quote">
                {lang === 'es'
                    ? 'Resultado: Top 1 Nacional, Top Regional y Respeto Global. No necesitamos su dinero. Necesitábamos un enemigo común. Gracias por la gorra.'
                    : 'Result: National Top 1, Regional Top Tier, and Global Respect. We didn\'t need their money. We needed a common enemy. Thanks for the cap.'}
            </blockquote>
        </div>
      </div>
    </section>

    <!-- STATS GRID -->
    <section class="achievements-section fade-in-up">
      <h3 class="section-label">UNIT_STATISTICS</h3>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="label">OPERATIVES</div>
          <div class="number">{stats.operatives}</div>
          <div class="sub-label">ACTIVE DUTY</div>
        </div>
        <div class="stat-card">
          <div class="label">CONFIRMED KILLS</div>
          <div class="number">{stats.kills}</div>
          <div class="sub-label">FLAGS CAPTURED</div>
        </div>
        <div class="stat-card">
          <div class="label">AFFILIATION</div>
          <div class="number">INDIE</div>
          <div class="sub-label">{lang === 'es' ? stats.affiliation.es : stats.affiliation.en}</div>
        </div>
      </div>
    </section>

    <!-- ROSTER -->
    <section class="roster-section fade-in-up">
      <div class="section-header-row">
        <h2 class="section-title">ACTIVE_ROSTER</h2>
        <div class="status-indicator">
          <span class="status-dot"></span> OPERATIONAL
        </div>
      </div>
      
      <div class="roster-grid">
        <!-- CAPTAIN -->
        <div class="operator-card captain">
          <div class="card-header">
            <span class="role">UNIT COMMANDER</span>
            <span class="rank">O-5</span>
          </div>
          <div class="op-name">flippermen</div>
          <div class="op-stats">
            <div><span class="stat-label">SPECIALTY:</span> AD INFRASTRUCTURE ARCHITECT</div>
            <div class="faction-tag red">RED TEAM LEAD</div>
          </div>
        </div>

        <!-- SPECIALISTS -->
        {[
            { name: "MarcGMN1403", role: "CRYPTANALYSIS LEAD", rank: "E-5", spec: "STEGANOGRAPHY" },
            { name: "AngelDustX", role: "WEB EXPLOITATION", rank: "E-4", spec: "SQLi/XSS EXPERT" },
            { name: "KomiGath", role: "DIGITAL FORENSICS", rank: "E-4", spec: "MALWARE REVERSE ENG" },
            { name: "ch1l1", role: "INTEL OPERATIVE", rank: "E-4", spec: "OSINT & SOCIAL ENG" },
            { name: "crrlla", role: "OPERATOR", rank: "E-3", spec: "NETWORK ASSAULT" },
            { name: "AdrianX", role: "OPERATOR", rank: "E-3", spec: "LINUX PRIVESC" },
            { name: "DiegoJr", role: "OPERATOR", rank: "E-3", spec: "WINDOWS INTERNALS" },
            { name: "0s0bit", role: "OPERATOR", rank: "E-3", spec: "SCRIPTING" },
            { name: "N01syb0y", role: "OPERATOR", rank: "E-3", spec: "HARDWARE HACKING" }
        ].map((op) => (
          <div class="operator-card">
            <div class="card-header">
              <span class="role">{op.role}</span>
              <span class="rank">{op.rank}</span>
            </div>
            <div class="op-name">{op.name}</div>
            <div class="op-stats">
              <div><span class="stat-label">SPEC:</span> {op.spec}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- INTERNATIONAL REPRESENTATION -->
    <section class="representation-section fade-in-up">
      <h2 class="section-title">GLOBAL_DEPLOYMENTS</h2>
      
      <div class="achievements-list">
        <div class="achievement-item gold-tier">
          <div class="achievement-header">
            <span class="flag">🥇</span>
            <span class="event">LACC 2025 - COLOMBIA</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">4TH PLACE REGIONAL</span> <br/> TEAM ECUADOR CAPTAIN
          </div>
        </div>

        <div class="achievement-item blue-tier">
          <div class="achievement-header">
            <span class="flag">🛡️</span>
            <span class="event">HOLMES CTF 2025</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">BEST LATAM BLUE TEAM</span> <br/> GLOBAL RANK 66
          </div>
        </div>

        <div class="achievement-item gold-tier">
          <div class="achievement-header">
            <span class="flag">🏆</span>
            <span class="event">HACK THE BOX</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">#1 ECUADOR</span> <br/> TOP 50 HALL OF FAME
          </div>
        </div>
      </div>
    </section>

    <!-- RECRUITMENT -->
    <section class="recruitment-section fade-in-up">
      <div class="recruit-frame">
        <h2 class="recruit-title">ENLISTMENT_PROTOCOL</h2>
        <p class="recruit-text">
          {lang === 'es' ? 'No buscamos certificados. Buscamos ' : 'We do not seek certificates. We seek '}
          <strong>{lang === 'es' ? 'obsesión' : 'obsession'}</strong>.
        </p>
        
        <div class="action-buttons">
          <a href="/contact" class="cta-btn primary">
            CONTACT COMMAND
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Use global variables from Bright Cyber-Ops theme */
  .fob-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1rem;
    font-family: var(--font-sans);
    color: var(--text-primary);
  }

  /* HEADER */
  .fob-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hero-image-container img {
    margin: 0 auto 1.5rem;
    display: block;
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 0 15px rgba(0,0,0,0.2));
  }

  .stamped-title {
    font-size: 3rem;
    font-weight: 900;
    margin: 0;
    color: var(--text-primary);
    letter-spacing: -1px;
    text-transform: uppercase;
    font-family: 'Share Tech Mono', monospace;
  }

  .unit-designation {
    color: var(--red-team);
    font-family: var(--font-mono);
    letter-spacing: 2px;
    font-size: 0.9rem;
    margin-top: 0.5rem;
    font-weight: bold;
  }

  /* NARRATIVE */
  .origin-story {
    max-width: 700px;
    margin: 2rem auto;
    text-align: left;
    background: rgba(255, 255, 255, 0.03); /* Subtle background */
    padding: 2rem;
    border-left: 4px solid var(--red-team);
    border-radius: 4px;
  }

  .origin-story h3 {
      font-family: 'Share Tech Mono', monospace;
      color: var(--red-team);
      margin-top: 0;
      font-size: 1.2rem;
  }

  .origin-story p {
      color: var(--text-secondary);
      margin-bottom: 1rem;
      line-height: 1.7;
  }

  .origin-story .quote {
      font-style: italic;
      color: var(--text-primary);
      font-weight: bold;
      margin: 1.5rem 0 0 0;
      padding-left: 1rem;
      border-left: 2px solid var(--blue-team);
  }

  /* STATS */
  .section-label {
    text-align: center;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .stat-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    text-align: center;
    border-radius: 2px;
  }

  .stat-card .label { font-size: 0.8rem; color: var(--text-secondary); font-family: var(--font-mono); }
  .stat-card .number { font-size: 2rem; font-weight: bold; color: var(--text-primary); margin: 0.5rem 0; font-family: 'Share Tech Mono'; }
  .stat-card .sub-label { font-size: 0.7rem; color: var(--blue-team); font-weight: bold; }

  /* ROSTER */
  .roster-section { margin-bottom: 4rem; }
  
  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .section-title { 
      font-size: 1.5rem; 
      font-weight: 800; 
      color: var(--text-primary); 
      margin: 0; 
      font-family: 'Share Tech Mono';
  }
  
  .status-indicator { 
    color: var(--success-color, #10B981); 
    font-family: var(--font-mono); 
    font-size: 0.8rem; 
    display: flex; 
    align-items: center; 
    gap: 0.5rem; 
  }
  
  .status-dot { width: 8px; height: 8px; background: var(--success-color, #10B981); border-radius: 50%; box-shadow: 0 0 5px var(--success-color, #10B981); }

  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .operator-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    padding: 1rem;
    border-radius: 2px;
    transition: all 0.3s;
  }

  .operator-card:hover {
      border-color: var(--blue-team);
      transform: translateY(-2px);
  }

  .operator-card.captain { 
      border-color: var(--red-team); 
      background: rgba(217, 4, 41, 0.05); 
  }

  .card-header { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-secondary); font-family: var(--font-mono); margin-bottom: 0.5rem; }
  .op-name { font-weight: bold; color: var(--text-primary); font-size: 1.1rem; }
  .op-stats { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; font-family: var(--font-mono); }
  
  .faction-tag {
      display: inline-block;
      margin-top: 5px;
      font-size: 0.7rem;
      font-weight: bold;
      color: var(--red-team);
  }

  /* REPRESENTATION */
  .representation-section { margin-bottom: 4rem; }
  
  .achievements-list { display: flex; flex-direction: column; gap: 1rem; }
  
  .achievement-item {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s;
  }
  
  .achievement-item:hover {
      box-shadow: var(--shadow-md);
      transform: translateX(5px);
  }

  .achievement-header { display: flex; align-items: center; gap: 1rem; font-weight: bold; color: var(--text-primary); }
  .achievement-details { text-align: right; font-size: 0.9rem; color: var(--text-secondary); font-family: var(--font-mono); }
  .highlight { color: var(--blue-team); font-weight: bold; }
  
  .gold-tier { border-left: 3px solid #F59E0B; }
  .blue-tier { border-left: 3px solid var(--blue-team); }

  /* RECRUITMENT */
  .recruitment-section { text-align: center; padding: 2rem; background: var(--bg-card); border: 1px solid var(--border-color); }
  .recruit-title { color: var(--text-primary); font-size: 1.5rem; margin-bottom: 1rem; font-family: 'Share Tech Mono'; }
  .recruit-text { color: var(--text-secondary); margin-bottom: 1.5rem; }
  
  .cta-btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    background: var(--red-team); /* Fix Ghost Button */
    color: #fff;
    font-weight: bold;
    text-decoration: none;
    border-radius: 2px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    transition: all 0.3s;
  }
  
  .cta-btn:hover { 
      background: var(--blue-team); 
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
  }

  @media (max-width: 768px) {
    .achievement-item { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .achievement-details { text-align: left; }
  }
</style>
