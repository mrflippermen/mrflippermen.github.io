---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);
const es   = lang === 'es';

// ─── Roster data ──────────────────────────────────────────────────────────────
const roster = [
  {
    handle:   'flippermen',
    role:     es ? 'COMANDANTE DE UNIDAD' : 'UNIT COMMANDER',
    rank:     'O-5',
    spec:     es ? 'ARQUITECTURA DE INFRAESTRUCTURA AD' : 'AD INFRASTRUCTURE ARCHITECT',
    faction:  'red',
    htb:      '#1 Ecuador',
    desc:     es
      ? 'Arquitecto de la unidad. Especialista en ataques full-spectrum contra Active Directory y Purple Team. Llevó a Ecuador al Top 1 de HTB. Diseña y lidera escenarios de adversarios reales en CTFs internacionales.'
      : 'Unit architect. Full-spectrum AD attacks and Purple Team operations specialist. Led Ecuador to HTB Top 1. Designs and leads real-world adversary scenarios in international CTFs.',
    captain: true,
  },
  {
    handle:   'MarcGMN1403',
    role:     es ? 'LÍDER DE CRIPTOANÁLISIS' : 'CRYPTANALYSIS LEAD',
    rank:     'E-5',
    spec:     es ? 'ESTEGANOGRAFÍA & CRIPTOGRAFÍA CUSTOM' : 'STEGANOGRAPHY & CUSTOM CRYPTO',
    faction:  'purple',
    desc:     es
      ? 'Maestro de los datos ocultos. Rompe esquemas de cifrado personalizados y extrae mensajes de ruido de imagen y audio con precisión quirúrgica.'
      : 'Master of hidden data. Breaks custom encryption schemes and extracts messages from image and audio noise with surgical precision.',
  },
  {
    handle:   'AngelDustX',
    role:     es ? 'EXPLOTACIÓN WEB' : 'WEB EXPLOITATION',
    rank:     'E-4',
    spec:     es ? 'SQLi / XSS / SSTI / SSRF' : 'SQLi / XSS / SSTI / SSRF',
    faction:  'red',
    desc:     es
      ? 'Primero en entrar en objetivos web. Encadena XSS→CSRF→RCE con precisión quirúrgica y trabaja a nivel de código fuente.'
      : 'First through the door on web targets. Chains XSS→CSRF→RCE with surgical precision and operates at source-code level.',
  },
  {
    handle:   'KomiGath',
    role:     es ? 'FORENSE DIGITAL' : 'DIGITAL FORENSICS',
    rank:     'E-4',
    spec:     es ? 'INGENIERÍA INVERSA DE MALWARE' : 'MALWARE REVERSE ENGINEERING',
    faction:  'blue',
    desc:     es
      ? 'El cirujano de memoria del equipo. Extrae artefactos volátiles de sistemas comprometidos y desmonta malware en IDA Pro como si leyera prosa.'
      : 'Team memory surgeon. Extracts volatile artifacts from compromised systems and disassembles malware in IDA Pro like reading prose.',
  },
  {
    handle:   'ch1l1',
    role:     es ? 'OPERATIVO DE INTELIGENCIA' : 'INTEL OPERATIVE',
    rank:     'E-4',
    spec:     es ? 'OSINT & INGENIERÍA SOCIAL' : 'OSINT & SOCIAL ENGINEERING',
    faction:  'purple',
    desc:     es
      ? 'Operativo fantasma. Mapea organizaciones enteras a través de señales de fuentes abiertas antes de que se envíe un solo paquete al objetivo.'
      : 'Ghost operative. Maps entire organizations through open-source signals before a single packet is sent to the target.',
  },
  {
    handle:   'crrlla',
    role:     es ? 'OPERADOR' : 'OPERATOR',
    rank:     'E-3',
    spec:     es ? 'ASALTO DE RED & PIVOTING' : 'NETWORK ASSAULT & PIVOTING',
    faction:  'red',
    desc:     es
      ? 'Táctico de red. Pivota a través de entornos segmentados usando scripts de tunelización propios y mantiene persistencia silenciosa.'
      : 'Network tactician. Pivots through segmented environments using custom tunneling scripts and maintains silent persistence.',
  },
  {
    handle:   'AdrianX',
    role:     es ? 'OPERADOR' : 'OPERATOR',
    rank:     'E-3',
    spec:     es ? 'PRIVESC LINUX & KERNEL EXPLOITS' : 'LINUX PRIVESC & KERNEL EXPLOITS',
    faction:  'red',
    desc:     es
      ? 'Susurrador del kernel Linux. Encuentra misconfigs de SUID dormido y escala privilegios sin tocar disco. Especialista en hardening bypass.'
      : 'Linux kernel whisperer. Finds SUID misconfigs in his sleep and escalates privileges without touching disk. Hardening bypass specialist.',
  },
  {
    handle:   'DiegoJr',
    role:     es ? 'OPERADOR' : 'OPERATOR',
    rank:     'E-3',
    spec:     es ? 'WINDOWS INTERNALS & TOKEN ABUSE' : 'WINDOWS INTERNALS & TOKEN ABUSE',
    faction:  'red',
    desc:     es
      ? 'Experto en internals de Windows. Lee el registro como un libro y abusa de la impersonación de tokens con fluidez. Especialista en Pass-the-Hash.'
      : 'Windows internals expert. Reads the registry like a book and abuses token impersonation fluently. Pass-the-Hash specialist.',
  },
  {
    handle:   '0s0bit',
    role:     es ? 'OPERADOR' : 'OPERATOR',
    rank:     'E-3',
    spec:     es ? 'SCRIPTING & AUTOMATIZACIÓN' : 'SCRIPTING & AUTOMATION',
    faction:  'purple',
    desc:     es
      ? 'La forja de herramientas del equipo. Automatiza lo repetitivo y construye utilidades a velocidad CTF. Si hay un patrón, él lo scriptea.'
      : 'Team\'s tool forge. Automates the repetitive and builds utilities at CTF speed. If there\'s a pattern, he scripts it.',
  },
  {
    handle:   'N01syb0y',
    role:     es ? 'OPERADOR' : 'OPERATOR',
    rank:     'E-3',
    spec:     es ? 'HACKING DE HARDWARE & RF' : 'HARDWARE HACKING & RF',
    faction:  'purple',
    desc:     es
      ? 'El hardware no es una barrera. Clona RFID, reproduce señales RF y convierte el Flipper Zero en un arma táctica. Experto en BadUSB y SDR.'
      : 'Hardware is no barrier. Clones RFID, replays RF signals, and turns Flipper Zero into a tactical weapon. BadUSB and SDR expert.',
  },
];

// ─── Deployments ──────────────────────────────────────────────────────────────
const deployments = [
  {
    tier:   'gold',
    icon:   'fa-trophy',
    event:  'HACK THE BOX',
    year:   '2024–2025',
    result: es ? '#1 ECUADOR — TOP 50 MUNDIAL' : '#1 ECUADOR — GLOBAL TOP 50',
    detail: es ? 'Ranking nacional sostenido. Hall of Fame de HTB.' : 'Sustained national ranking. HTB Hall of Fame.',
  },
  {
    tier:   'gold',
    icon:   'fa-flag',
    event:  'LACC 2025 — COLOMBIA',
    year:   '2025',
    result: es ? '4.º LUGAR REGIONAL' : '4TH PLACE REGIONAL',
    detail: es ? 'Capitán del Equipo Ecuador. Competencia más grande de LatAm.' : 'Captain of Team Ecuador. Largest LatAm cybersecurity championship.',
  },
  {
    tier:   'blue',
    icon:   'fa-shield-halved',
    event:  'HOLMES CTF 2025',
    year:   '2025',
    result: es ? 'MEJOR BLUE TEAM LATAM' : 'BEST LATAM BLUE TEAM',
    detail: es ? 'Rank 66 global. DFIR y respuesta a incidentes en vivo.' : 'Global rank 66. Live DFIR and incident response challenge.',
  },
  {
    tier:   'purple',
    icon:   'fa-crosshairs',
    event:  'FLUID ATTACKS CTF 2026',
    year:   '2026',
    result: es ? 'TOP 5 NACIONAL' : 'NATIONAL TOP 5',
    detail: es ? 'Full-spectrum: pwn, web, crypto y forense.' : 'Full-spectrum: pwn, web, crypto and forensics.',
  },
];
---

<BaseLayout title={`CyberFlippers | ${t('nav.cyberflipper')}`}>
<div class="cf-page">

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="cf-hero">
    <div class="cf-hero-inner">

      <div class="cf-emblem-wrap">
        <img
          src="/images/cyberflipper_hero.png"
          alt="CyberFlippers Emblem"
          class="cf-emblem"
          width="200" height="200"
        />
        <div class="emblem-scan"></div>
        <div class="emblem-ring"></div>
      </div>

      <div class="cf-title-block">
        <p class="cf-overtitle">// SPECIAL OPERATIONS UNIT — ECUADOR //</p>
        <h1 class="cf-title glitch" data-text="CYBERFLIPPERS">CYBERFLIPPERS</h1>
        <p class="cf-tagline">
          {es
            ? 'Célula autónoma. Sin presupuesto. Sin excusas. Pura obsesión técnica.'
            : 'Autonomous cell. No budget. No excuses. Pure technical obsession.'}
        </p>
        <div class="cf-badges">
          <span class="cf-badge red"><i class="fas fa-skull-crossbones"></i> RED TEAM</span>
          <span class="cf-badge blue"><i class="fas fa-shield-halved"></i> BLUE TEAM</span>
          <span class="cf-badge green"><i class="fas fa-satellite-dish"></i> CTF OPS</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════ ORIGIN STORY ═══════════════════════════ -->
  <section class="cf-section reveal">
    <h2 class="cf-section-title">
      <i class="fas fa-book-skull"></i>
      {es ? 'HISTORIA DE ORIGEN' : 'ORIGIN STORY'}
    </h2>
    <div class="origin-block">
      <div class="origin-terminal">
        <div class="term-bar">
          <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
          <span class="term-title">incident_report.log</span>
        </div>
        <div class="term-body">
          <p class="term-line"><span class="term-prompt">$</span> {es ? 'cat historia.txt' : 'cat history.txt'}</p>
          <p class="term-out">
            {es
              ? 'En 2025, clasificamos al torneo más importante de la región en Brasil. Solicitamos respaldo institucional. La respuesta oficial fue: "Tomen una gorra y una camiseta. Suerte."'
              : 'In 2025, we qualified for the largest regional tournament in Brazil. We asked for institutional support. The official response was: "Take a cap and a t-shirt. Good luck."'}
          </p>
          <p class="term-out">
            {es
              ? 'En ese momento entendimos que estábamos solos. Y nos encantó. Sin presupuesto, sin laboratorios patrocinados, sin mentores corporativos. CyberFlippers se convirtió en una célula autónoma. Convertimos la falta de recursos en nuestro mayor exploit: mientras otros equipos viajaban con viáticos, nosotros estudiábamos kernels hasta las 4 AM.'
              : 'At that moment we understood we were alone. And we loved it. No budget, no sponsored labs, no corporate mentors. CyberFlippers became an autonomous cell. We turned the lack of resources into our greatest exploit: while other teams traveled with per diems, we studied kernels until 4 AM.'}
          </p>
          <blockquote class="term-quote">
            <i class="fas fa-terminal quote-icon"></i>
            {es
              ? 'Resultado: Top 1 Nacional, Top Regional y Respeto Global. No necesitábamos su dinero. Necesitábamos un enemigo común. Gracias por la gorra.'
              : 'Result: National Top 1, Regional Top Tier, Global Respect. We didn\'t need their money. We needed a common enemy. Thanks for the cap.'}
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ STATS ═══════════════════════════ -->
  <section class="cf-section reveal">
    <h2 class="cf-section-title">
      <i class="fas fa-chart-line"></i>
      {es ? 'ESTADÍSTICAS DE UNIDAD' : 'UNIT STATISTICS'}
    </h2>
    <div class="cf-stats-grid">
      <div class="cf-stat-card">
        <i class="fas fa-users stat-icon green"></i>
        <span class="stat-num">10</span>
        <span class="stat-name">{es ? 'OPERATIVOS' : 'OPERATIVES'}</span>
        <span class="stat-sub">{es ? 'SERVICIO ACTIVO' : 'ACTIVE DUTY'}</span>
      </div>
      <div class="cf-stat-card">
        <i class="fas fa-flag stat-icon red"></i>
        <span class="stat-num">136+</span>
        <span class="stat-name">{es ? 'KILLS CONFIRMADOS' : 'CONFIRMED KILLS'}</span>
        <span class="stat-sub">{es ? 'FLAGS CAPTURADAS' : 'FLAGS CAPTURED'}</span>
      </div>
      <div class="cf-stat-card">
        <i class="fas fa-trophy stat-icon gold"></i>
        <span class="stat-num">#1</span>
        <span class="stat-name">ECUADOR</span>
        <span class="stat-sub">HACK THE BOX</span>
      </div>
      <div class="cf-stat-card">
        <i class="fas fa-globe stat-icon blue"></i>
        <span class="stat-num">4+</span>
        <span class="stat-name">{es ? 'CTFs INTERNACIONALES' : 'INTERNATIONAL CTFs'}</span>
        <span class="stat-sub">{es ? 'REPRESENTANDO ECUADOR' : 'REPRESENTING ECUADOR'}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ ROSTER ═══════════════════════════ -->
  <section class="cf-section reveal">
    <div class="section-header-row">
      <h2 class="cf-section-title no-margin">
        <i class="fas fa-id-card-clip"></i>
        {es ? 'ROSTER ACTIVO' : 'ACTIVE ROSTER'}
      </h2>
      <div class="op-indicator">
        <span class="op-dot"></span>
        <span>{es ? 'OPERACIONAL' : 'OPERATIONAL'}</span>
      </div>
    </div>

    <div class="roster-grid">
      {roster.map((op) => (
        <article class={`op-card faction-${op.faction}${op.captain ? ' captain-card' : ''}`}>

          {op.captain && (
            <div class="captain-banner">
              <i class="fas fa-star"></i>
              {es ? 'CAPITÁN' : 'CAPTAIN'}
              <i class="fas fa-star"></i>
            </div>
          )}

          <div class="op-header">
            <span class={`faction-dot dot-${op.faction}`}></span>
            <span class="op-role">{op.role}</span>
            <span class="op-rank">{op.rank}</span>
          </div>

          <div class="op-handle">{op.handle}</div>

          <div class="op-spec">
            <i class="fas fa-crosshairs spec-icon"></i>
            {op.spec}
          </div>

          <p class="op-desc">{op.desc}</p>

          {op.htb && (
            <div class="op-badge htb-badge">
              <i class="fas fa-trophy"></i> HTB {op.htb}
            </div>
          )}

        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════ DEPLOYMENTS ═══════════════════════════ -->
  <section class="cf-section reveal">
    <h2 class="cf-section-title">
      <i class="fas fa-rocket"></i>
      {es ? 'DESPLIEGUES GLOBALES' : 'GLOBAL DEPLOYMENTS'}
    </h2>

    <div class="deployments-list">
      {deployments.map((d) => (
        <div class={`deploy-item tier-${d.tier}`}>
          <div class="deploy-icon">
            <i class={`fas ${d.icon}`}></i>
          </div>
          <div class="deploy-body">
            <div class="deploy-event">{d.event}</div>
            <div class="deploy-result">{d.result}</div>
            <div class="deploy-detail">{d.detail}</div>
          </div>
          <div class="deploy-year">{d.year}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════ DOCTRINE ═══════════════════════════ -->
  <section class="cf-section reveal">
    <h2 class="cf-section-title">
      <i class="fas fa-scroll"></i>
      {es ? 'DOCTRINA OPERACIONAL' : 'OPERATIONAL DOCTRINE'}
    </h2>
    <div class="doctrine-grid">
      <div class="doctrine-card">
        <i class="fas fa-brain doctrine-icon red"></i>
        <h3>{es ? 'MENTALIDAD ADVERSARIA' : 'ADVERSARIAL MINDSET'}</h3>
        <p>{es
          ? 'Pensamos como el atacante incluso cuando defendemos. Ningún sistema es sacrosanto: todo tiene una superficie de ataque.'
          : 'We think like the attacker even when defending. No system is sacrosanct: everything has an attack surface.'}</p>
      </div>
      <div class="doctrine-card">
        <i class="fas fa-code-branch doctrine-icon blue"></i>
        <h3>{es ? 'AUTONOMÍA TÉCNICA' : 'TECHNICAL AUTONOMY'}</h3>
        <p>{es
          ? 'No dependemos de herramientas prefabricadas. Si no existe la herramienta que necesitamos, la construimos. El código es nuestra munición.'
          : 'We don\'t depend on off-the-shelf tools. If the tool we need doesn\'t exist, we build it. Code is our ammunition.'}</p>
      </div>
      <div class="doctrine-card">
        <i class="fas fa-shield-halved doctrine-icon green"></i>
        <h3>{es ? 'FULL-SPECTRUM' : 'FULL-SPECTRUM'}</h3>
        <p>{es
          ? 'Red Team, Blue Team, DFIR, hardware y criptografía. No somos especialistas de nicho: somos operadores de espectro completo.'
          : 'Red Team, Blue Team, DFIR, hardware, and cryptography. We are not niche specialists: we are full-spectrum operators.'}</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ RECRUITMENT ═══════════════════════════ -->
  <section class="cf-section reveal">
    <div class="recruit-box">
      <div class="recruit-corner tl"></div>
      <div class="recruit-corner tr"></div>
      <div class="recruit-corner bl"></div>
      <div class="recruit-corner br"></div>

      <p class="recruit-label">// ENLISTMENT_PROTOCOL //</p>
      <h2 class="recruit-title">
        {es ? '¿CREES QUE PUEDES ENTRAR?' : 'THINK YOU CAN MAKE IT?'}
      </h2>
      <p class="recruit-text">
        {es
          ? 'No buscamos certificados. No buscamos CVs impresionantes. Buscamos '
          : 'We don\'t seek certificates. We don\'t seek impressive CVs. We seek '}
        <strong class="highlight-word">{es ? 'obsesión' : 'obsession'}</strong>.
        {es
          ? ' Si eres capaz de quedarte despierto hasta las 4 AM por un flag, eres de los nuestros.'
          : ' If you\'re willing to stay up until 4 AM for a flag, you\'re one of us.'}
      </p>
      <a href={`/${lang}/contact`} class="recruit-btn">
        <i class="fas fa-terminal"></i>
        {es ? 'CONTACTAR COMANDO' : 'CONTACT COMMAND'}
      </a>
    </div>
  </section>

</div>
</BaseLayout>

<style>
/* ═══════════════════════════════════════════════════
   PAGE WRAPPER
═══════════════════════════════════════════════════ */
.cf-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 5rem;
}

/* ═══════════════════════════════════════════════════
   SHARED SECTION STYLES
═══════════════════════════════════════════════════ */
.cf-section { }

.cf-section-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 400;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 2rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-color);
  position: relative;
}

.cf-section-title::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0;
  width: 60px; height: 2px;
  background: linear-gradient(to right, var(--red-team), transparent);
}

.cf-section-title i { color: var(--red-team); font-size: 1rem; }
.cf-section-title.no-margin { margin-bottom: 0; }

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-color);
  position: relative;
}

.section-header-row::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0;
  width: 60px; height: 2px;
  background: linear-gradient(to right, var(--red-team), transparent);
}

.op-indicator {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--success-color);
  letter-spacing: 2px;
}

.op-dot {
  width: 8px; height: 8px;
  background: var(--success-color);
  border-radius: 50%;
  animation: pulse-ring 2s infinite;
}

@keyframes pulse-ring {
  0%   { box-shadow: 0 0 0 0   rgba(16,185,129,0.7); }
  70%  { box-shadow: 0 0 0 8px rgba(16,185,129,0); }
  100% { box-shadow: 0 0 0 0   rgba(16,185,129,0); }
}

/* ═══════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════ */
.cf-hero {
  padding: 2rem 0 0;
}

.cf-hero-inner {
  display: flex;
  align-items: center;
  gap: 3rem;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 3rem;
}

/* Emblem */
.cf-emblem-wrap {
  position: relative;
  flex-shrink: 0;
  width: 180px; height: 180px;
}

.cf-emblem {
  width: 180px; height: 180px;
  object-fit: contain;
  filter: drop-shadow(0 0 20px rgba(217,4,41,0.4)) grayscale(0.2);
  transition: filter 0.4s;
}

.cf-emblem-wrap:hover .cf-emblem {
  filter: drop-shadow(0 0 30px rgba(217,4,41,0.7)) grayscale(0);
}

/* rotating ring */
.emblem-ring {
  position: absolute;
  inset: -10px;
  border: 1px solid rgba(217,4,41,0.2);
  border-radius: 50%;
  animation: ring-spin 20s linear infinite;
}
@keyframes ring-spin { to { transform: rotate(360deg); } }

/* scan line */
.emblem-scan {
  position: absolute;
  top: -100%; left: 0;
  width: 100%; height: 3px;
  background: linear-gradient(transparent, var(--blue-team), transparent);
  animation: emblem-scan 3s ease-in-out infinite;
  opacity: 0.6;
}
@keyframes emblem-scan {
  0%   { top: -5%; }
  100% { top: 105%; }
}

/* Title block */
.cf-title-block { flex: 1; }

.cf-overtitle {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--red-team);
  letter-spacing: 3px;
  margin-bottom: 0.75rem;
  opacity: 0.8;
}

.cf-title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 400;
  letter-spacing: -1px;
  line-height: 1;
  color: var(--text-primary);
  margin: 0 0 1rem;
}

.cf-tagline {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
  border-left: 3px solid var(--red-team);
  padding-left: 1rem;
  line-height: 1.6;
}

.cf-badges { display: flex; gap: 0.6rem; flex-wrap: wrap; }

.cf-badge {
  font-family: var(--font-mono);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  padding: 0.3rem 0.7rem;
  border: 1px solid;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.cf-badge.red   { color: var(--red-team);    border-color: var(--red-team);    background: rgba(217,4,41,0.06);  }
.cf-badge.blue  { color: var(--blue-team);   border-color: var(--blue-team);   background: rgba(0,240,255,0.06); }
