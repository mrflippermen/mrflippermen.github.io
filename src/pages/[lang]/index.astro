---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProfessionalLogin from '../../components/ProfessionalLogin.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    {params: {lang: 'en'}},
    {params: {lang: 'es'}},
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Flippermen | ${t('nav.home')}`}>
  
  <ProfessionalLogin />

  <div class="dashboard-container">
    
    <!-- EXECUTIVE PROFILE HEADER -->
    <header class="dashboard-header">
      <div class="header-content">
        <h1 class="executive-name">ESTEBAN JIMENEZ</h1>
        <div class="executive-role">
          <span class="role-badge red">{t('role.red')}</span>
          <span class="role-badge purple">{t('role.purple')}</span>
        </div>
      </div>
      <div class="system-status">
        <div class="pulse-indicator"></div>
        <span class="status-text">{t('system.status')}</span>
      </div>
    </header>

    <!-- STRATEGIC GRID (5 Columns) -->
    <section class="strategic-grid">
      
      <!-- 1. IDENTITY -->
      <a href={`/${lang}/about`} class="grid-card identity-card">
        <div class="card-icon"><Icon name="user-secret" /></div>
        <div class="card-body">
          <h3>{t('card.identity')}</h3>
          <span class="card-desc">{t('card.identity.desc')}</span>
        </div>
        <div class="card-footer">
          <span class="access-level">LEVEL 5</span>
        </div>
      </a>

      <!-- 2. OPERATIONS -->
      <a href={`/${lang}/writeups`} class="grid-card ops-card">
        <div class="card-icon"><Icon name="terminal" /></div>
        <div class="card-body">
          <h3>{t('card.ops')}</h3>
          <span class="card-desc">{t('card.ops.desc')}</span>
        </div>
        <div class="card-footer">
          <span class="access-level">ACTIVE</span>
        </div>
      </a>

      <!-- 3. ARSENAL -->
      <a href={`/${lang}/certs`} class="grid-card arsenal-card">
        <div class="card-icon"><Icon name="certificate" /></div>
        <div class="card-body">
          <h3>{t('card.arsenal')}</h3>
          <span class="card-desc">{t('card.arsenal.desc')}</span>
        </div>
        <div class="card-footer">
          <span class="access-level">VERIFIED</span>
        </div>
      </a>

      <!-- 4. INTELLIGENCE (WIKI) -->
      <a href={`/${lang}/wiki`} class="grid-card intel-card">
        <div class="card-icon"><i class="fas fa-book-dead"></i></div>
        <div class="card-body">
          <h3>{t('card.intel')}</h3>
          <span class="card-desc">{t('card.intel.desc')}</span>
        </div>
        <div class="card-footer">
          <span class="access-level">CLASSIFIED</span>
        </div>
      </a>

      <!-- 5. UNIT (CYBERFLIPPER) -->
      <a href={`/${lang}/cyberflipper`} class="grid-card unit-card">
        <div class="card-icon"><i class="fas fa-biohazard"></i></div>
        <div class="card-body">
          <h3>{t('card.unit')}</h3>
          <span class="card-desc">{t('card.unit.desc')}</span>
        </div>
        <div class="card-footer">
          <span class="access-level">RESTRICTED</span>
        </div>
      </a>

    </section>

    <footer class="dashboard-footer">
      <div class="footer-ticker">
        <span>{t('footer.encrypted')}</span>
        <span>> NODE: US-EAST-1</span>
        <span>> LATENCY: 2ms</span>
      </div>
    </footer>

  </div>
</BaseLayout>

<style>
  /* Dashboard Styling - Bright Cyber-Ops */
  .dashboard-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* HEADER */
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .executive-name {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .executive-role {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .role-badge {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.4rem 0.8rem;
    border-radius: 2px;
    letter-spacing: 1px;
    font-family: var(--font-mono);
  }
  .role-badge.red { 
      background: rgba(217, 4, 41, 0.1); 
      color: var(--red-team); 
      border: 1px solid var(--red-team); 
  }
  .role-badge.purple { 
      background: rgba(114, 9, 183, 0.1); 
      color: var(--purple-team); 
      border: 1px solid var(--purple-team); 
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .pulse-indicator {
    width: 10px;
    height: 10px;
    background: var(--success-color, #10B981);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--success-color, #10B981);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.5; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* GRID SYSTEM */
  .strategic-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .grid-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--border-color);
    padding: 2rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 320px;
    position: relative;
    overflow: hidden;
  }

  .grid-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    background: #fff;
  }

  .card-icon {
    font-size: 2.5rem;
    color: var(--text-secondary);
    transition: 0.4s;
    opacity: 0.5;
  }
  
  .grid-card:hover .card-icon {
    color: var(--text-primary);
    transform: scale(1.1);
    opacity: 1;
  }

  .card-body h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 0.5px;
    font-family: var(--font-mono);
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    display: block;
    font-family: var(--font-sans);
  }

  .card-footer {
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    margin-top: auto;
  }

  .access-level {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: var(--bg-main);
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    border: 1px solid var(--border-color);
  }

  /* Specific Card Accents on Hover */
  .identity-card:hover { border-top-color: var(--blue-team); }
  .identity-card:hover .card-icon { color: var(--blue-team); }
  
  .ops-card:hover { border-top-color: var(--text-primary); }
  .ops-card:hover .card-icon { color: var(--text-primary); }
  
  .arsenal-card:hover { border-top-color: var(--red-team); }
  .arsenal-card:hover .card-icon { color: var(--red-team); }
  
  .intel-card:hover { border-top-color: var(--purple-team); }
  .intel-card:hover .card-icon { color: var(--purple-team); }
  
  .unit-card:hover { border-top-color: var(--success-color, #10B981); }
  .unit-card:hover .card-icon { color: var(--success-color, #10B981); }

  /* FOOTER */
  .dashboard-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .footer-ticker {
    display: flex;
    gap: 2rem;
  }

  /* MEDIA QUERIES */
  @media (max-width: 1200px) {
    .strategic-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .dashboard-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .executive-name { font-size: 2.5rem; }
    .strategic-grid { grid-template-columns: 1fr; }
    .grid-card { height: 200px; flex-direction: row; align-items: center; padding: 1.5rem; }
    .card-footer { display: none; }
    .footer-ticker { flex-direction: column; gap: 0.5rem; }
  }
</style>
