---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);
const es   = lang === 'es';

// ── Live query console ──────────────────────────────────────────────
// Default openquery REST API base. Deploy `openquery serve` (Render / Railway /
// Fly / Vercel / VPS) and either edit this constant or set the endpoint from the
// console's config field (stored in localStorage). Empty = ask the user to set it.
const OSINT_API_BASE = '';

// The 6 functional Ecuador sources exposed by openquery.
// `kind` drives which input each source expects: cedula (10), ruc (13), or both.
const SOURCES = [
  { id: 'ec.sri_ruc',            icon: 'fa-id-card',         kind: 'both',
    name: es ? 'SRI — RUC / Cédula'        : 'SRI — RUC / ID' },
  { id: 'ec.funcion_judicial',   icon: 'fa-gavel',           kind: 'cedula',
    name: es ? 'Función Judicial'          : 'Judicial Records' },
  { id: 'ec.supercias',          icon: 'fa-building',        kind: 'ruc',
    name: es ? 'Supercias — Compañías'     : 'Supercias — Companies' },
  { id: 'ec.senescyt',           icon: 'fa-graduation-cap',  kind: 'cedula',
    name: es ? 'SENESCYT — Títulos'        : 'SENESCYT — Degrees' },
  { id: 'ec.ant_citaciones',     icon: 'fa-car',             kind: 'cedula',
    name: es ? 'ANT — Multas'              : 'ANT — Fines' },
  { id: 'ec.sri_establecimientos', icon: 'fa-store',         kind: 'ruc',
    name: es ? 'SRI — Establecimientos'    : 'SRI — Establishments' },
];

const tools = [
  {
    icon: 'fa-id-card',
    title: es ? 'Cédula ↔ Nombre' : 'ID ↔ Name',
    desc: es
      ? 'Consulta datos asociados a una cédula ecuatoriana o busca cédula por nombre completo.'
      : 'Query data associated with an Ecuadorian national ID or search by full name.',
    endpoint: 'GET /api/v1/cedula/{numero}',
    endpoint2: 'GET /api/v1/nombre/{apellido}/{nombre}',
    src: 'SRI (Servicio de Rentas Internas)',
    srcUrl: 'https://srienlinea.sri.gob.ec',
  },
  {
    icon: 'fa-car',
    title: 'ANT — ' + (es ? 'Vehículos y Multas' : 'Vehicles & Fines'),
    desc: es
      ? 'Consulta datos de vehículos, citaciones y multas de tránsito por placa o cédula.'
      : 'Query vehicle data, traffic citations and fines by license plate or ID.',
    endpoint: 'GET /api/v1/ant/placa/{placa}',
    endpoint2: 'GET /api/v1/ant/cedula/{cedula}',
    src: 'ANT (Agencia Nacional de Tránsito)',
    srcUrl: 'https://www.ant.gob.ec',
  },
  {
    icon: 'fa-gavel',
    title: es ? 'Función Judicial' : 'Judicial Records',
    desc: es
      ? 'Causas judiciales, procesos activos y sentencias asociadas a una cédula.'
      : 'Court cases, active proceedings and sentences associated with an ID.',
    endpoint: 'GET /api/v1/judicial/{cedula}',
    src: es ? 'Función Judicial del Ecuador' : 'Ecuador Judicial Branch',
    srcUrl: 'https://procesosjudiciales.funcionjudicial.gob.ec',
  },
  {
    icon: 'fa-building',
    title: 'Supercias — ' + (es ? 'Compañías' : 'Companies'),
    desc: es
      ? 'Información de compañías y estados financieros registrados en la Supercias.'
      : 'Company information and financial statements registered with Supercias.',
    endpoint: 'GET /api/v1/supercias/{ruc}',
    src: 'Supercias',
    srcUrl: 'https://www.supercias.gob.ec',
  },
  {
    icon: 'fa-graduation-cap',
    title: 'SENESCYT — ' + (es ? 'Títulos' : 'Degrees'),
    desc: es
      ? 'Títulos profesionales y grados académicos registrados por cédula.'
      : 'Professional degrees and academic titles registered by ID.',
    endpoint: 'GET /api/v1/senescyt/{cedula}',
    src: 'SENESCYT',
    srcUrl: 'https://www.senescyt.gob.ec',
  },
  {
    icon: 'fa-check-circle',
    title: es ? 'Validadores' : 'Validators',
    desc: es
      ? 'Valida cédula (algoritmo módulo 10) y placas vehiculares.'
      : 'Validate IDs (modulus 10 algorithm) and vehicle plates.',
    endpoint: 'GET /api/v1/validar/cedula/{numero}',
    endpoint2: 'GET /api/v1/validar/placa/{placa}',
    src: es ? 'Algoritmo propio' : 'Custom algorithm',
    srcUrl: '',
  },
];

const externals = [
  {
    icon: 'fa-user-magnifying-glass',
    title: 'WhatsMyName',
    url: 'https://whatsmyname.app/',
    desc: es ? 'Busca usuarios por username en cientos de plataformas.' : 'Search usernames across hundreds of platforms.',
  },
  {
    icon: 'fa-envelope',
    title: 'Reacher',
    url: 'https://reacher.email/',
    desc: es ? 'Verifica si un email existe sin enviar correo.' : 'Check if an email exists without sending mail.',
  },
  {
    icon: 'fa-shield-halved',
    title: 'Have I Been Pwned',
    url: 'https://haveibeenpwned.com/',
    desc: es ? 'Consulta si tu email apareció en brechas de datos.' : 'Check if your email appears in data breaches.',
  },
  {
    icon: 'fa-database',
    title: 'DeHashed',
    url: 'https://dehashed.com/',
    desc: es ? 'Motor de búsqueda de brechas de seguridad.' : 'Data breach search engine.',
  },
  {
    icon: 'fa-magnifying-glass',
    title: 'GHunt',
    url: 'https://github.com/mxrch/GHunt',
    desc: es ? 'OSINT para cuentas Google.' : 'OSINT for Google accounts.',
  },
  {
    icon: 'fa-users',
    title: 'Sherlock',
    url: 'https://github.com/sherlock-project/sherlock',
    desc: es ? 'Busca username en redes sociales.' : 'Find usernames across social networks.',
  },
  {
    icon: 'fa-sitemap',
    title: 'theHarvester',
    url: 'https://github.com/laramies/theHarvester',
    desc: es ? 'Recolecta emails, subdominios y IPs.' : 'Gather emails, subdomains, and IPs.',
  },
  {
    icon: 'fa-globe',
    title: 'OSINT Framework',
    url: 'https://osintframework.com/',
    desc: es ? 'Mapa de herramientas OSINT organizadas por categoría.' : 'OSINT tool map organized by category.',
  },
];
---

<BaseLayout title={`OSINT | ${t('nav.osint')}`}>
<div class="osint-page">

  <section class="osint-hero">
    <div class="osint-hero-inner">
      <div class="osint-title-block">
        <p class="osint-overtitle">// OPEN SOURCE INTELLIGENCE //</p>
        <h1 class="osint-title glitch" data-text="OSINT ECUADOR">OSINT ECUADOR</h1>
        <p class="osint-tagline">
          {es
            ? 'Recolección de información de fuentes abiertas. Enfocado en datos públicos del Ecuador y herramientas globales de inteligencia.'
            : 'Open-source intelligence gathering. Focused on Ecuador\'s public data and global intelligence tools.'}
        </p>
        <div class="osint-badges">
          <span class="osint-badge blue"><i class="fas fa-flag-ecuador"></i> ECUADOR</span>
          <span class="osint-badge red"><i class="fas fa-database"></i> API REST</span>
          <span class="osint-badge green"><i class="fas fa-lock-open"></i> {es ? 'FUENTES PÚBLICAS' : 'PUBLIC SOURCES'}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ LIVE QUERY CONSOLE ═══════════════════════════ -->
  <section class="osint-section reveal" id="consulta">
    <h2 class="osint-section-title">
      <i class="fas fa-magnifying-glass-chart"></i>
      {es ? 'CONSULTA UNIVERSAL — ECUADOR' : 'UNIVERSAL QUERY — ECUADOR'}
    </h2>

    <div class="console-shell" data-api-base={OSINT_API_BASE}>
      <form class="console-form" id="osint-form" autocomplete="off" novalidate>
        <div class="console-input-row">
          <label class="console-field">
            <span class="console-label">{es ? 'Cédula (10) o RUC (13)' : 'ID (10) or RUC (13)'}</span>
            <input
              id="osint-doc"
              type="text"
              inputmode="numeric"
              maxlength="13"
              pattern="[0-9]{10,13}"
              placeholder="1790016919001"
              aria-label={es ? 'Número de cédula o RUC' : 'ID or RUC number'}
              required
            />
          </label>
          <button type="submit" class="console-run" id="osint-run">
            <i class="fas fa-play"></i>
            <span>{es ? 'Consultar' : 'Query'}</span>
          </button>
        </div>

        <div class="console-meta">
          <button type="button" class="console-config-toggle" id="osint-config-toggle" aria-expanded="false">
            <i class="fas fa-gear"></i> {es ? 'Endpoint de la API' : 'API endpoint'}
          </button>
          <span class="console-endpoint-state" id="osint-endpoint-state"></span>
        </div>

        <div class="console-config" id="osint-config" hidden>
          <label class="console-field">
            <span class="console-label">{es ? 'URL base de openquery' : 'openquery base URL'}</span>
            <input id="osint-api-base" type="url" placeholder="https://tu-openquery.onrender.com" />
          </label>
          <label class="console-field">
            <span class="console-label">{es ? 'API key (opcional)' : 'API key (optional)'}</span>
            <input id="osint-api-key" type="password" placeholder="OPENQUERY_API_KEY" autocomplete="off" />
          </label>
          <button type="button" class="console-save" id="osint-config-save">
            <i class="fas fa-floppy-disk"></i> {es ? 'Guardar' : 'Save'}
          </button>
          <p class="console-config-hint">
            {es
              ? 'Despliega `openquery serve` (Render/Railway/Fly/VPS) y pega aquí su URL. Se guarda solo en tu navegador.'
              : 'Deploy `openquery serve` (Render/Railway/Fly/VPS) and paste its URL here. Stored only in your browser.'}
          </p>
        </div>
      </form>

      <p class="console-hint" id="osint-hint">
        {es
          ? 'Introduce una cédula o RUC y pulsa Consultar: se lanzan en paralelo las 6 fuentes públicas del Ecuador.'
          : 'Enter an ID or RUC and hit Query: all 6 Ecuadorian public sources run in parallel.'}
      </p>

      <div class="results-grid" id="osint-results">
        {SOURCES.map((s) => (
          <article class="result-card" data-source={s.id} data-kind={s.kind} data-status="idle">
            <header class="result-head">
              <i class={`fas ${s.icon} result-ico`}></i>
              <h3>{s.name}</h3>
              <span class="result-badge">
                <i class="fas fa-circle status-dot"></i>
                <span class="status-text">{es ? 'En espera' : 'Idle'}</span>
              </span>
            </header>
            <code class="result-source">{s.id}</code>
            <div class="result-body" aria-live="polite"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="osint-section reveal">
    <h2 class="osint-section-title">
      <i class="fas fa-terminal"></i>
      {es ? 'ARQUITECTURA DEL SISTEMA' : 'SYSTEM ARCHITECTURE'}
    </h2>
    <div class="api-block">
      <div class="api-terminal">
        <div class="term-bar">
          <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
          <span class="term-title">ec-osint.service</span>
        </div>
        <div class="term-body">
          <p class="term-line"><span class="term-prompt">$</span> openquery serve --host 0.0.0.0 --port 8000</p>
          <p class="term-out">
            {es
              ? 'Motor openquery: 562 fuentes en 21 países, 6 funcionales para Ecuador. Resuelve CAPTCHA (PaddleOCR), evade WAF, cachea y aplica rate-limit. Esta web estática consume su API REST; el navegador nunca toca las fuentes .gob.ec directamente.'
              : 'openquery engine: 562 sources across 21 countries, 6 functional for Ecuador. Solves CAPTCHA (PaddleOCR), bypasses WAF, caches, and rate-limits. This static site consumes its REST API; the browser never touches the .gob.ec sources directly.'}
          </p>
          <div class="api-flow">
            <div class="flow-node">
              <i class="fas fa-globe flow-ico blue"></i>
              <span>{es ? 'Web estática' : 'Static site'}</span>
            </div>
            <div class="flow-arrow">→</div>
            <div class="flow-node">
              <i class="fas fa-server flow-ico red"></i>
              <span>openquery API</span>
            </div>
            <div class="flow-arrow">→</div>
            <div class="flow-node">
              <i class="fas fa-shield-halved flow-ico green"></i>
              <span>{es ? 'CAPTCHA · WAF · Cache' : 'CAPTCHA · WAF · Cache'}</span>
            </div>
            <div class="flow-arrow">→</div>
            <div class="flow-node">
              <i class="fas fa-building flow-ico gold"></i>
              <span>SRI · ANT · Judicial · Supercias · SENESCYT</span>
            </div>
          </div>
          <blockquote class="term-quote">
            <i class="fas fa-circle-info quote-icon"></i>
            {es
              ? 'La consulta requiere un backend openquery corriendo (Render/Railway/Fly/VPS). Configura su URL en la consola de arriba; se guarda solo en tu navegador.'
              : 'Querying requires a running openquery backend (Render/Railway/Fly/VPS). Set its URL in the console above; it is stored only in your browser.'}
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="osint-section reveal">
    <h2 class="osint-section-title">
      <i class="fas fa-plug"></i>
      {es ? 'END POINTS DE LA API' : 'API ENDPOINTS'}
    </h2>
    <div class="endpoints-grid">
      {tools.map((tool) => (
        <article class="endpoint-card">
          <div class="endpoint-header">
            <i class={`fas ${tool.icon} endpoint-ico`}></i>
            <h3>{tool.title}</h3>
          </div>
          <p class="endpoint-desc">{tool.desc}</p>
          <div class="endpoint-code">
            <span class="code-method">GET</span>
            <span class="code-path">{tool.endpoint}</span>
          </div>
          {tool.endpoint2 && (
            <div class="endpoint-code">
              <span class="code-method">GET</span>
              <span class="code-path">{tool.endpoint2}</span>
            </div>
          )}
          <div class="endpoint-src">
            <i class="fas fa-link"></i>
            <a href={tool.srcUrl} target="_blank" rel="noopener noreferrer">{tool.src}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="osint-section reveal">
    <h2 class="osint-section-title">
      <i class="fas fa-toolbox"></i>
      {es ? 'HERRAMIENTAS OSINT GLOBALES' : 'GLOBAL OSINT TOOLS'}
    </h2>
    <div class="externals-grid">
      {externals.map((ext) => (
        <a href={ext.url} target="_blank" rel="noopener noreferrer" class="external-card">
          <div class="external-ico-wrap">
            <i class={`fas ${ext.icon}`}></i>
          </div>
          <div class="external-body">
            <h4>{ext.title}</h4>
            <p>{ext.desc}</p>
          </div>
          <i class="fas fa-external-link-alt external-link-icon"></i>
        </a>
      ))}
    </div>
  </section>

  <section class="osint-section reveal">
    <h2 class="osint-section-title">
      <i class="fas fa-rocket"></i>
      {es ? 'DESPLIEGUE DEL BACKEND' : 'BACKEND DEPLOYMENT'}
    </h2>

    <div class="deploy-grid">
      <div class="deploy-card">
        <div class="deploy-card-header">
          <i class="fas fa-cloud-upload-alt deploy-card-ico"></i>
          <h3>Render</h3>
        </div>
        <div class="deploy-card-body">
          <p>{es
            ? 'Sube el repo a GitHub. En Render crea un Web Service con:'
            : 'Push the repo to GitHub. On Render create a Web Service with:'}</p>
          <div class="deploy-code">
            <span class="deploy-label">{es ? 'Build:' : 'Build:'}</span>
            <code>pip install -r requirements.txt</code>
          </div>
          <div class="deploy-code">
            <span class="deploy-label">{es ? 'Start:' : 'Start:'}</span>
            <code>gunicorn app:app</code>
          </div>
        </div>
      </div>

      <div class="deploy-card">
        <div class="deploy-card-header">
          <i class="fas fa-train deploy-card-ico"></i>
          <h3>Railway</h3>
        </div>
        <div class="deploy-card-body">
          <p>{es
            ? 'Conecta tu repo. Railway detecta Python automáticamente. Sin configuración adicional.'
            : 'Connect your repo. Railway auto-detects Python. No additional config needed.'}</p>
        </div>
      </div>

      <div class="deploy-card">
        <div class="deploy-card-header">
          <i class="fas fa-server deploy-card-ico"></i>
          <h3>{es ? 'VPS Propio' : 'Self-hosted VPS'}</h3>
        </div>
        <div class="deploy-card-body">
          <div class="deploy-code">
            <code>pip install -r requirements.txt<br/>gunicorn app:app -b 0.0.0.0:5000</code>
          </div>
        </div>
      </div>

      <div class="deploy-card">
        <div class="deploy-card-header">
          <i class="fas fa-bolt deploy-card-ico"></i>
          <h3>Vercel Serverless</h3>
        </div>
        <div class="deploy-card-body">
          <p>{es
            ? 'Convierte app.py a función serverless con vercel.json.'
            : 'Convert app.py to a serverless function with vercel.json.'}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="osint-section reveal">
    <div class="recruit-box">
      <div class="recruit-corner tl"></div>
      <div class="recruit-corner tr"></div>
      <div class="recruit-corner bl"></div>
      <div class="recruit-corner br"></div>

      <p class="recruit-label">// SOURCE_CODE //</p>
      <h2 class="recruit-title">
        {es ? '¿QUIERES EL CÓDIGO?' : 'WANT THE CODE?'}
      </h2>
      <p class="recruit-text">
        {es
          ? 'El backend Flask completo, los conectores a fuentes de datos y el frontend están disponibles en el repositorio. Incluye instrucciones de deploy para Render, Railway o VPS propio.'
          : 'The complete Flask backend, data source connectors, and frontend are available in the repository. Includes deploy instructions for Render, Railway, or self-hosted VPS.'}
      </p>
      <div class="recruit-code">
        <code>git clone https://github.com/mrflippermen/ec-OSINT</code>
      </div>
      <a href="https://github.com/mrflippermen/ec-OSINT" target="_blank" rel="noopener noreferrer" class="recruit-btn">
        <i class="fab fa-github"></i>
        {es ? 'VER EN GITHUB' : 'VIEW ON GITHUB'}
      </a>
    </div>
  </section>

</div>

<script is:inline define:vars={{ OSINT_API_BASE, SOURCES, lang }}>
  (function () {
    const T = lang === 'es'
      ? { idle: 'En espera', loading: 'Consultando…', ok: 'OK', empty: 'Sin datos', err: 'Error',
          noApi: 'Configura el endpoint de openquery (icono ⚙) para ejecutar consultas.',
          badDoc: 'Introduce una cédula (10 dígitos) o RUC (13 dígitos) válidos.',
          saved: 'Endpoint guardado', notSet: 'Sin endpoint configurado',
          using: 'Usando', latency: 'ms', cached: 'caché', skip: 'No aplica a esta fuente' }
      : { idle: 'Idle', loading: 'Querying…', ok: 'OK', empty: 'No data', err: 'Error',
          noApi: 'Set the openquery endpoint (⚙ icon) to run queries.',
          badDoc: 'Enter a valid ID (10 digits) or RUC (13 digits).',
          saved: 'Endpoint saved', notSet: 'No endpoint set',
          using: 'Using', latency: 'ms', cached: 'cached', skip: 'Not applicable to this source' };

    const LS_BASE = 'osint.apiBase';
    const LS_KEY  = 'osint.apiKey';

    const shell     = document.querySelector('.console-shell');
    if (!shell) return;
    const form      = document.getElementById('osint-form');
    const docInput  = document.getElementById('osint-doc');
    const runBtn     = document.getElementById('osint-run');
    const hint      = document.getElementById('osint-hint');
    const stateEl   = document.getElementById('osint-endpoint-state');
    const cfgToggle = document.getElementById('osint-config-toggle');
    const cfg       = document.getElementById('osint-config');
    const baseInput = document.getElementById('osint-api-base');
    const keyInput  = document.getElementById('osint-api-key');
    const saveBtn   = document.getElementById('osint-config-save');
    const cards     = Array.from(document.querySelectorAll('.result-card'));

    const getBase = () => (localStorage.getItem(LS_BASE) || OSINT_API_BASE || '').replace(/\/+$/, '');
    const getKey  = () => localStorage.getItem(LS_KEY) || '';

    function reflectEndpoint() {
      const base = getBase();
      stateEl.textContent = base ? `${T.using} ${base}` : T.notSet;
      stateEl.classList.toggle('is-set', !!base);
      baseInput.value = base;
      keyInput.value = getKey();
    }

    cfgToggle.addEventListener('click', () => {
      const open = cfg.hasAttribute('hidden');
      if (open) cfg.removeAttribute('hidden'); else cfg.setAttribute('hidden', '');
      cfgToggle.setAttribute('aria-expanded', String(open));
    });

    saveBtn.addEventListener('click', () => {
      const b = baseInput.value.trim().replace(/\/+$/, '');
      const k = keyInput.value.trim();
      if (b) localStorage.setItem(LS_BASE, b); else localStorage.removeItem(LS_BASE);
      if (k) localStorage.setItem(LS_KEY, k); else localStorage.removeItem(LS_KEY);
      reflectEndpoint();
      hint.textContent = T.saved + (b ? ` → ${b}` : '');
    });

    // Normalize the document number for a given source kind.
    function docFor(kind, raw) {
      const v = raw.replace(/\D/g, '');
      if (kind === 'ruc') {
        if (v.length === 13) return v;
        if (v.length === 10) return v + '001'; // natural person RUC = cédula + 001
        return null;
      }
      if (kind === 'cedula') return v.length >= 10 ? v.slice(0, 10) : null;
      return v; // both
    }

    function setStatus(card, status, text) {
      card.dataset.status = status;
      const st = card.querySelector('.status-text');
      if (st) st.textContent = text;
    }

    function renderData(card, data) {
      const body = card.querySelector('.result-body');
      body.innerHTML = '';
      if (data == null || (typeof data === 'object' && Object.keys(data).length === 0)) {
        body.innerHTML = `<p class="result-empty">${T.empty}</p>`;
        return false;
      }
      const dl = document.createElement('dl');
      dl.className = 'kv';
      const flat = flatten(data);
      const keys = Object.keys(flat).slice(0, 12);
      for (const k of keys) {
        const dt = document.createElement('dt'); dt.textContent = k;
        const dd = document.createElement('dd'); dd.textContent = String(flat[k]);
        dl.append(dt, dd);
      }
      body.appendChild(dl);
      return true;
    }

    // Flatten one level of nested objects/arrays into "a.b" keys for compact display.
    function flatten(obj, prefix = '', out = {}) {
      if (Array.isArray(obj)) {
        obj.slice(0, 6).forEach((v, i) => flatten(v, prefix ? `${prefix}[${i}]` : `[${i}]`, out));
      } else if (obj && typeof obj === 'object') {
        for (const [k, v] of Object.entries(obj)) {
          const key = prefix ? `${prefix}.${k}` : k;
          if (v && typeof v === 'object') flatten(v, key, out);
          else out[key] = v;
        }
      } else if (prefix) {
        out[prefix] = obj;
      }
      return out;
    }

    async function queryOne(card, base, key, rawDoc, signal) {
      const source = card.dataset.source;
      const kind   = card.dataset.kind;
      const doc = docFor(kind, rawDoc);
      const body = card.querySelector('.result-body');
      if (!doc) { setStatus(card, 'skip', T.skip); body.innerHTML = ''; return; }

      setStatus(card, 'loading', T.loading);
      body.innerHTML = '';
      const started = performance.now();
      try {
        const headers = { 'Content-Type': 'application/json' };
        if (key) { headers['Authorization'] = `Bearer ${key}`; headers['X-API-Key'] = key; }
        const res = await fetch(`${base}/api/v1/query`, {
          method: 'POST', headers, signal,
          body: JSON.stringify({ source, document_type: 'custom', document_number: doc }),
        });
        const ms = Math.round(performance.now() - started);
        if (!res.ok) {
          setStatus(card, 'err', `${T.err} ${res.status}`);
          body.innerHTML = `<p class="result-empty">HTTP ${res.status}</p>`;
          return;
        }
        const json = await res.json();
        const hasData = renderData(card, json.data ?? json);
        const meta = [`${json.latency_ms ?? ms} ${T.latency}`];
        if (json.cached) meta.push(T.cached);
        setStatus(card, hasData ? 'ok' : 'empty', `${hasData ? T.ok : T.empty} · ${meta.join(' · ')}`);
      } catch (e) {
        if (e.name === 'AbortError') return;
        setStatus(card, 'err', T.err);
        body.innerHTML = `<p class="result-empty">${e.message || 'fetch failed'}</p>`;
      }
    }

    let inFlight = null;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const base = getBase();
      const raw = docInput.value.trim();
      const digits = raw.replace(/\D/g, '');
      if (!base) { hint.textContent = T.noApi; cfg.removeAttribute('hidden'); cfgToggle.setAttribute('aria-expanded', 'true'); return; }
      if (digits.length !== 10 && digits.length !== 13) { hint.textContent = T.badDoc; return; }

      if (inFlight) inFlight.abort();
      inFlight = new AbortController();
      hint.textContent = '';
      runBtn.disabled = true;
      cards.forEach((c) => { setStatus(c, 'idle', T.idle); c.querySelector('.result-body').innerHTML = ''; });
      await Promise.all(cards.map((c) => queryOne(c, base, getKey(), digits, inFlight.signal)));
      runBtn.disabled = false;
    });

    reflectEndpoint();
  })();
</script>
</BaseLayout>

