---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AwardCard from '../../../components/AwardCard.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    {params: {lang: 'en'}},
    {params: {lang: 'es'}},
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allCerts = await getCollection('certs');
// Sort by date descending (newest first)
allCerts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<BaseLayout title={`Credentials Vault | ${t('nav.certs')}`}>
  <div class="vault-container">
    
    <div class="vault-header">
      <h1 class="vault-title"><i class="fas fa-lock-open"></i> CREDENTIALS VAULT ({lang.toUpperCase()})</h1>
      <p class="vault-subtitle">
        {lang === 'es' ? 'Certificaciones Oficiales & Laboratorios Avanzados' : 'Official Certifications & Advanced Laboratories'}
      </p>
      <div class="vault-meta">
        <span>{lang === 'es' ? 'TOTAL ACTIVOS' : 'TOTAL ASSETS'}: {allCerts.length}</span>
        <span>{lang === 'es' ? 'ACCESO' : 'CLEARANCE'}: TOP_SECRET</span>
      </div>
    </div>
    
    <div class="vault-grid">
      {allCerts.map((cert) => (
        <AwardCard
          title={cert.data.title}
          subtitle={`${cert.data.platform} | ${cert.data.level}`}
          image={cert.data.image}
          link={`/${lang}/certs/${cert.slug}`}
        >
          <div class="tags-container">
            {cert.data.tags && cert.data.tags.map(tag => (
              <span class="cert-tag">{tag}</span>
            ))}
          </div>
        </AwardCard>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .vault-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1rem;
    font-family: var(--font-sans);
  }

  /* HEADER */
  .vault-header {
    text-align: center;
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .vault-title {
    font-size: 2.5rem;
    color: var(--text-primary);
    margin: 0;
    font-weight: 800;
    letter-spacing: -1px;
    font-family: 'Share Tech Mono', monospace;
  }
  
  .vault-title i { color: var(--success-color, #10B981); margin-right: 0.5rem; }

  .vault-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin: 0.5rem 0 1.5rem 0;
    font-family: var(--font-mono);
  }

  .vault-meta {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--success-color, #10B981);
    display: flex;
    justify-content: center;
    gap: 2rem;
    background: rgba(16, 185, 129, 0.05); /* Emerald tint */
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  /* GRID */
  .vault-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  /* TAGS */
  .tags-container {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cert-tag {
    display: inline-block;
    background: var(--bg-main);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    transition: all 0.3s;
  }
  
  .cert-tag:hover {
    border-color: var(--success-color, #10B981);
    color: var(--text-primary);
  }
</style>
