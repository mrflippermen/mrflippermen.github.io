---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const allWriteups = await getCollection('writeups');
  // Sort by date descending for prev/next navigation
  allWriteups.sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return allWriteups.flatMap((entry, idx) => {
    const prev = allWriteups[idx + 1] ?? null;
    const next = allWriteups[idx - 1] ?? null;
    return [
      { params: { lang: 'en', slug: entry.slug }, props: { entry, prev, next } },
      { params: { lang: 'es', slug: entry.slug }, props: { entry, prev, next } },
    ];
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const es = lang === 'es';

const platform  = (entry.data.platform  || 'OTHER').toUpperCase();
const diff      = (entry.data.difficulty || '').toLowerCase();
const dateStr   = entry.data.date
  ? new Date(entry.data.date).toLocaleDateString(es ? 'es-EC' : 'en-US', {
      year: 'numeric', month: 'long', day: 'numeric'
    })
  : '—';

const diffColors: Record<string, string> = {
  easy:   '#10B981',
  medium: '#F59E0B',
  hard:   '#D90429',
  insane: '#9333EA',
};
const diffColor = diffColors[diff] || '#555';

const platformColors: Record<string, string> = {
  HTB: '#9FEF00',
  CTF: '#00F0FF',
  FLUID: '#FF6B35',
  CWL: '#F59E0B',
  VULNHUB: '#F59E0B',
  TRYHACKME: '#E8405A',
};
const platformColor = platformColors[platform] || '#AAAAAA';
---

<BaseLayout
  title={`${entry.data.title} | Flippermen`}
  description={entry.data.description || entry.data.excerpt || entry.data.title}
  type="article"
>
  <div class="writeup-shell">

    <!-- ── BREADCRUMB ── -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>
        <i class="fas fa-home"></i>
      </a>
      <span class="bc-sep">›</span>
      <a href={`/${lang}/writeups`}>{t('nav.writeups')}</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">{entry.data.title}</span>
    </nav>

    <!-- ── ARTICLE HEADER ── -->
    <header class="report-header">
      {entry.data.image && (
        <div class="report-cover">
          <img src={entry.data.image} alt={entry.data.title} />
          <div class="cover-overlay"></div>
        </div>
      )}

      <div class="report-meta-bar">
        <div class="meta-left">
          <p class="report-label">// CLASSIFIED OPERATION REPORT //</p>
          <h1 class="report-title">{entry.data.title}</h1>

          {entry.data.description && (
            <p class="report-description">{entry.data.description}</p>
          )}

          <!-- Metadata chips -->
          <div class="meta-chips">
            <span class="chip chip-platform" style={`color: ${platformColor}; border-color: ${platformColor};`}>
              <i class="fas fa-server"></i> {platform}
            </span>
            {diff && (
              <span class="chip chip-diff" style={`color: ${diffColor}; border-color: ${diffColor};`}>
                <i class="fas fa-signal"></i> {diff.toUpperCase()}
              </span>
            )}
            <span class="chip">
              <i class="fas fa-calendar-alt"></i> {dateStr}
            </span>
          </div>

          <!-- Tags -->
          {entry.data.tags && entry.data.tags.length > 0 && (
            <div class="tag-strip">
              {entry.data.tags.map((tag: string) => (
                <span class="rtag">#{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- ── DISCLAIMER ── -->
    <div class="disclaimer-bar">
      <i class="fas fa-shield-alt"></i>
      <span>{t('writeup.disclaimer')}</span>
    </div>

    <!-- ── CONTENT ── -->
    <article class="prose-container">
      <div class="prose">
        <Content />
      </div>
    </article>

    <!-- ── PREV / NEXT NAV ── -->
    <nav class="post-nav" aria-label="Post navigation">
      {prev ? (
        <a href={`/${lang}/writeups/${prev.slug}`} class="post-nav-link prev-link">
          <span class="nav-dir"><i class="fas fa-arrow-left"></i> {t('writeup.prev')}</span>
          <span class="nav-title">{prev.data.title}</span>
        </a>
      ) : <div></div>}

      <a href={`/${lang}/writeups`} class="post-nav-center">
        <i class="fas fa-th-list"></i>
        <span>{t('writeup.back')}</span>
      </a>

      {next ? (
        <a href={`/${lang}/writeups/${next.slug}`} class="post-nav-link next-link">
          <span class="nav-dir">{t('writeup.next')} <i class="fas fa-arrow-right"></i></span>
          <span class="nav-title">{next.data.title}</span>
        </a>
      ) : <div></div>}
    </nav>

  </div>
</BaseLayout>

<style>
/* ══════════════════════════════════════════
   WRITEUP SHELL
══════════════════════════════════════════ */
.writeup-shell {
  max-width: 900px;
  margin: 0 auto;
  padding: 1.5rem 1.5rem 5rem;
}

/* ── Breadcrumb ── */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-muted);
  letter-spacing: 1px;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
.breadcrumb a {
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.2s;
}
.breadcrumb a:hover { color: var(--blue-team); text-shadow: none; }
.bc-sep { opacity: 0.4; }
.bc-current {
  color: var(--text-secondary);
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Report Header ── */
.report-header {
  margin-bottom: 2rem;
  position: relative;
  border: 1px solid var(--border-color);
  background: var(--bg-panel);
  overflow: hidden;
}

.report-cover {
  position: relative;
  height: 200px;
  overflow: hidden;
}
.report-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(50%) brightness(0.6);
}
.cover-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 30%, var(--bg-panel));
}

.report-meta-bar {
  padding: 2rem;
}

.report-label {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--red-team);
  letter-spacing: 3px;
  opacity: 0.7;
  margin-bottom: 0.75rem;
}

.report-title {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 4vw, 2.4rem);
  font-weight: 400;
  color: var(--text-primary);
  letter-spacing: -0.5px;
  line-height: 1.2;
  margin-bottom: 0.75rem;
}

.report-description {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 1.25rem;
  border-left: 2px solid var(--border-bright);
  padding-left: 1rem;
}

/* Meta chips */
.meta-chips {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 0.25rem 0.65rem;
  border: 1px solid var(--border-color);
  color: var(--text-muted);
}
.chip i { font-size: 0.7rem; }

/* Tag strip */
.tag-strip {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}
.rtag {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--text-muted);
  background: rgba(255,255,255,0.025);
  border: 1px solid var(--border-color);
  padding: 0.1rem 0.4rem;
  letter-spacing: 0.5px;
}

/* ── Disclaimer ── */
.disclaimer-bar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-muted);
  letter-spacing: 1px;
  border: 1px solid rgba(217, 4, 41, 0.4);
  background: rgba(217, 4, 41, 0.05);
  padding: 0.65rem 1rem;
  margin-bottom: 2rem;
}
.disclaimer-bar i { color: var(--red-team); opacity: 0.7; }

/* ══════════════════════════════════════════
   PROSE
══════════════════════════════════════════ */
.prose-container {
  border: 1px solid var(--border-color);
  background: var(--bg-panel);
  padding: 2rem 2.5rem;
  margin-bottom: 2rem;
}

.prose {
  font-family: var(--font-sans);
  color: var(--text-secondary);
  line-height: 1.85;
  font-size: 0.95rem;
}

/* Headings */
.prose :global(h1),
.prose :global(h2),
.prose :global(h3),
.prose :global(h4) {
  font-family: var(--font-display);
  color: var(--text-primary);
  font-weight: 400;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin: 2rem 0 1rem;
  padding-bottom: 0.5rem;
  position: relative;
}

.prose :global(h1) {
  font-size: 1.6rem;
  border-bottom: 1px solid var(--border-color);
}
.prose :global(h2) {
  font-size: 1.3rem;
  border-bottom: 1px solid var(--border-color);
}
.prose :global(h2)::before { content: '// '; color: var(--red-team); }
.prose :global(h3) {
  font-size: 1.05rem;
  color: var(--blue-team);
}
.prose :global(h3)::before { content: '> '; color: var(--blue-team); opacity: 0.6; }

/* Code blocks — shiki replaces pre/code */
.prose :global(pre) {
  background: #0d0d0d !important;
  padding: 1.25rem 1.5rem !important;
  border: 1px solid rgba(0, 240, 255, 0.18) !important;
  border-radius: 0 !important;
  overflow-x: auto;
  margin: 1.25rem 0;
  position: relative;
}

.prose :global(code) {
  font-family: var(--font-mono) !important;
  font-size: 0.85rem !important;
}

/* Inline code */
.prose :global(p code),
.prose :global(li code) {
  background: rgba(0, 240, 255, 0.07);
  border: 1px solid rgba(0, 240, 255, 0.15);
  padding: 0.1rem 0.4rem;
  color: var(--blue-team);
  font-size: 0.82rem !important;
}

/* Tables */
.prose :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin: 1.5rem 0;
  font-family: var(--font-mono);
  font-size: 0.82rem;
}
.prose :global(th) {
  background: rgba(0,0,0,0.4);
  color: var(--text-primary);
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 0.6rem 1rem;
  border: 1px solid var(--border-color);
  text-align: left;
}
.prose :global(td) {
  padding: 0.5rem 1rem;
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}
.prose :global(tr:nth-child(even) td) {
  background: rgba(255,255,255,0.015);
}

/* Blockquotes */
.prose :global(blockquote) {
  border: 1px solid rgba(217, 4, 41, 0.4);
  background: rgba(217, 4, 41, 0.05);
  margin: 1.5rem 0;
  padding: 0.75rem 1.25rem;
  color: var(--text-secondary);
}
.prose :global(blockquote p) { margin: 0; }

/* Links */
.prose :global(a) {
  color: var(--blue-team);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: rgba(0, 240, 255, 0.3);
  transition: text-decoration-color 0.2s;
}
.prose :global(a:hover) {
  color: var(--red-team);
  text-decoration-color: rgba(217, 4, 41, 0.5);
  text-shadow: none;
}

/* Lists */
.prose :global(ul),
.prose :global(ol) {
  margin: 0.75rem 0;
  padding-left: 1.5rem;
}
.prose :global(li) {
  margin-bottom: 0.4rem;
  color: var(--text-secondary);
}
.prose :global(ul li::before) {
  content: '>>';
  color: var(--red-team) !important;
}

/* Horizontal rule */
.prose :global(hr) {
  border: none;
  border-top: 1px solid var(--border-color);
  margin: 2rem 0;
}

/* Images */
.prose :global(img) {
  max-width: 100%;
  border: 1px solid var(--border-color);
  display: block;
  margin: 1rem auto;
}

/* Badges (shields.io) */
.prose :global(div[align="center"]) {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  margin: 1.5rem 0;
}

/* ══════════════════════════════════════════
   PREV / NEXT NAVIGATION
══════════════════════════════════════════ */
.post-nav {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 1px;
  background: var(--border-color);
  border: 1px solid var(--border-color);
}

.post-nav-link {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 1rem 1.25rem;
  background: var(--bg-panel);
  text-decoration: none;
  transition: background 0.2s;
}
.post-nav-link:hover { background: rgba(0,240,255,0.03); }

.next-link { text-align: right; }

.nav-dir {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--blue-team);
  letter-spacing: 2px;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.next-link .nav-dir { justify-content: flex-end; }

.nav-title {
  font-family: var(--font-sans);
  font-size: 0.82rem;
  color: var(--text-secondary);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-nav-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  padding: 1rem;
  background: var(--bg-panel);
  text-decoration: none;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--text-muted);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  white-space: nowrap;
  transition: background 0.2s, color 0.2s;
  min-width: 100px;
  text-align: center;
  border-left: 1px solid var(--border-color);
  border-right: 1px solid var(--border-color);
}
.post-nav-center i { font-size: 1rem; margin-bottom: 0.2rem; }
.post-nav-center:hover { background: rgba(255,255,255,0.02); color: var(--text-secondary); }

/* ── Responsive ── */
@media (max-width: 768px) {
  .writeup-shell { padding: 1rem 1rem 4rem; }
  .prose-container { padding: 1.25rem; }
  .report-meta-bar { padding: 1.25rem; }
  .post-nav {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
  }
  .next-link { text-align: left; }
  .next-link .nav-dir { justify-content: flex-start; }
  .post-nav-center {
    border-left: none;
    border-right: none;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    flex-direction: row;
    min-width: auto;
    padding: 0.75rem 1.25rem;
    gap: 0.5rem;
  }
  .post-nav-center i { margin-bottom: 0; }
}

@media (max-width: 480px) {
  .bc-current { max-width: 180px; }
}
</style>
