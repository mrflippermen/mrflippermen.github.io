---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);
const es   = lang === 'es';

import ProfileHeader        from '../../components/about/ProfileHeader.astro';
import AchievementsGrid     from '../../components/about/AchievementsGrid.astro';
import ProjectsSection      from '../../components/about/ProjectsSection.astro';
import SkillsMatrix         from '../../components/about/SkillsMatrix.astro';
import CertificationsShowcase from '../../components/about/CertificationsShowcase.astro';
---

<BaseLayout title={`Esteban Jimenez | ${t('nav.about')}`}>
  <div class="cv-container">

    <!-- ── Profile Dossier ── -->
    <ProfileHeader />

    <!-- ── Achievements ── -->
    <div class="reveal">
      <AchievementsGrid />
    </div>

    <!-- ── Professional Trajectory ── -->
    <section class="cv-section reveal">
      <h2 class="section-title">
        <i class="fas fa-briefcase"></i>
        {es ? 'Trayectoria Profesional' : 'Professional Trajectory'}
      </h2>

      <div class="timeline-list">

        <div class="timeline-item">
          <span class="period">2023 — {es ? 'Presente' : 'Present'}</span>
          <h3>{es ? 'Pentester & Operador Red Team' : 'Pentester & Red Team Operator'}</h3>
          <span class="institution">HackerOne · Freelance</span>
          <p>{es
            ? 'Simulaciones de ataque real y evasión de defensas corporativas. Foco en infraestructura crítica, Active Directory y OT/ICS. Desarrollo de implantes personalizados y técnicas de evasión de EDR.'
            : 'Real-world attack simulations and corporate defense evasion. Focus on critical infrastructure, Active Directory, and OT/ICS. Custom implant development and EDR evasion techniques.'
          }</p>
        </div>

        <div class="timeline-item">
          <span class="period">2024 — 2025</span>
          <h3>{es ? 'Arquitecto de CTF & Speaker' : 'CTF Architect & Speaker'}</h3>
          <span class="institution">Hackron · Cybercamp · Pwn Or Die</span>
          <p>{es
            ? 'Diseño de escenarios Full-Spectrum con impacto real. Ponente sobre Flipper Zero Ops, Forense Digital y Pwn/Exploitation ante audiencias técnicas internacionales.'
            : 'Full-Spectrum scenario design with real-world impact. Speaker on Flipper Zero Ops, Digital Forensics, and Pwn/Exploitation for international technical audiences.'
          }</p>
        </div>

        <div class="timeline-item">
          <span class="period">2023 — {es ? 'Presente' : 'Present'}</span>
          <h3>{es ? 'Ayudante de Cátedra' : 'Teaching Assistant'}</h3>
          <span class="institution">UDLA Ecuador</span>
          <p>{es
            ? 'Mentoría técnica en laboratorios de explotación y defensa. Formación de la siguiente generación de analistas de seguridad en Ecuador.'
            : 'Technical mentorship in exploitation and defense labs. Training the next generation of security analysts in Ecuador.'
          }</p>
        </div>

      </div>
    </section>

    <!-- ── Skills Matrix ── -->
    <div class="reveal">
      <SkillsMatrix />
    </div>

    <!-- ── Projects ── -->
    <div class="reveal">
      <ProjectsSection />
    </div>

    <!-- ── Certifications ── -->
    <div class="reveal">
      <CertificationsShowcase />
    </div>

  </div>
</BaseLayout>

<style>
.cv-container {
  max-width: 1050px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
}

.timeline-list {
  display: flex;
  flex-direction: column;
}
</style>
