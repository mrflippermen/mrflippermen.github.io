---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);
const es   = lang === 'es';

import ProfileHeader        from '../../components/about/ProfileHeader.astro';
import AchievementsGrid     from '../../components/about/AchievementsGrid.astro';
import ProjectsSection      from '../../components/about/ProjectsSection.astro';
import SkillsMatrix         from '../../components/about/SkillsMatrix.astro';
import CertificationsShowcase from '../../components/about/CertificationsShowcase.astro';
---

<BaseLayout title={`Esteban Jimenez | ${t('nav.about')}`}>
  <div class="cv-container">

    <!-- ── Profile Dossier ── -->
    <ProfileHeader />

    <!-- ── Achievements ── -->
    <div class="reveal">
      <AchievementsGrid />
    </div>

    <!-- ── Professional Trajectory ── -->
    <section class="cv-section reveal">
      <h2 class="section-title">
        <i class="fas fa-briefcase"></i>
        {es ? 'Trayectoria Profesional' : 'Professional Trajectory'}
      </h2>

      <div class="timeline-list">

        <!-- Telefónica ── CURRENT POSITION -->
        <div class="timeline-item current">
          <span class="period">
            2025 — <span class="live-badge"><i class="fas fa-circle"></i> {es ? 'EN CURSO' : 'ACTIVE'}</span>
          </span>
          <h3>
            {es ? 'Analista de Seguridad Ofensiva' : 'Offensive Security Analyst'}
            <span class="pending-tag">{es ? '▸ PENTESTER DESIGNADO' : '▸ PENTESTER TRACK'}</span>
          </h3>
          <span class="institution">Telefónica Ecuador <span class="institution-note">{es ? '(en integración a' : '(transitioning to'} Millicom · Tigo Ecuador)</span></span>
          <p>{es
            ? 'Embedded en el equipo de Ciberseguridad Corporativa realizando evaluaciones de amenazas activas, análisis de superficie de ataque y ejercicios de adversario sobre infraestructura de telecomunicaciones crítica. Validación de controles de seguridad, revisión de arquitecturas de red y soporte en respuesta a incidentes. Posición de alta visibilidad con designación confirmada a rol de Penetration Tester interno al completar las horas de certificación académica.'
            : 'Embedded within the Corporate Cybersecurity team conducting active threat assessments, attack surface analysis, and adversary exercises against critical telecommunications infrastructure. Security control validation, network architecture review, and incident response support. High-visibility position with confirmed designation to internal Penetration Tester role upon academic certification completion.'
          }</p>
        </div>

        <div class="timeline-item">
          <span class="period">2023 — {es ? 'Presente' : 'Present'}</span>
          <h3>{es ? 'Pentester & Operador Red Team' : 'Pentester & Red Team Operator'}</h3>
          <span class="institution">HackerOne · Freelance</span>
          <p>{es
            ? 'Simulaciones de ataque real y evasión de defensas corporativas. Foco en infraestructura crítica, Active Directory y OT/ICS. Desarrollo de implantes personalizados y técnicas de evasión de EDR.'
            : 'Real-world attack simulations and corporate defense evasion. Focus on critical infrastructure, Active Directory, and OT/ICS. Custom implant development and EDR evasion techniques.'
          }</p>
        </div>

        <div class="timeline-item">
          <span class="period">2024 — 2025</span>
          <h3>{es ? 'Arquitecto de CTF & Speaker' : 'CTF Architect & Speaker'}</h3>
          <span class="institution">Hackron · Cybercamp · Pwn Or Die</span>
          <p>{es
            ? 'Diseño de escenarios Full-Spectrum con impacto real. Ponente sobre Flipper Zero Ops, Forense Digital y Pwn/Exploitation ante audiencias técnicas internacionales.'
            : 'Full-Spectrum scenario design with real-world impact. Speaker on Flipper Zero Ops, Digital Forensics, and Pwn/Exploitation for international technical audiences.'
          }</p>
        </div>

        <div class="timeline-item">
          <span class="period">2023 — {es ? 'Presente' : 'Present'}</span>
          <h3>{es ? 'Ayudante de Cátedra' : 'Teaching Assistant'}</h3>
          <span class="institution">UDLA Ecuador</span>
          <p>{es
            ? 'Mentoría técnica en laboratorios de explotación y defensa. Formación de la siguiente generación de analistas de seguridad en Ecuador.'
            : 'Technical mentorship in exploitation and defense labs. Training the next generation of security analysts in Ecuador.'
          }</p>
        </div>

      </div>
    </section>

    <!-- ── Skills Matrix ── -->
    <div class="reveal">
      <SkillsMatrix />
    </div>

    <!-- ── Projects ── -->
    <div class="reveal">
      <ProjectsSection />
    </div>

    <!-- ── Certifications ── -->
    <div class="reveal">
      <CertificationsShowcase />
    </div>

  </div>
</BaseLayout>

<style>
.cv-container {
  max-width: 1050px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
}

.timeline-list {
  display: flex;
  flex-direction: column;
}

/* Current position highlight */
:global(.timeline-item.current) {
  border-left-color: var(--blue-team) !important;
  background: rgba(0, 240, 255, 0.025) !important;
}

:global(.timeline-item.current h3) {
  color: var(--text-primary);
}

:global(.live-badge) {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--success-color);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 1.5px;
  animation: live-pulse 2s ease-in-out infinite;
}

:global(.live-badge i) {
  font-size: 0.5rem;
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.4; }
}

:global(.pending-tag) {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: var(--blue-team);
  letter-spacing: 1px;
  border: 1px solid rgba(0, 240, 255, 0.3);
  padding: 0.1rem 0.4rem;
  margin-left: 0.6rem;
  vertical-align: middle;
  white-space: nowrap;
}

:global(.institution-note) {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-left: 0.3rem;
}
</style>
