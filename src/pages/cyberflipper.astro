---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CyberFlipper Initiative | FlipperMen">
  <div class="fob-container">
    
    <!-- HEADER SECTION -->
    <section class="fob-header fade-in-up">
      <div class="header-content">
        <div class="hero-image-container">
            <img src="/images/cyberflipper_hero.png" alt="CyberFlipper Emblem" class="team-emblem" width="250" height="250" />
        </div>
        
        <div class="title-block">
          <h1 class="stamped-title">CYBERFLIPPERS</h1>
          <div class="unit-designation">SPECIAL OPERATIONS UNIT - ECUADOR</div>
        </div>

        <p class="mission-brief">
          "Operamos en las sombras para servir a la luz. Ofensiva de élite, defensa estratégica."
        </p>
      </div>
    </section>

    <!-- STATS GRID -->
    <section class="achievements-section fade-in-up">
      <h3 class="section-label">UNIT_STATISTICS</h3>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="label">OPERATIVES</div>
          <div class="number">10</div>
          <div class="sub-label">ACTIVE DUTY</div>
        </div>
        <div class="stat-card">
          <div class="label">CONFIRMED KILLS</div>
          <div class="number">136</div>
          <div class="sub-label">FLAGS CAPTURED</div>
        </div>
        <div class="stat-card">
          <div class="label">AFFILIATION</div>
          <div class="number">INDIE</div>
          <div class="sub-label">AUTONOMOUS CELL</div>
        </div>
      </div>
    </section>

    <!-- ROSTER -->
    <section class="roster-section fade-in-up">
      <div class="section-header-row">
        <h2 class="section-title">ACTIVE_ROSTER</h2>
        <div class="status-indicator">
          <span class="status-dot"></span> OPERATIONAL
        </div>
      </div>
      
      <div class="roster-grid">
        <!-- CAPTAIN -->
        <div class="operator-card captain">
          <div class="card-header">
            <span class="role">UNIT COMMANDER</span>
            <span class="rank">O-5</span>
          </div>
          <div class="op-name">flippermen</div>
          <div class="op-stats">
            <div><span class="stat-label">SKILL:</span> FULL STACK</div>
          </div>
        </div>

        <!-- MEMBERS -->
        {["ANGELDUSTx", "MarcGMN1403", "KomiGath", "ch1l1", "crrlla", "AdrianX", "DiegoJr", "0s0bit", "N01syb0y"].map((op) => (
          <div class="operator-card">
            <div class="card-header">
              <span class="role">OPERATOR</span>
              <span class="rank">E-4</span>
            </div>
            <div class="op-name">{op}</div>
            <div class="op-stats">
              <div><span class="stat-label">STATUS:</span> ACTIVE</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- INTERNATIONAL REPRESENTATION -->
    <section class="representation-section fade-in-up">
      <h2 class="section-title">GLOBAL_DEPLOYMENTS</h2>
      
      <div class="achievements-list">
        <div class="achievement-item gold-tier">
          <div class="achievement-header">
            <span class="flag">🥇</span>
            <span class="event">LACC 2025 - COLOMBIA</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">4TH PLACE REGIONAL</span> <br/> TEAM ECUADOR CAPTAIN
          </div>
        </div>

        <div class="achievement-item blue-tier">
          <div class="achievement-header">
            <span class="flag">🛡️</span>
            <span class="event">HOLMES CTF 2025</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">BEST LATAM BLUE TEAM</span> <br/> GLOBAL RANK 66
          </div>
        </div>

        <div class="achievement-item gold-tier">
          <div class="achievement-header">
            <span class="flag">🏆</span>
            <span class="event">HACK THE BOX</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">#1 ECUADOR</span> <br/> TOP 50 HALL OF FAME
          </div>
        </div>
      </div>
    </section>

    <!-- RECRUITMENT -->
    <section class="recruitment-section fade-in-up">
      <div class="recruit-frame">
        <h2 class="recruit-title">ENLISTMENT_PROTOCOL</h2>
        <p class="recruit-text">
          We do not seek certificates. We seek <strong>obsession</strong>.
        </p>
        
        <div class="action-buttons">
          <a href="/contact" class="cta-btn primary">
            CONTACT COMMAND
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Local Scoped Styles */
  .fob-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1rem;
    font-family: 'Inter', sans-serif;
    color: #eee;
  }

  /* HEADER */
  .fob-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hero-image-container img {
    margin: 0 auto 1.5rem;
    display: block;
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 0 15px rgba(0,0,0,0.5));
  }

  .stamped-title {
    font-size: 3rem;
    font-weight: 900;
    margin: 0;
    color: #fff;
    letter-spacing: -1px;
    text-transform: uppercase;
  }

  .unit-designation {
    color: var(--gold);
    font-family: monospace;
    letter-spacing: 2px;
    font-size: 0.9rem;
    margin-top: 0.5rem;
    font-weight: bold;
  }

  .mission-brief {
    max-width: 600px;
    margin: 1.5rem auto 0;
    font-size: 1.1rem;
    color: #aaa;
    font-style: italic;
  }

  /* STATS */
  .section-label {
    text-align: center;
    font-family: monospace;
    color: #666;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .stat-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid #333;
    padding: 1.5rem;
    text-align: center;
    border-radius: 4px;
  }

  .stat-card .label { font-size: 0.8rem; color: #888; font-family: monospace; }
  .stat-card .number { font-size: 2rem; font-weight: bold; color: #fff; margin: 0.5rem 0; }
  .stat-card .sub-label { font-size: 0.7rem; color: var(--gold); }

  /* ROSTER */
  .roster-section { margin-bottom: 4rem; }
  
  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
  }

  .section-title { font-size: 1.5rem; font-weight: 800; color: #fff; margin: 0; }
  
  .status-indicator { 
    color: var(--neon-green); 
    font-family: monospace; 
    font-size: 0.8rem; 
    display: flex; 
    align-items: center; 
    gap: 0.5rem; 
  }
  
  .status-dot { width: 8px; height: 8px; background: var(--neon-green); border-radius: 50%; }

  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .operator-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid #333;
    padding: 1rem;
    border-radius: 4px;
  }

  .operator-card.captain { border-color: var(--gold); background: rgba(255, 215, 0, 0.05); }

  .card-header { display: flex; justify-content: space-between; font-size: 0.7rem; color: #666; font-family: monospace; margin-bottom: 0.5rem; }
  .op-name { font-weight: bold; color: #fff; font-size: 1.1rem; }
  .op-stats { font-size: 0.7rem; color: #888; margin-top: 0.5rem; font-family: monospace; }

  /* REPRESENTATION */
  .representation-section { margin-bottom: 4rem; }
  
  .achievements-list { display: flex; flex-direction: column; gap: 1rem; }
  
  .achievement-item {
    background: rgba(255,255,255,0.03);
    border: 1px solid #333;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .achievement-header { display: flex; align-items: center; gap: 1rem; font-weight: bold; color: #fff; }
  .achievement-details { text-align: right; font-size: 0.9rem; color: #aaa; font-family: monospace; }
  .highlight { color: #fff; font-weight: bold; }
  
  .gold-tier { border-left: 3px solid var(--gold); }
  .blue-tier { border-left: 3px solid var(--color-blue-steel); }

  /* RECRUITMENT */
  .recruitment-section { text-align: center; padding: 2rem; background: rgba(11, 17, 32, 0.5); border: 1px solid #333; }
  .recruit-title { color: #fff; font-size: 1.5rem; margin-bottom: 1rem; }
  .recruit-text { color: #aaa; margin-bottom: 1.5rem; }
  
  .cta-btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    background: var(--gold);
    color: #000;
    font-weight: bold;
    text-decoration: none;
    border-radius: 4px;
  }
  
  .cta-btn:hover { background: #fff; }

  @media (max-width: 768px) {
    .achievement-item { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .achievement-details { text-align: left; }
  }
</style>
