---
import BaseLayout from '../layouts/BaseLayout.astro';
import AwardCard from '../components/AwardCard.astro';
---

<BaseLayout title="CyberFlipper Initiative | FlipperMen">
  <div class="fob-container">
    
    <!-- HEADER SECTION -->
    <section class="fob-header fade-in-up">
      <div class="terminal-badge">
        <span class="pulse">●</span> LIVE OPERATION
      </div>
      <div class="hero-image-container">
        <img src="/images/cyberflipper_hero.png" alt="CyberFlipper Emblem" class="team-emblem" />
      </div>
      <h1 class="glitch" data-text="CYBERFLIPPERS">CYBERFLIPPERS</h1>
      <p class="mission-brief">
        "Vivimos para el Rojo, protegemos en Azul. 'Flipeamos' el sistema y capturamos la bandera."
      </p>
    </section>

    <!-- STATS GRID -->
    <section class="achievements-section fade-in-up">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="icon">👥</div>
          <div class="number">10</div>
          <div class="label">PLAYERS<br>ACTIVE OPERATORS</div>
        </div>
        <div class="stat-card">
          <div class="icon">🚩</div>
          <div class="number">136</div>
          <div class="label">FLAGS PWND<br>TOTAL CAPTURES</div>
        </div>
        <div class="stat-card">
          <div class="icon">🌎</div>
          <div class="number">UDLA</div>
          <div class="label">ORIGIN<br>FICA - CIBERSEGURIDAD</div>
        </div>
      </div>
    </section>

    <!-- ABOUT / PHILOSOPHY -->
    <section class="manifesto-section fade-in-up">
      <div class="terminal-window">
        <div class="terminal-bar">
          <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
          <span class="title">identity.log</span>
        </div>
        <div class="terminal-content">
          <p>> <span class="cmd">whoami</span></p>
          <p>Somos <strong>CYBERFLIPPERS</strong>.</p>
          <p>Somos un colectivo de apasionados, curiosos y breakers de sistemas que representan con orgullo a Ecuador. La ciberseguridad no es solo nuestra carrera; es el desafío que nos impulsa a ser más rápidos, más listos y a pensar diferente.</p>
          <br>
          <p>> <span class="cmd">cat philosophy.txt</span></p>
          <p>Nuestro nombre es nuestra mentalidad. Somos "Flippers":</p>
          <ul class="terminal-list">
            <li>🐬 <strong>Como el delfín:</strong> Ágiles, inteligentes y capaces de navegar aguas profundas.</li>
            <li>🔄 <strong>Como el acto:</strong> "Flipeamos" el sistema, le damos la vuelta al problema, encontramos el bit que lo cambia todo.</li>
          </ul>
          <br>
          <p class="section-header">>> VIVIR EN ROJO (RED TEAM)</p>
          <p>Nos apasiona la caza. Disfrutamos la elegancia de un exploit bien hecho, la emoción de encontrar un vector impensado y la satisfacción de ver saltar esa shell. Romper es un arte.</p>
          <br>
          <p class="section-header">>> PROTEGER EN AZUL (BLUE TEAM)</p>
          <p>Un verdadero maestro sabe construir. Defendemos con la misma intensidad, levantando muros, analizando logs como poesía y cazando al cazador. Construimos fortalezas.</p>
          <br>
          <p class="section-header">>> ORIGIN: UDLA</p>
          <p>Nuestra historia no empieza en un garaje, sino en los pasillos y laboratorios de la <strong>Universidad de las Américas (UDLA)</strong>, Facultad de Ingeniería y Ciencias Aplicadas (FICA). Nuestra fuerza viene de entender los fundamentos.</p>
          <br>
          <p class="highlight-text">"Rompemos. Defendemos. Aprendemos."</p>
          <p class="cursor">_</p>
        </div>
      </div>
    </section>

    <!-- ROSTER / PERSONNEL -->
    <section class="roster-section fade-in-up">
      <h2 class="section-title">>> ACTIVE_ROSTER</h2>
      <div class="mission-status-bar">
        <span class="status-icon blink">⚠️</span>
        <span class="status-text">CURRENT_OBJECTIVE: PREPARING FOR BRAZIL OPERATION</span>
      </div>
      
      <div class="roster-grid">
        <!-- CAPTAIN -->
        <div class="operator-card captain">
          <div class="op-role">CAPTAIN</div>
          <div class="op-name">flippermen</div>
          <div class="op-stats">
            <span>LVL: 4</span> | <span>🏁 59075</span> | <span>💀 136</span>
          </div>
        </div>

        <!-- MEMBERS -->
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">ANGELDUSTx</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">MarcGMN1403</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">KomiGath</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">ch1l1</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">crrlla</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">AdrianX</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">DiegoJr</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">0s0bit</div></div>
        <div class="operator-card member"><div class="op-role">OPERATOR</div><div class="op-name">N01syb0y</div></div>
      </div>
    </section>

    <!-- PAST EVENTS -->
    <section class="events-section fade-in-up">
      <h2 class="section-title">>> PAST_OPERATIONS</h2>
      <div class="events-list">
        
        <div class="event-row">
          <div class="event-name">Holmes CTF 2025</div>
          <div class="event-rank rank-high">RANK 66</div>
        </div>

        <div class="event-row">
          <div class="event-name">Cyber Apocalypse CTF 2025: Tales from Eldoria</div>
          <div class="event-rank">RANK 114</div>
        </div>

        <div class="event-row">
          <div class="event-name">Neurogrid CTF: Human-Only</div>
          <div class="event-rank">RANK 497</div>
        </div>
        
        <div class="event-row">
          <div class="event-name">Hack The Boo 2025</div>
          <div class="event-rank">RANK 1072</div>
        </div>

      </div>
    </section>

    <style>
      /* Additional Styles for New Content */
      .terminal-list { list-style: none; padding-left: 1rem; margin: 1rem 0; }
      .terminal-list li { margin-bottom: 0.5rem; }
      .section-header { color: var(--neon-cyan); font-weight: bold; margin-top: 1.5rem; border-bottom: 1px dashed #444; display: inline-block; }
      .highlight-text { color: #fff; font-size: 1.1rem; text-align: center; margin-top: 2rem; border: 1px solid var(--neon-red); padding: 1rem; }
      
      .events-list { display: flex; flex-direction: column; gap: 1rem; max-width: 800px; margin: 0 auto; }
      .event-row { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 1rem; background: rgba(255,255,255,0.05); border-left: 3px solid #444;
        font-family: 'Courier New', monospace;
      }
      .event-row:hover { border-left-color: var(--neon-blue); background: rgba(255,255,255,0.08); }
      .event-name { font-weight: bold; color: #eee; }
      .event-rank { color: #aaa; }
      .event-rank.rank-high { color: var(--neon-green); text-shadow: 0 0 5px rgba(39, 201, 63, 0.5); }

      /* ROSTER STYLES */
      .mission-status-bar {
        background: rgba(255, 189, 46, 0.1);
        border: 1px solid #ffbd2e;
        color: #ffbd2e;
        padding: 0.5rem 1rem;
        margin-bottom: 2rem;
        font-family: 'Courier New', monospace;
        font-weight: bold;
        display: inline-block;
        border-radius: 4px;
      }
      .blink { animation: blink 1s infinite; }

      .roster-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.5rem;
      }

      .operator-card {
        background: rgba(10, 10, 10, 0.6);
        border: 1px solid #333;
        padding: 1.5rem;
        border-radius: 6px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s;
      }

      .operator-card:hover {
        border-color: var(--neon-cyan);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 243, 255, 0.1);
      }

      .operator-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 4px; height: 100%;
        background: #333;
        transition: 0.3s;
      }

      .operator-card:hover::before { background: var(--neon-cyan); }

      .operator-card.captain { border-color: var(--neon-purple); background: rgba(189, 0, 255, 0.05); }
      .operator-card.captain::before { background: var(--neon-purple); }

      .op-role { font-size: 0.7rem; color: #666; letter-spacing: 2px; margin-bottom: 0.5rem; font-family: 'Courier New', monospace; }
      .captain .op-role { color: var(--neon-purple); font-weight: bold; }
      
      .op-name { font-size: 1.2rem; font-weight: bold; color: #fff; }
      .op-stats { font-size: 0.8rem; color: #888; margin-top: 0.5rem; font-family: monospace; }
    </style>

    <!-- RECRUITMENT CALL TO ACTION -->
    <section class="recruitment-section fade-in-up">
      <h2 class="section-title">>> JOIN_THE_CELL</h2>
      <p class="recruit-text">
        No buscamos expertos. Buscamos <strong>obsesión</strong>.
        Si tienes la curiosidad para desarmar el mundo y la ética para volver a armarlo mejor, tu lugar está con nosotros.
      </p>
      
      <div class="action-buttons">
        <a href="https://forms.typeform.com/to/example" target="_blank" class="cta-btn primary">
          <span class="icon">⚡</span> INICIAR POSTULACIÓN
        </a>
        <a href="/contact" class="cta-btn secondary">
          <span class="icon">📡</span> CONTACTAR LÍDER
        </a>
      </div>
      
      <p class="disclaimer">
        * El proceso de selección es riguroso. Prepárate.
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  /* VARIABLES LOCALES */
  :root {
    --neon-purple: #bd00ff;
    --neon-cyan: #00f3ff;
  }

  .fob-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 1rem;
    font-family: 'Inter', sans-serif;
    color: var(--color-text);
  }

  /* HEADER */
  .fob-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .terminal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 0, 0, 0.1);
    border: 1px solid var(--neon-red);
    color: var(--neon-red);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
    letter-spacing: 1px;
  }

  .pulse { animation: pulse 1.5s infinite; }
  @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

  h1.glitch {
    font-size: 4rem;
    font-weight: 900;
    margin: 0;
    color: #fff;
    letter-spacing: -2px;
    text-shadow: 2px 2px 0px var(--neon-purple), -2px -2px 0px var(--neon-blue);
  }

  .subtitle {
    font-size: 1.25rem;
    font-family: 'Courier New', monospace;
    color: #888;
    margin-top: 1rem;
  }

  .highlight { color: var(--neon-cyan); text-shadow: 0 0 10px rgba(0, 243, 255, 0.5); }

  .hero-image-container {
    margin: 2rem 0;
    display: flex;
    justify-content: center;
  }
  
  .team-emblem {
    max-width: 300px;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 20px rgba(0, 243, 255, 0.3));
    animation: float 6s ease-in-out infinite;
  }
  
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  .mission-brief {
    max-width: 700px;
    margin: 2rem auto 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #ccc;
  }

  /* ACHIEVEMENTS */
  .achievements-section { margin-bottom: 6rem; }
  
  .section-title {
    font-family: 'Courier New', monospace;
    color: var(--neon-green);
    font-size: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .stat-card {
    background: rgba(10, 10, 10, 0.5);
    border: 1px solid #333;
    padding: 2rem;
    text-align: center;
    border-radius: 8px;
    transition: transform 0.3s, border-color 0.3s;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    border-color: var(--neon-blue);
  }

  .stat-card .icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .stat-card .number { font-size: 2.5rem; font-weight: 900; color: #fff; margin-bottom: 0.5rem; }
  .stat-card .label { font-size: 0.9rem; color: #888; font-family: 'Courier New', monospace; letter-spacing: 1px; }

  /* MANIFESTO TERMINAL */
  .manifesto-section { margin-bottom: 6rem; }

  .terminal-window {
    background: #050505;
    border: 1px solid #444;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .terminal-bar {
    background: #222;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }
  .title { margin-left: auto; margin-right: auto; font-family: monospace; color: #888; font-size: 0.8rem; }

  .terminal-content {
    padding: 2rem;
    font-family: 'Courier New', monospace;
    color: #ddd;
    line-height: 1.6;
  }

  .cmd { color: var(--neon-green); }
  .cursor { animation: blink 1s infinite; color: var(--neon-green); font-weight: bold; }

  /* RECRUITMENT */
  .recruitment-section { text-align: center; padding: 4rem 2rem; background: linear-gradient(180deg, transparent, rgba(0, 243, 255, 0.05)); border-radius: 16px; border: 1px solid #222; }

  .recruit-text {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 4px;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.3s;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cta-btn.primary {
    background: var(--neon-blue);
    color: #000;
    box-shadow: 0 0 20px rgba(0, 86, 179, 0.4);
  }

  .cta-btn.primary:hover {
    transform: scale(1.05);
    background: #fff;
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.5);
  }

  .cta-btn.secondary {
    border: 1px solid #555;
    color: #fff;
  }

  .cta-btn.secondary:hover {
    border-color: #fff;
    background: rgba(255,255,255,0.1);
  }

  .disclaimer { margin-top: 2rem; color: #555; font-size: 0.8rem; font-style: italic; }

  /* LIGHT MODE OVERRIDES */
  :global(body.light-mode) .stat-card { background: #fff; border-color: #ccc; }
  :global(body.light-mode) .stat-card .number { color: #000; }
  :global(body.light-mode) .terminal-window { box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
  :global(body.light-mode) h1.glitch { color: #000; text-shadow: 2px 2px 0px rgba(189, 0, 255, 0.2); }
  :global(body.light-mode) .mission-brief { color: #444; }

</style>
