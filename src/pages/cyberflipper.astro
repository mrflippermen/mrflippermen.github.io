---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CyberFlipper Initiative | FlipperMen">
  <div class="fob-container">
    
    <!-- HEADER SECTION -->
    <section class="fob-header fade-in-up">
      <div class="classification-banner">
        <span>// TOP SECRET // NOFORN // 2026</span>
      </div>
      
      <div class="header-content">
        <div class="hero-image-container">
            <img src="/images/cyberflipper_hero.png" alt="CyberFlipper Emblem" class="team-emblem" />
        </div>
        
        <div class="title-block">
          <h1 class="stamped-title">CYBERFLIPPERS</h1>
          <div class="unit-designation">SPECIAL OPERATIONS UNIT - ECUADOR</div>
        </div>

        <p class="mission-brief">
          "Operamos en las sombras para servir a la luz. Ofensiva de élite, defensa estratégica."
        </p>
      </div>
    </section>

    <!-- STATS GRID ("INTEL REPORT") -->
    <section class="achievements-section fade-in-up">
      <div class="section-label">UNIT_STATISTICS</div>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="label">OPERATIVES</div>
          <div class="number">10</div>
          <div class="sub-label">ACTIVE DUTY</div>
        </div>
        <div class="stat-card">
          <div class="label">CONFIRMED KILLS</div>
          <div class="number">136</div>
          <div class="sub-label">FLAGS CAPTURED</div>
        </div>
        <div class="stat-card">
          <div class="label">AFFILIATION</div>
          <div class="number">INDIE</div>
          <div class="sub-label">AUTONOMOUS CELL</div>
        </div>
      </div>
    </section>

    <!-- MISSION STATEMENT ("DOSSIER") -->
    <section class="manifesto-section fade-in-up">
      <div class="dossier-file">
        <div class="dossier-tab">MISSION_PROFILE.TXT</div>
        <div class="dossier-content">
          <div class="dossier-header">
            <span class="stamp">CLASSIFIED</span>
            <span class="date">EST. 2023</span>
          </div>
          
          <h3 class="dossier-title">IDENTITY // WHOAMI</h3>
          <p>
            <strong>CYBERFLIPPERS</strong> es la fuerza de vanguardia en ciberseguridad ofensiva de Ecuador. 
            Nacidos en las aulas, forjados en el fuego de CTFs internacionales.
          </p>

          <div class="dossier-grid">
            <div class="dossier-col">
              <h4>>> RED TEAM DOCTRINE</h4>
              <p>La intrusión es un arte. Explotamos vulnerabilidades para erradicarlas. Sigilo, precisión e impacto máximo.</p>
            </div>
            <div class="dossier-col">
              <h4>>> BLUE TEAM DOCTRINE</h4>
              <p>La defensa es nuestra fortaleza. Monitoreo constante, respuesta a incidentes y fortificación de infraestructura crítica.</p>
            </div>
          </div>

          <div class="dossier-quote">
            "We break to build. We hack to protect. We represent Ecuador."
          </div>
        </div>
      </div>
    </section>

    <!-- ROSTER / PERSONNEL -->
    <section class="roster-section fade-in-up">
      <div class="section-header-row">
        <h2 class="section-title">ACTIVE_ROSTER</h2>
        <div class="status-indicator">
          <span class="status-dot"></span> OPERATIONAL
        </div>
      </div>
      
      <div class="roster-grid">
        <!-- CAPTAIN -->
        <div class="operator-card captain">
          <div class="card-header">
            <span class="role">UNIT COMMANDER</span>
            <span class="rank">O-5</span>
          </div>
          <div class="op-name">flippermen</div>
          <div class="op-stats">
            <div><span class="stat-label">SKILL:</span> FULL STACK</div>
            <div><span class="stat-label">EXP:</span> ELITE</div>
          </div>
        </div>

        <!-- MEMBERS -->
        {["ANGELDUSTx", "MarcGMN1403", "KomiGath", "ch1l1", "crrlla", "AdrianX", "DiegoJr", "0s0bit", "N01syb0y"].map((op) => (
          <div class="operator-card">
            <div class="card-header">
              <span class="role">OPERATOR</span>
              <span class="rank">E-4</span>
            </div>
            <div class="op-name">{op}</div>
            <div class="op-stats">
              <div><span class="stat-label">STATUS:</span> ACTIVE</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- INTERNATIONAL REPRESENTATION -->
    <section class="representation-section fade-in-up">
      <h2 class="section-title">GLOBAL_DEPLOYMENTS</h2>
      
      <div class="achievements-list">
        <div class="achievement-item gold-tier">
          <div class="achievement-header">
            <span class="flag">🥇</span>
            <span class="event">LACC 2025 - COLOMBIA</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">4TH PLACE REGIONAL</span> // TEAM ECUADOR CAPTAIN
          </div>
        </div>

        <div class="achievement-item blue-tier">
          <div class="achievement-header">
            <span class="flag">🛡️</span>
            <span class="event">HOLMES CTF 2025</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">BEST LATAM BLUE TEAM</span> // GLOBAL RANK 66
          </div>
        </div>

        <div class="achievement-item gold-tier">
          <div class="achievement-header">
            <span class="flag">🏆</span>
            <span class="event">HACK THE BOX</span>
          </div>
          <div class="achievement-details">
            <span class="highlight">#1 ECUADOR</span> // TOP 50 HALL OF FAME
          </div>
        </div>
      </div>

      <div class="vision-box">
        <h4>>> STRATEGIC VISION: NATIONAL CTF LEAGUE</h4>
        <p>
          Mobilizing talent from 11+ universities. Unifying the national cybersecurity front.
        </p>
      </div>
    </section>

    <!-- RECRUITMENT -->
    <section class="recruitment-section fade-in-up">
      <div class="recruit-frame">
        <h2 class="recruit-title">ENLISTMENT_PROTOCOL</h2>
        <p class="recruit-text">
          We do not seek certificates. We seek <strong>obsession</strong>.
          If you have the discipline to master the machine, report for duty.
        </p>
        
        <div class="action-buttons">
          <a href="https://forms.typeform.com/to/example" target="_blank" class="cta-btn primary">
            INITIATE APPLICATION
          </a>
          <a href="/contact" class="cta-btn secondary">
            CONTACT COMMAND
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* --- LOCAL VARIABLES (Scoped to this page) --- */
  .fob-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1rem;
    color: var(--color-text);
  }

  /* --- HEADER --- */
  .fob-header {
    text-align: center;
    margin-bottom: 5rem;
    position: relative;
  }

  .classification-banner {
    display: inline-block;
    background: #000;
    color: var(--crimson);
    border: 1px solid var(--crimson);
    padding: 0.2rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 2px;
    margin-bottom: 2rem;
    font-weight: bold;
  }

  .team-emblem {
    width: 180px;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(0,0,0,0.5)) grayscale(0.2);
    margin-bottom: 1.5rem;
  }

  .stamped-title {
    font-size: 4rem;
    font-weight: 900;
    margin: 0;
    color: var(--color-text);
    letter-spacing: -2px;
    line-height: 1;
    text-transform: uppercase;
  }

  .unit-designation {
    color: var(--gold);
    font-family: var(--font-mono);
    letter-spacing: 3px;
    font-size: 1rem;
    margin-top: 0.5rem;
    font-weight: bold;
  }

  .mission-brief {
    max-width: 700px;
    margin: 2rem auto 0;
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    font-style: italic;
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
  }

  /* --- STATS GRID --- */
  .section-label {
    font-family: var(--font-mono);
    color: var(--slate);
    font-size: 0.8rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    display: inline-block;
    padding-bottom: 0.2rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 5rem;
  }

  .stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    text-align: center;
    border-radius: var(--border-radius-sm);
  }

  .stat-card .label {
    font-size: 0.8rem;
    color: var(--slate);
    font-family: var(--font-mono);
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .stat-card .number {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-text);
  }

  .stat-card .sub-label {
    font-size: 0.7rem;
    color: var(--gold);
    font-weight: bold;
    margin-top: 0.5rem;
  }

  /* --- MANIFESTO DOSSIER --- */
  .manifesto-section { margin-bottom: 5rem; }

  .dossier-file {
    background: #fdfbf7; /* Paper color */
    color: #111; /* Ink color */
    padding: 3rem;
    border: 1px solid #ccc;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transform: rotate(-1deg);
  }
  
  /* Use a pseudo-element for the "paper clip" or folder tab if desired, keeping it simple for now */
  .dossier-tab {
    position: absolute;
    top: -30px;
    left: 0;
    background: #fdfbf7;
    padding: 0.5rem 1.5rem;
    border: 1px solid #ccc;
    border-bottom: none;
    font-family: var(--font-mono);
    font-weight: bold;
    font-size: 0.8rem;
  }

  .dossier-header {
    display: flex;
    justify-content: space-between;
    border-bottom: 2px solid #000;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .stamp {
    border: 2px solid var(--crimson);
    color: var(--crimson);
    padding: 0.2rem 1rem;
    font-weight: 900;
    transform: rotate(-5deg);
    font-size: 1.2rem;
    text-transform: uppercase;
  }

  .dossier-title {
    font-size: 1.5rem;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin: 2rem 0;
  }

  .dossier-col h4 {
    border-bottom: 1px solid #999;
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .dossier-quote {
    text-align: center;
    font-style: italic;
    font-weight: bold;
    padding: 2rem;
    background: rgba(0,0,0,0.05);
    border-left: 4px solid var(--gold);
  }

  /* --- ROSTER --- */
  .roster-section { margin-bottom: 5rem; }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-text);
    margin: 0;
  }

  .status-indicator {
    font-family: var(--font-mono);
    color: var(--neon-green); /* Keep green for "Operational" status */
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--neon-green);
    border-radius: 50%;
    animation: blink 2s infinite;
  }

  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .operator-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 1rem;
    transition: all 0.3s;
  }

  .operator-card:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
  }

  .operator-card.captain {
    border-color: var(--gold);
    background: rgba(255, 215, 0, 0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--slate);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .op-name {
    font-size: 1.1rem;
    font-weight: bold;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .op-stats {
    font-size: 0.7rem;
    color: var(--slate);
    font-family: var(--font-mono);
  }

  .stat-label { color: var(--color-text-tertiary); }

  /* --- REPRESENTATION --- */
  .representation-section { margin-bottom: 5rem; }

  .achievements-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .achievement-item {
    background: var(--color-surface);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .achievement-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-weight: bold;
    color: var(--color-text);
  }

  .achievement-details {
    font-family: var(--font-mono);
    color: var(--slate);
    font-size: 0.9rem;
  }

  .gold-tier { border-left: 3px solid var(--gold); }
  .blue-tier { border-left: 3px solid var(--color-blue-steel); }

  .vision-box {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px dashed var(--slate);
    text-align: center;
  }

  .vision-box h4 {
    color: var(--gold);
    margin: 0 0 0.5rem 0;
    font-family: var(--font-mono);
  }

  /* --- RECRUITMENT --- */
  .recruitment-section {
    text-align: center;
  }

  .recruit-frame {
    border: 4px solid var(--color-surface);
    padding: 3rem;
    background: var(--navy);
  }

  .recruit-title {
    font-size: 2rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .recruit-text {
    max-width: 600px;
    margin: 0 auto 2rem;
    color: var(--slate);
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .cta-btn {
    padding: 1rem 2rem;
    font-weight: bold;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    border-radius: var(--border-radius-sm);
    transition: all 0.3s;
  }

  .cta-btn.primary {
    background: var(--gold);
    color: #000;
  }
  
  .cta-btn.primary:hover {
    background: #fff;
  }

  .cta-btn.secondary {
    border: 1px solid var(--slate);
    color: var(--color-text);
  }

  .cta-btn.secondary:hover {
    border-color: var(--color-text);
  }

  /* --- MOBILE --- */
  @media (max-width: 768px) {
    .stats-grid, .dossier-grid { grid-template-columns: 1fr; }
    .stamped-title { font-size: 2.5rem; }
  }

  @keyframes blink { 50% { opacity: 0; } }
</style>
