---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineItem from '../components/TimelineItem.astro';
import AwardCard from '../components/AwardCard.astro';
import SkillContainer from '../components/SkillContainer.astro';
---

<BaseLayout title="About Me | Flippermen">
  <div class="cv-container">
  
    <div class="cv-header">
      <div style="width: 150px; height: 150px; margin: 0 auto 2rem; border-radius: 50%; overflow: hidden; border: 4px solid var(--color-primary); box-shadow: 0 0 20px rgba(0,255,65,0.3);">
         <img src="/images/about/avatar.jpg" alt="Esteban Jimenez" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
      <h1>Esteban Jimenez</h1>
      <div class="subtitle" style="font-size: 1.2rem; color: var(--color-primary); margin-bottom: 0.5rem; letter-spacing: 1px;">
        Red Team Operator | Senior Cybersecurity Researcher | Exploit Developer
      </div>
      <div style="font-size: 1rem; color: #aaa; margin-bottom: 1rem;">
        Top 1 Ecuador & Global Top 50 (Hack The Box) | Capitán Equipo Nacional LACC 2025
      </div>
      
      <div class="contact-info">
        <span><a href="mailto:tu-email@ejemplo.com"><i class="fas fa-envelope"></i> Email</a></span>
        <span><a href="https://linkedin.com/in/esteban-jimenez-994868249/" target="_blank"><i class="fab fa-linkedin"></i> LinkedIn</a></span>
        <span><a href="https://github.com/mrflippermen" target="_blank"><i class="fab fa-github"></i> GitHub</a></span>
      </div>
      
      <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; align-items: center; color: #888; font-size: 0.9rem;">
        <span style="display: flex; align-items: center; gap: 0.5rem;">
          <i class="fas fa-map-marker-alt" style="color: var(--color-primary);"></i> Loja / Quito, Ecuador (Disponibilidad Global)
        </span>
      </div>

      <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; align-items: center;">
        <span style="background: rgba(255, 255, 255, 0.1); padding: 0.5rem 1rem; border-radius: 50px; border: 1px solid var(--color-border); display: flex; align-items: center; gap: 0.5rem;">
          <img src="https://upload.wikimedia.org/wikipedia/commons/e/e8/Flag_of_Ecuador.svg" alt="Ecuador" style="width: 20px; height: auto;"> Ecuador
        </span>
        <span style="background: rgba(255, 255, 255, 0.1); padding: 0.5rem 1rem; border-radius: 50px; border: 1px solid var(--color-border); display: flex; align-items: center; gap: 0.5rem;">
          <img src="/images/about/Bandera_Provincia_Loja.png" alt="Loja" style="width: 20px; height: auto;"> Loja
        </span>
      </div>

      <div style="margin-top: 3rem; max-width: 800px; margin-left: auto; margin-right: auto; text-align: left;">
        <h3 style="color: var(--color-primary); border-bottom: 2px solid var(--color-primary); display: inline-block; padding-bottom: 0.5rem; margin-bottom: 1.5rem;"><i class="fas fa-user-shield"></i> Perfil Ejecutivo</h3>
        <p style="color: var(--color-text); font-size: 1.05rem; line-height: 1.8;">
          Estratega en ciberseguridad con enfoque en <strong>Simulación de Adversarios (Adversary Emulation)</strong> y operaciones ofensivas de alta complejidad. Actualmente cursando Ingeniería en Ciberseguridad en la UDLA y desempeñándome como Ayudante de Cátedra, he consolidado una trayectoria marcada por la excelencia técnica y el liderazgo en escenarios de alta presión.
          <br><br>
          Me especializo en la <strong>explotación avanzada de infraestructuras corporativas</strong>, con maestría en entornos de Active Directory, evasión de soluciones EDR/XDR y el desarrollo de armamento digital personalizado.
          <br><br>
          <i class="fas fa-quote-left" style="color: var(--color-accent);"></i> <em style="color: #ccc;">"En el mundo de Hack The Box y Parrot OS, cada exploit es una lección; si no puedes explicarlo de forma simple, no lo entiendes lo suficiente."</em>
        </p>
      </div>
    </div>

    <!-- SECCIÓN 1: HITOS Y RECONOCIMIENTOS (MOVIDO ARRIBA) -->
    <div class="cv-section">
      <h2><i class="fas fa-trophy"></i> Hitos y Reconocimientos Globales</h2>
      
      <AwardCard
        title='<i class="fas fa-crown" style="color: gold;"></i> Excelencia en Hack The Box (2025)'
      >
        <img src="/images/about/ranknacional.jpg" alt="Ranking HTB" style="width: 100%; max-width: 500px; border-radius: 8px; margin: 1rem 0; border: 1px solid var(--color-border); display: block;">
        <p><strong>Puesto #1 en Ecuador y #43 a nivel mundial</strong>. Alcancé el Peak Rank #48 en el Hall of Fame global, demostrando dominio en la resolución de máquinas de categoría Insane y entornos empresariales simulados.</p>
      </AwardCard>
      
      <AwardCard
        title='<i class="fas fa-flag" style="color: var(--color-primary);"></i> Liderazgo Internacional (LACC 2025)'
        image="/images/about/representacion.jpg"
      >
        <p><strong>Capitán del equipo de Ecuador</strong> en el Latinoamérica Cybersecurity Challenge (Colombia). Liderando estrategias híbridas (Red/Blue Team) para alcanzar el 4to lugar regional.</p>
      </AwardCard>
      
      <AwardCard
        title='<i class="fas fa-trophy" style="color: silver;"></i> Tricampeón Nacional (Ingenials)'
      >
        <p><strong>UDLA (3 Años Consecutivos)</strong>: Dominio absoluto en categorías de Ethical Hacking y Attack-Defense.</p>
      </AwardCard>

      <AwardCard
        title='<i class="fas fa-shield-alt" style="color: #4da6ff;"></i> Capitán Mejor Equipo Blue Team LATAM'
        image="/images/about/ctf-blue.png"
      >
        <p><strong>Holmes CTF Hack The Box 2025</strong>: Reconocidos como el <strong>Mejor Equipo de Blue Team de Latinoamérica</strong>, destacando en respuesta a incidentes y análisis forense.</p>
      </AwardCard>
      
      <AwardCard
        title='<i class="fas fa-globe-americas"></i> Proyección Global (WorldSkills)'
      >
        <p>Seleccionado para la preselección mundial de WorldSkills (Australia) como parte del equipo representativo de Latinoamérica y el Caribe.</p>
      </AwardCard>
    </div>

    <!-- SECCIÓN 2: MATRIZ DE COMPETENCIAS -->
    <div class="cv-section">
      <h2><i class="fas fa-th-large"></i> Matriz de Competencias Técnicas</h2>
      
      <h3 style="font-size: 1.2rem; color: var(--color-accent); margin-top: 1.5rem;">Operaciones Ofensivas (Red Team)</h3>
      <SkillContainer>
        <span><i class="fab fa-windows"></i> Active Directory Mastery</span>
        <span>GPO Exploitation</span>
        <span>Kerberoasting</span>
        <span>Delegation Attacks</span>
        <span><i class="fas fa-ghost"></i> EDR/XDR Evasion</span>
        <span>Process Injection</span>
        <span>API Unhooking</span>
        <span><i class="fas fa-network-wired"></i> APT Tactics</span>
        <span>Advanced Persistence</span>
      </SkillContainer>

      <h3 style="font-size: 1.2rem; color: var(--color-accent); margin-top: 1.5rem;">Investigación & Desarrollo (R+D)</h3>
      <SkillContainer>
        <span><i class="fas fa-microchip"></i> Hardware Hacking (Flipper Zero/SDR)</span>
        <span>Wireless Auditing</span>
        <span><i class="fas fa-code"></i> Exploit Dev (Python/Bash/PowerShell)</span>
        <span>Custom C2 Dev</span>
      </SkillContainer>

      <h3 style="font-size: 1.2rem; color: var(--color-accent); margin-top: 1.5rem;">Seguridad OT/ICS</h3>
      <SkillContainer>
        <span><i class="fas fa-industry"></i> Infrastructure Protection</span>
        <span>PLC Auditing (Siemens/Schneider)</span>
        <span>SCADA Security</span>
      </SkillContainer>
    </div>

    <!-- SECCIÓN 3: TRAYECTORIA PROFESIONAL -->
    <div class="cv-section">
      <h2><i class="fas fa-briefcase"></i> Trayectoria Profesional</h2>
      
      <TimelineItem 
        title="Pentester Independiente / Red Team Operator"
        institution="HackerOne | Freelance"
        year="2023 - Actualidad"
      >
        <p>Ejecución de simulaciones de ataques reales y detección de vulnerabilidades críticas en programas de recompensas de impacto global. <strong>Foco en la evasión de EDRs y el compromiso de infraestructuras críticas empresariales.</strong></p>
      </TimelineItem>

      <TimelineItem 
        title="Ayudante de Cátedra"
        institution="Universidad de las Américas (UDLA)"
        year="2023 - Actualidad"
      >
         <p>Mentoría técnica en la formación de la nueva generación de profesionales de ciberseguridad, facilitando laboratorios prácticos de explotación y defensa.</p>
      </TimelineItem>

      <TimelineItem 
        title="CTF Architect & Speaker"
        institution="Hackron, Cybercamp, CyberEx, Pwn Or Die"
        year="2024 - 2025"
      >
        <p>Diseñador de desafíos CTF inspirados en entornos reales. Speaker destacado sobre el uso de Flipper Zero en Operaciones de Red Team, Forense Digital y Pwn.</p>
      </TimelineItem>
    </div>

    <!-- SECCIÓN 4: PROYECTOS DE AUTORÍA -->
    <div class="cv-section">
      <h2><i class="fab fa-github"></i> Proyectos de Autoría & Herramientas</h2>
      
      <TimelineItem 
        title='Flipper CyberAttack Suite (flipper-atack) <i class="fas fa-star" style="color: gold;"></i>'
        institution='Framework avanzado'
      >
        <p>Framework avanzado de scripts de PowerShell para Flipper Zero. Incluye módulos de exfiltración de credenciales SAM/SYSTEM, keyloggers discretos y análisis de puertos automatizado.</p>
        <a href="https://github.com/mrflippermen/flipper-atack" target="_blank" style="font-size: 0.9rem;"><i class="fab fa-github"></i> Ver en GitHub &rarr;</a>
      </TimelineItem>
      
      <TimelineItem 
        title="RAM Keylogger (Proyecto Ingenials)"
        institution="Primer Lugar - Ingenials"
      >
        <p>Desarrollo de un keylogger residente exclusivamente en memoria para minimizar la huella forense, junto con un análisis de detectabilidad para equipos de Blue Team.</p>
      </TimelineItem>

      <TimelineItem 
        title="ad-enum-toolkit"
        institution="Automatización"
      >
        <p>Suite de automatización para la enumeración de vectores de ataque en entornos de Active Directory.</p>
      </TimelineItem>
    </div>

    <!-- SECCIÓN 5: FORMACIÓN Y CERTIFICACIONES -->
    <div class="cv-section">
      <h2><i class="fas fa-graduation-cap"></i> Formación, Certificaciones y Pro Labs</h2>
      
      <h3 style="margin-top: 1.5rem; margin-bottom: 1rem;"><i class="fas fa-certificate"></i> Certificaciones Oficiales</h3>
      
      <!-- CBTeamer Main Card -->
      <AwardCard
            title='Certified Blue Teamer (CBTeamer) <i class="fas fa-shield-alt" style="color: #4da6ff; font-size: 0.9rem;"></i>'
            subtitle="Ene 2026 | ID: 10916716"
            image="/images/about/cbteamer.png"
            link="/certs/cbteamer"
        >
            <p style="font-size: 0.9rem; margin-bottom: 0;">Dominio en DFIR, Threat Hunting y defensa en AD.</p>
      </AwardCard>

      <SkillContainer>
        <span>OT Security Expert (OPSWAT)</span>
        <span>Network Defense (Cisco)</span>
        <span>AWS Cloud Foundations</span>
      </SkillContainer>

      <h3 style="margin-top: 2rem; margin-bottom: 1rem;"><i class="fas fa-server"></i> Hack The Box Pro Labs (100% Completados)</h3>
      <p style="color: #888; margin-bottom: 1.5rem;">Formación de élite mediante la resolución de los laboratorios empresariales más rigurosos del mercado.</p>
      
      <div class="feature-grid" style="margin: 0; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        
        <AwardCard
            title='Cybernetics <i class="fas fa-check-circle" style="color: var(--color-primary); font-size: 0.9rem;"></i>'
            subtitle="Tácticas APT & Phishing"
            image="/images/about/Cybernetics.jpg"
            link="/certs/cybernetics"
        />

        <AwardCard
            title='APTLabs <i class="fas fa-check-circle" style="color: var(--color-primary); font-size: 0.9rem;"></i>'
            subtitle="Lateral Movement & Persistence"
            image="/images/about/aptlabs.jpg"
            link="/certs/aptlabs"
        />

        <AwardCard
            title='RastaLabs <i class="fas fa-check-circle" style="color: var(--color-primary); font-size: 0.9rem;"></i>'
            subtitle="EDR Evasion & Red Teaming"
            image="/images/about/rastalab.jpg"
            link="/certs/rastalabs"
        />

        <AwardCard
            title='Offshore <i class="fas fa-check-circle" style="color: var(--color-primary); font-size: 0.9rem;"></i>'
            subtitle="AD Trusts & Banking Security"
            image="/images/about/Offshore.jpg"
            link="/certs/offshore"
        />

        <AwardCard
            title='Zephyr <i class="fas fa-check-circle" style="color: var(--color-primary); font-size: 0.9rem;"></i>'
            subtitle="Pivoting & AD Attacks"
            image="/images/about/Zephyr.jpg"
            link="/certs/zephyr"
        />

        <AwardCard
            title='Dante <i class="fas fa-check-circle" style="color: var(--color-primary); font-size: 0.9rem;"></i>'
            subtitle="Exploit Dev & PrivEsc"
            image="/images/about/dante.jpg"
            link="/certs/dante"
        />
      </div>
    </div>

  </div>
</BaseLayout>
