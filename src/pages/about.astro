---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineItem from '../components/TimelineItem.astro';
import AwardCard from '../components/AwardCard.astro';
import SkillContainer from '../components/SkillContainer.astro';
---

<BaseLayout title="Esteban Jimenez | Red Team Operator">
  <div class="cv-container">
  
    <!-- HEADER: CLEAN & IMPACTFUL -->
    <header class="profile-header">
      <div class="profile-avatar">
         <img src="/images/about/profile-photo.jpg" alt="Esteban Jimenez" />
      </div>
      
      <div class="profile-info">
        <h1 class="glitch-text" data-text="Esteban Jimenez">Esteban Jimenez</h1>
        <div class="profile-title">
          <span class="role red-role">Red Team Operator</span>
          <span class="separator">|</span>
          <span class="role purple-role">Purple Team Strategist</span>
          <span class="separator">|</span>
          <span class="role blue-role">Blue Team Lead</span>
        </div>
        
        <div class="profile-stats">
          <div class="stat-badge top-stat">
            <i class="fas fa-trophy"></i> Top 1 Ecuador & Global Top 50 (Hack The Box)
          </div>
          <div class="stat-badge">
             <i class="fas fa-flag"></i> Capitán Equipo Nacional LACC 2025
          </div>
        </div>

        <div class="profile-meta">
          <a href="mailto:jimenez.francisco16@yahoo.es" class="meta-link"><i class="fas fa-envelope"></i> Email</a>
          <a href="https://linkedin.com/in/esteban-jimenez-994868249/" target="_blank" class="meta-link"><i class="fab fa-linkedin"></i> LinkedIn</a>
          <a href="https://github.com/mrflippermen" target="_blank" class="meta-link"><i class="fab fa-github"></i> GitHub</a>
          <span class="location"><i class="fas fa-map-marker-alt"></i> Loja / Quito, Ecuador (Global)</span>
        </div>
      </div>
    </header>

    <!-- SECCIÓN 1: HITOS (HERO CARDS) -->
    <section class="cv-section">
      <h2 class="section-title"><i class="fas fa-crown"></i> Dominio Global & Reconocimientos</h2>
      <div class="awards-grid">
        <!-- Card 1: HTB Top 1 -->
        <div class="glass-card highlight-card">
          <div class="card-icon"><i class="fas fa-trophy"></i></div>
          <div class="card-content">
            <h3>Hack The Box</h3>
            <div class="card-subtitle">#1 Ecuador | #43 Mundial</div>
            <p>Plataforma de práctica en pentesting y laboratorios empresariales.</p>
            <img src="/images/about/ranknacional.jpg" alt="Ranking HTB" class="card-img" />
          </div>
        </div>

        <!-- Card 2: Blue Team LatAm -->
        <div class="glass-card blue-card">
          <div class="card-icon"><i class="fas fa-shield-alt"></i></div>
          <div class="card-content">
            <h3>Holmes CTF 2025</h3>
            <div class="card-subtitle">Capitán - Mejor Blue Team LatAm</div>
            <p>Competencia de respuesta a incidentes y análisis forense digital.</p>
            <img src="/images/about/ctf-blue.png" alt="Blue Team Win" class="card-img" />
          </div>
        </div>

        <!-- Card 3: LACC -->
        <div class="glass-card">
          <div class="card-icon"><i class="fas fa-flag"></i></div>
          <div class="card-content">
            <h3>LACC 2025 - Colombia</h3>
            <div class="card-subtitle">Capitán Equipo Ecuador</div>
            <p>4to Lugar Regional en el Latin American Cybersecurity Challenge.</p>
          </div>
        </div>

        <!-- Card 4: CyberFlippers Captain -->
        <div class="glass-card purple-card">
          <div class="card-icon"><i class="fas fa-users"></i></div>
          <div class="card-content">
            <h3>Capitán CyberFlippers</h3>
            <div class="card-subtitle">Equipo Nacional Ecuador</div>
            <p>Equipo competitivo enfocado en CTFs internacionales y formación técnica.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: PROYECTOS (PROMOTED UP!) -->
    <section class="cv-section">
      <h2 class="section-title"><i class="fas fa-code"></i> Arsenal & Proyectos de Autoría</h2>
      <div class="projects-container">
        <TimelineItem 
          title='Flipper CyberAttack Suite <span class="tag">Flagship</span>'
          institution='PowerShell | Flipper Zero'
        >
          <p>Framework ofensivo avanzado. Módulos de <strong>exfiltración SAM/SYSTEM</strong>, keyloggers discretos y análisis de puertos automatizado.</p>
          <a href="https://github.com/mrflippermen/flipper-atack" target="_blank" class="project-link"><i class="fab fa-github"></i> Ver Código Fuente</a>
        </TimelineItem>

        <TimelineItem 
          title="Shellcode-Evasion-Suite"
          institution="Python | EDR/AV Evasion"
        >
          <p>Plataforma de ofuscación y encriptación de shellcode multi-técnica. Implementa <strong>polimorfismo</strong>, encoding XOR/RC4 y técnicas anti-sandbox para bypass avanzado de EDR/AV.</p>
          <a href="https://github.com/mrflippermen/Shellcode-Evasion-Suite" target="_blank" class="project-link"><i class="fab fa-github"></i> Ver Código Fuente</a>
        </TimelineItem>

        <TimelineItem 
          title="BloodHound-Parser"
          institution="Python | Active Directory"
        >
          <p>Parser de última generación para datasets BloodHound. Automatiza la extracción de <strong>rutas de ataque críticas</strong>, delegation chains y vulnerabilidades de Kerberos en entornos AD complejos.</p>
          <a href="https://github.com/mrflippermen/BloodHound-Parser" target="_blank" class="project-link"><i class="fab fa-github"></i> Ver Código Fuente</a>
        </TimelineItem>

        <TimelineItem 
          title="Shodan-Intel-Reporter"
          institution="Python | OSINT"
        >
          <p>Framework de inteligencia automatizada sobre infraestructura expuesta. Genera reportes visualizados con <strong>análisis de superficie de ataque</strong> y correlación de vulnerabilidades CVE.</p>
          <a href="https://github.com/mrflippermen/Shodan-Intel-Reporter" target="_blank" class="project-link"><i class="fab fa-github"></i> Ver Código Fuente</a>
        </TimelineItem>

        <TimelineItem 
          title="SpiderFoot-URL-Parser"
          institution="Python | Reconnaissance"
        >
          <p>Extractor y procesador de salidas SpiderFoot. Integra pipelines de <strong>enumeración pasiva</strong> con filtrado por criticidad para bug bounty y reconocimiento sigiloso.</p>
          <a href="https://github.com/mrflippermen/SpiderFoot-URL-Parser" target="_blank" class="project-link"><i class="fab fa-github"></i> Ver Código Fuente</a>
        </TimelineItem>

        <TimelineItem 
          title="BugBounty-Automation-Setup"
          institution="Shell | DevOps Security"
        >
          <p>Script de aprovisionamiento ZSH para entornos de reconocimiento. Transforma instancias Linux vanilla en <strong>plataformas de combate</strong> con herramientas pre-configuradas (Nuclei, FFUF, Amass) en minutos.</p>
          <a href="https://github.com/mrflippermen/BugBounty-Automation-Setup" target="_blank" class="project-link"><i class="fab fa-github"></i> Ver Código Fuente</a>
        </TimelineItem>
        
        <TimelineItem 
          title="RAM Keylogger (Forensic Resistant)"
          institution="C++ | Windows Internals"
        >
          <p>Keylogger residente exclusivamente en memoria (RAM) para minimizar huella forense. Incluye análisis de evasión de EDRs.</p>
        </TimelineItem>

        <TimelineItem 
          title="ad-enum-toolkit"
          institution="Python | Bash"
        >
          <p>Suite de automatización para enumeración masiva de vectores de ataque en entornos Active Directory.</p>
        </TimelineItem>
      </div>
    </section>

    <!-- EXECUTIVE PROFILE -->
    <section class="cv-section executive-section">
      <h2 class="section-title"><i class="fas fa-user-tie"></i> Perfil Profesional</h2>
      
      <div class="executive-content">
        <div class="profile-summary">
          <p class="lead-text">
            Especialista en ciberseguridad ofensiva y defensiva. Experiencia en competencias 
            internacionales y laboratorios de pentesting avanzado.
          </p>
        </div>

        <div class="expertise-areas">
          <div class="expertise-card offensive">
            <div class="expertise-icon"><i class="fas fa-crosshairs"></i></div>
            <h3>Red Team</h3>
            <div class="key-areas">
              <span>AD Exploitation</span>
              <span>EDR Bypass</span>
              <span>Web Pentesting</span>
              <span>Custom Tooling</span>
            </div>
          </div>

          <div class="expertise-card defensive">
            <div class="expertise-icon"><i class="fas fa-shield-halved"></i></div>
            <h3>Blue Team</h3>
            <div class="key-areas">
              <span>DFIR</span>
              <span>Threat Hunting</span>
              <span>Forensics</span>
              <span>SIEM Analysis</span>
            </div>
          </div>

          <div class="expertise-card leadership">
            <div class="expertise-icon"><i class="fas fa-users-gear"></i></div>
            <h3>Liderazgo</h3>
            <div class="key-areas">
              <span>Team Captain</span>
              <span>CTF Design</span>
              <span>Training</span>
              <span>Mentoring</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPETENCIAS TÉCNICAS -->
    <section class="cv-section">
      <h2 class="section-title"><i class="fas fa-th-large"></i> Matriz de Competencias</h2>
      
      <div class="skills-grid">
        <div class="skill-group red-team">
          <h3><i class="fas fa-dragon"></i> Operaciones Ofensivas</h3>
          <SkillContainer>
            <span>Active Directory Mastery</span>
            <span>Kerberoasting & Delegation</span>
            <span>GPO Exploitation</span>
            <span>EDR/XDR Evasion</span>
            <span>Process Injection</span>
            <span>APT Tactics</span>
          </SkillContainer>
        </div>

        <div class="skill-group rnd">
          <h3><i class="fas fa-microchip"></i> I+D & Hardware</h3>
          <SkillContainer>
            <span>Flipper Zero Ops</span>
            <span>SDR & Wireless</span>
            <span>Exploit Dev (Py/Ps1)</span>
            <span>Custom C2</span>
          </SkillContainer>
        </div>

        <div class="skill-group ics">
          <h3><i class="fas fa-industry"></i> OT/ICS Security</h3>
          <SkillContainer>
            <span>PLC Auditing</span>
            <span>SCADA Protection</span>
            <span>Siemens/Schneider</span>
          </SkillContainer>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 5: TRAYECTORIA -->
    <section class="cv-section">
      <h2 class="section-title"><i class="fas fa-briefcase"></i> Trayectoria Profesional</h2>
      <TimelineItem 
        title="Pentester & Red Team Operator"
        institution="HackerOne | Freelance"
        year="2023 - Actualidad"
      >
        <p>Simulaciones de ataque real y evasión de defensas corporativas. Foco en infraestructura crítica.</p>
      </TimelineItem>

      <TimelineItem 
        title="CTF Architect & Speaker"
        institution="Hackron, Cybercamp, Pwn Or Die"
        year="2024 - 2025"
      >
        <p>Diseño de escenarios Full-Spectrum. Speaker sobre **Flipper Zero Ops**, **Forense Digital** y **Pwn/Exploitation**.</p>
      </TimelineItem>

      <TimelineItem 
        title="Ayudante de Cátedra"
        institution="UDLA Ecuador"
        year="2023 - Actualidad"
      >
         <p>Mentoría técnica en laboratorios de explotación y defensa.</p>
      </TimelineItem>
    </section>

    <!-- SECCIÓN 6: CERTIFICACIONES -->
    <section class="cv-section">
      <h2 class="section-title"><i class="fas fa-graduation-cap"></i> Formación Elite</h2>
      
      <!-- CBTeamer Showcase -->
      <div class="cert-showcase">
         <AwardCard
            title='Certified Blue Teamer (CBTeamer)'
            subtitle="ID: 10916716 | Ene 2026"
            image="/images/about/cbteamer.png"
            link="/certs/cbteamer"
        >
            <p>Dominio en DFIR, Threat Hunting y defensa en AD.</p>
        </AwardCard>
      </div>


      <!-- Cyberwarfare Labs Section with Logo -->
      <div class="cwl-section">
        <div class="cwl-logo-container">
          <img src="/images/about/cwl-logo.png" alt="Cyberwarfare Labs Logo" class="cwl-logo" />
        </div>
        <h2 class="section-title"><i class="fas fa-biohazard"></i> Cyberwarfare Labs</h2>
      </div>
      <div class="feature-grid">
         <AwardCard
            title='Certified AD Red Team Specialist'
            subtitle="ID: 697ea4d4fbb... | Feb 2026"
            image="/images/about/cwl-ad-rts.png"
            link="/certs/ad-rts"
        />
         <AwardCard
            title='Certified Web Red Team Analyst'
            subtitle="ID: 6983d6b090d... | Feb 2026"
            image="/images/about/cwl-web-rta.png"
            link="/certs/web-rta"
        />
      </div>

      <!-- HTB Pro Labs Matrix -->
      <h3 class="subsection-title">Hack The Box Pro Labs (100% Completados)</h3>
      <div class="feature-grid">
        <AwardCard title='Cybernetics' subtitle="APT & Phishing" image="/images/about/Cybernetics.jpg" link="/certs/cybernetics" />
        <AwardCard title='APTLabs' subtitle="Lateral Movement" image="/images/about/aptlabs.jpg" link="/certs/aptlabs" />
        <AwardCard title='RastaLabs' subtitle="EDR Evasion" image="/images/about/rastalab.jpg" link="/certs/rastalabs" />
        <AwardCard title='Offshore' subtitle="AD Trusts" image="/images/about/Offshore.jpg" link="/certs/offshore" />
        <AwardCard title='Zephyr' subtitle="Pivoting" image="/images/about/Zephyr.jpg" link="/certs/zephyr" />
        <AwardCard title='Dante' subtitle="Exploit Dev" image="/images/about/dante.jpg" link="/certs/dante" />
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Estilos específicos de CV/About - usa variables globales de _tokens.scss */

  .cv-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: 'Inter', sans-serif;
    color: #e0e0e0;
  }

  /* --- HEADER --- */
  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
  }

  .profile-avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    padding: 3px;
    background: linear-gradient(135deg, var(--neon-red), var(--neon-blue));
    box-shadow: -10px 0 30px rgba(255, 51, 51, 0.3), 10px 0 30px rgba(77, 166, 255, 0.3);
    margin-bottom: 1.5rem;
  }
  
  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--card-bg); /* Inner border to separate image from gradient */
  }

  .profile-header h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
    color: #fff;
    font-weight: 800;
  }

  .profile-title {
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 1rem;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .red-role { color: var(--neon-red); text-shadow: 0 0 10px rgba(255, 51, 51, 0.4); }
  .blue-role { color: var(--neon-blue); text-shadow: 0 0 10px rgba(77, 166, 255, 0.4); }
  .purple-role { background: linear-gradient(90deg, var(--neon-red), var(--neon-blue)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 700; }
  
  .profile-title .separator {
    color: #444;
    margin: 0 0.5rem;
  }

  .profile-stats {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .stat-badge {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    border: var(--glass-border);
  }

  .top-stat {
    border-color: var(--neon-red); /* Changed to Red to signify Attack/Top Rank */
    color: #fff;
    background: rgba(255, 51, 51, 0.1);
    box-shadow: 0 0 15px rgba(255, 51, 51, 0.2);
  }

  .profile-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: #888;
    flex-wrap: wrap;
    justify-content: center;
  }

  .meta-link {
    color: #aaa;
    text-decoration: none;
    transition: color 0.3s;
  }
  
  .meta-link:hover {
    color: #fff;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
  }

  /* --- SECTIONS --- */
  .cv-section {
    margin-bottom: 5rem;
  }

  .section-title {
    font-size: 1.8rem;
    border-left: 4px solid;
    border-image: linear-gradient(to bottom, var(--neon-red), var(--neon-blue)) 1 100%;
    padding-left: 1rem;
    margin-bottom: 2rem;
    color: #fff;
  }

  /* --- AWARDS GRID --- */
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .glass-card {
    background: var(--card-bg);
    border: var(--glass-border);
    border-radius: 12px;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .glass-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border-color: #333;
  }

  .card-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #666;
  }

  .highlight-card {
    border: 1px solid gold;
    background: linear-gradient(145deg, rgba(255, 215, 0, 0.05), rgba(0,0,0,0));
  }
  
  .highlight-card .card-icon { color: gold; }

  .blue-card {
    border: 1px solid var(--neon-blue);
    background: linear-gradient(145deg, rgba(77, 166, 255, 0.05), rgba(0,0,0,0));
  }
  
  .blue-card .card-icon { color: var(--neon-blue); }

  .purple-card {
    border: 1px solid #bd00ff;
    background: linear-gradient(145deg, rgba(189, 0, 255, 0.05), rgba(0,0,0,0));
  }
  
  .purple-card .card-icon { color: #bd00ff; }

  .glass-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    color: #fff;
  }

  .card-subtitle {
    font-size: 0.9rem;
    color: var(--neon-green);
    margin-bottom: 1rem;
    text-transform: uppercase;
    font-weight: 700;
  }

  .card-img {
    width: 100%;
    margin-top: 1rem;
    border-radius: 6px;
    opacity: 0.8;
    transition: opacity 0.3s;
  }
  
  .glass-card:hover .card-img { opacity: 1; }

  /* --- BIO --- */
  .bio-content {
    background: rgba(255, 255, 255, 0.03);
    padding: 2rem;
    border-radius: 8px;
    border-left: 2px solid var(--neon-blue); /* Changed to Blue for professional profile/strategy */
  }
  
  .bio-quote {
    margin-top: 1.5rem;
    font-style: italic;
    color: #888;
    border-left: 3px solid #333;
    padding-left: 1rem;
  }

  /* --- PROJECTS --- */
  .project-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--neon-green);
    text-decoration: none;
    font-size: 0.9rem;
    border: 1px solid var(--neon-green);
    padding: 0.2rem 0.8rem;
    border-radius: 4px;
    transition: all 0.3s;
  }
  
  .project-link:hover {
    background: var(--neon-green);
    color: #000;
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.4);
  }
  
  .tag {
    background: var(--neon-green);
    color: #000;
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 4px;
    vertical-align: middle;
    margin-left: 0.5rem;
  }

  /* --- SKILLS --- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .skill-group h3 {
    font-size: 1.1rem;
    color: #aaa;
    margin-bottom: 1rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
  }
  
  .red-team h3 { color: #ff4d4d; border-color: #ff4d4d; }
  .rnd h3 { color: var(--neon-green); border-color: var(--neon-green); }
  .ics h3 { color: #FFA500; border-color: #FFA500; }

  /* --- CERTS --- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  
  .cert-showcase {
    margin-bottom: 2rem;
    border: 1px solid var(--neon-blue);
    border-radius: 8px;
    background: rgba(77, 166, 255, 0.05);
  }
  
  .subsection-title {
    font-size: 1.2rem;
    color: #888;
    margin: 2rem 0 1rem 0;
  }

  /* --- EXECUTIVE PROFILE SECTION --- */
  .executive-section {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.2));
    padding: 3rem 1.5rem;
    border-radius: 12px;
  }

  .executive-content {
    max-width: 1200px;
    margin: 0 auto;
  }

  .profile-summary {
    margin-bottom: 3rem;
  }

  .lead-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #ddd;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .expertise-areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
  }

  .expertise-card {
    background: rgba(0, 0, 0, 0.4);
    border: 2px solid;
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s;
  }

  .expertise-card.offensive {
    border-color: var(--neon-red);
    background: linear-gradient(135deg, rgba(255, 51, 51, 0.08), rgba(0, 0, 0, 0.4));
  }

  .expertise-card.defensive {
    border-color: var(--neon-blue);
    background: linear-gradient(135deg, rgba(77, 166, 255, 0.08), rgba(0, 0, 0, 0.4));
  }

  .expertise-card.leadership {
    border-color: var(--neon-purple);
    background: linear-gradient(135deg, rgba(189, 0, 255, 0.08), rgba(0, 0, 0, 0.4));
  }

  .expertise-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .expertise-card.offensive:hover {
    box-shadow: 0 10px 30px rgba(255, 51, 51, 0.3);
  }

  .expertise-card.defensive:hover {
    box-shadow: 0 10px 30px rgba(77, 166, 255, 0.3);
  }

