---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineItem from '../components/TimelineItem.astro';

// Modular About Components
import ProfileHeader from '../components/about/ProfileHeader.astro';
import AchievementsGrid from '../components/about/AchievementsGrid.astro';
import ProjectsSection from '../components/about/ProjectsSection.astro';
import SkillsMatrix from '../components/about/SkillsMatrix.astro';
import CertificationsShowcase from '../components/about/CertificationsShowcase.astro';
---

<BaseLayout title="Esteban Jimenez | Red Team Operator">
  <div class="cv-container">
  
    <ProfileHeader />

    <AchievementsGrid />

    <ProjectsSection />

    <!-- SKILLS MATRIX -->
    <SkillsMatrix />

    <!-- TRAYECTORIA -->
    <section class="cv-section">
      <h2 class="section-title"><i class="fas fa-briefcase"></i> Trayectoria Profesional</h2>
      <TimelineItem 
        title="Pentester & Red Team Operator"
        institution="HackerOne | Freelance"
        year="2023 - Actualidad"
      >
        <p>Simulaciones de ataque real y evasión de defensas corporativas. Foco en infraestructura crítica.</p>
      </TimelineItem>

      <TimelineItem 
        title="CTF Architect & Speaker"
        institution="Hackron, Cybercamp, Pwn Or Die"
        year="2024 - 2025"
      >
        <p>Diseño de escenarios Full-Spectrum. Speaker sobre **Flipper Zero Ops**, **Forense Digital** y **Pwn/Exploitation**.</p>
      </TimelineItem>

      <TimelineItem 
        title="Ayudante de Cátedra"
        institution="UDLA Ecuador"
        year="2023 - Actualidad"
      >
         <p>Mentoría técnica en laboratorios de explotación y defensa.</p>
      </TimelineItem>
    </section>

    <CertificationsShowcase />

  </div>
</BaseLayout>

<style>
  /* Estilos específicos de CV/About - usa variables globales de _tokens.scss */

  .cv-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: 'Inter', sans-serif;
    color: #e0e0e0;
  }

  /* --- SECTIONS --- */
  .cv-section {
    margin-bottom: 5rem;
  }

  .section-title {
    font-size: 1.5rem;
    border-left: 3px solid;
    border-image: linear-gradient(to bottom, var(--neon-red), var(--neon-blue)) 1 100%;
    padding-left: 1rem;
    margin-bottom: 2rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
  }

  /* --- AWARDS GRID --- */
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .glass-card {
    background: rgba(10, 10, 10, 0.6);
    border: 1px solid #333;
    border-radius: 2px; /* Sharper corners */
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    backdrop-filter: blur(5px);
  }

  .glass-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(0,0,0,0.5);
    border-color: #555;
    background: rgba(20, 20, 20, 0.8);
  }

  .card-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #444;
    transition: color 0.3s;
  }
  
  .glass-card:hover .card-icon {
    color: #fff;
  }

  .highlight-card {
    border-left: 3px solid gold;
  }
  
  .highlight-card .card-icon { color: gold; }

  .blue-card {
    border-left: 3px solid var(--neon-blue);
  }
  
  .blue-card .card-icon { color: var(--neon-blue); }

  .purple-card {
    border-left: 3px solid #bd00ff;
  }
  
  .purple-card .card-icon { color: #bd00ff; }

  .glass-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
    color: #eee;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
  }

  .card-subtitle {
    font-size: 0.8rem;
    color: var(--color-text-secondary); /* More subtle than neon green */
    margin-bottom: 1rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 1px;
    font-family: monospace;
  }

  .card-img {
    width: 100%;
    margin-top: 1rem;
    border-radius: 2px;
    opacity: 0.7;
    filter: grayscale(0.5);
    transition: all 0.3s;
    border: 1px solid #333;
  }
  
  .glass-card:hover .card-img { opacity: 1; filter: grayscale(0); }

  /* --- PROJECTS --- */
  .project-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.8rem;
    border: 1px solid #444;
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    transition: all 0.3s;
    font-family: monospace;
  }
  
  .project-link:hover {
    background: #fff;
    color: #000;
  }
  
  .tag {
    background: #222;
    color: #aaa;
    font-size: 0.7rem;
    padding: 2px 6px;
    border: 1px solid #333;
    border-radius: 2px;
    vertical-align: middle;
    margin-left: 0.5rem;
    font-family: monospace;
  }

  /* --- SKILLS --- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .skill-group h3 {
    font-size: 1rem;
    color: #888;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: 'Inter', sans-serif;
  }
  
  .red-team h3 { border-bottom-color: var(--neon-red); color: #fff; }
  .rnd h3 { border-bottom-color: var(--neon-blue); color: #fff; }
  .ics h3 { border-bottom-color: gold; color: #fff; }

  /* --- CERTS --- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  
  .cert-showcase {
    margin-bottom: 2rem;
    border: 1px solid #333;
    border-radius: 2px;
    background: rgba(10, 10, 10, 0.4);
  }
  
  .subsection-title {
    font-size: 1rem;
    color: #666;
    margin: 2rem 0 1rem 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: monospace;
  }

  .cwl-section {
    margin: 3rem 0 2rem 0;
    text-align: center;
  }

  .cwl-logo-container {
    margin-bottom: 1.5rem;
  }

  .cwl-logo {
    max-width: 180px;
    height: auto;
    filter: grayscale(1);
    opacity: 0.6;
    transition: all 0.4s;
  }
  
  .cwl-logo:hover { filter: grayscale(0); opacity: 1; }
</style>
